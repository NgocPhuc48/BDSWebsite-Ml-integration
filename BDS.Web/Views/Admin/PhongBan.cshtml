@{
    Layout = "_AdminLayout";
    var phongBan = (List<PhongBanDTO>)ViewBag.PhongBan;
    var nhanVien = (List<NguoiDungDTO>)ViewBag.NhanVien;
}
<div class="admin-card" style="margin-bottom:16px">
    <h2 style="margin-top:0;font-size:16px">Thêm phòng ban</h2>
    <form method="post" asp-action="TaoPhongBan">
        @Html.AntiForgeryToken()
        <input name="tenPhongBan" placeholder="Tên phòng ban" required />
        <input name="khauHieu" placeholder="Khẩu hiệu" required />
        <select name="truongPhongId" required>
            <option value="">Trưởng phòng</option>
            @foreach (var nv in nhanVien)
            {
                <option value="@nv.Id">@nv.HoTenNguoiDung (@nv.TenTaiKhoan)</option>
            }
        </select>
        <button type="submit">Thêm</button>
    </form>
</div>
<div class="admin-card">
    <h2 style="margin-top:0;font-size:16px">Danh sách phòng ban</h2>
    <table>
        <tr><th>Tên</th><th>Trưởng phòng</th><th>Thành viên</th><th>Sửa / xóa</th></tr>
        @foreach (var pb in phongBan)
        {
            <tr>
                <td>@pb.TenPhongBan</td>
                <td>@pb.TruongPhong?.HoTenNguoiDung</td>
                <td>@pb.SoLuongNhanVien</td>
                <td>
                    <form method="post" asp-action="SuaPhongBan">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@pb.Id" />
                        <input name="tenPhongBan" value="@pb.TenPhongBan" required />
                        <input name="khauHieu" value="@pb.KhauHieu" required />
                        <input name="truongPhongId" type="number" value="@pb.TruongPhongId" required />
                        <select name="trangThai">
                            <option value="1">Đang hoạt động</option>
                            <option value="2">Khóa</option>
                        </select>
                        <button type="submit">Lưu</button>
                    </form>
                    <form method="post" asp-action="XoaPhongBan">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@pb.Id" />
                        <button class="xoa" type="submit">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </table>
</div>
