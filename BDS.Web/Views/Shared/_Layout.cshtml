<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nhà tốt Trần Mạnh Quân</title>
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" />
</head>
<body>
    @{
        var avatar = User.FindFirst("HinhDaiDien")?.Value;
        if (string.IsNullOrWhiteSpace(avatar))
        {
            avatar = "https://cdn-icons-png.flaticon.com/512/149/149071.png";
        }
    }
    <header class="site-header">
        <div class="left">
            <a asp-controller="Home" asp-action="Index">
                <img class="logo" src="https://static.chotot.com/storage/APP_WRAPPER/logo/pty-logo-appwrapper.png" alt="Nhà Tốt" />
            </a>
            <a class="nav-link" asp-controller="Home" asp-action="Index">Nhà Đất Bán</a>
            <span class="nav-link">Nhà đất cho thuê</span>
            <span class="nav-link">Dự án</span>
            <span class="nav-link">Tin tức</span>
            <span class="nav-link">Wiki BĐS</span>
        </div>
        <div class="right">
            <span class="heart">♡</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-menu">
                    <div class="who">
                        <img class="avatar" src="@avatar" alt="" />
                        <span class="name">@User.Identity.Name ▾</span>
                    </div>
                    <div class="drop">
                        <a asp-controller="Profile" asp-action="Index">Thông tin cá nhân</a>
                        @if (User.IsInRole("ADMIN"))
                        {
                            <a asp-controller="Admin" asp-action="NguoiDung">Quản trị</a>
                        }
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="login-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="post-btn" asp-controller="Tin" asp-action="Dang">✎ Đăng tin</a>
            }
            else
            {
                <a class="post-btn" asp-controller="Account" asp-action="Login">✎ Đăng tin</a>
            }
        </div>
    </header>
    @if (TempData["ThongBao"] != null)
    {
        <div class="thong-bao">@TempData["ThongBao"]</div>
    }
    @RenderBody()
    <div class="echbay-sms-messenger">
        <div class="phonering-alo-alo"><a href="tel:0328216771">.</a></div>
        <div class="phonering-alo-sms"><a href="sms:0328216771">.</a></div>
        <div class="phonering-alo-zalo"><a href="https://zalo.me/0328216771" target="_blank">.</a></div>
        <div class="phonering-alo-messenger"><a href="https://www.facebook.com/quan.tran.119926" target="_blank">.</a></div>
    </div>
</body>
</html>
