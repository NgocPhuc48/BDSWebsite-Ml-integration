<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quản trị - Nhà Tốt</title>
    <link rel="stylesheet" href="~/css/admin-header.css" />
    <link rel="stylesheet" href="~/css/admin-body.css" />
    <link rel="stylesheet" href="~/css/menu.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="margin:0;background:#F3F5F9">
    @{
        var avatar = User.FindFirst("HinhDaiDien")?.Value;
        if (string.IsNullOrWhiteSpace(avatar)) avatar = "https://cdn-icons-png.flaticon.com/512/149/149071.png";
        var path = Context.Request.Path.Value ?? "";
    }
    <div class="header-admin-container">
        <a class="shop-logo" asp-controller="Home" asp-action="Index">
            <img src="https://static.chotot.com/storage/APP_WRAPPER/logo/pty-logo-appwrapper.png" alt="logo" />
        </a>
        <div class="user">
            <div class="user-detail">
                <img src="@avatar" alt="" />
                <div class="detail">
                    <span class="name">@User.Identity?.Name</span>
                    <span class="role">Quản trị</span>
                </div>
            </div>
            <form method="post" asp-controller="Account" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" style="border:0;background:none;cursor:pointer;font-size:14px">Đăng xuất</button>
            </form>
        </div>
    </div>
    <div class="menu-container admin-menu">
        <a class="@(path.Contains("nguoidung", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="NguoiDung">Quản lý người dùng</a>
        <a class="@(path.Contains("phongban", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-action="PhongBan">Quản lý phòng ban</a>
    </div>
    <div class="body-container">
        <div class="content">
            @if (TempData["ThongBao"] != null)
            {
                <div class="thong-bao" style="width:auto">@TempData["ThongBao"]</div>
            }
            @RenderBody()
        </div>
    </div>
</body>
</html>
