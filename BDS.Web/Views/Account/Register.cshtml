@page "/Account/Register"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng ký</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="margin:0">
    <div class="login-container">
        <div class="login-banner">
            <div class="login-pannel"><img src="~/img/login3.png" alt="" /></div>
        </div>
        <div class="login-option">
            <form class="login-option-site" method="get" action="/Account/Register" onsubmit="return false">
                <img src="https://static.chotot.com/storage/APP_WRAPPER/logo/pty-logo-appwrapper.png" alt="" />
                <h3>Đăng ký</h3>
                <label>Họ tên</label>
                <input name="hoTenNguoiDung" required />
                <label>Email / tài khoản</label>
                <input name="tenTaiKhoan" required />
                <label>Mật khẩu</label>
                <input name="matKhau" type="password" required />
                <label>Xác nhận mật khẩu</label>
                <input name="xacNhanMatKhau" type="password" required />
                <button class="nut" type="submit">Đăng ký</button>
                <a href="/Account/Login">Đã có tài khoản? Đăng nhập</a>
            </form>
        </div>
    </div>
</body>
</html>
