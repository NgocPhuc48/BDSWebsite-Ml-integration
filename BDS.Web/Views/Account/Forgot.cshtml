@page "/Account/Forgot"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quên mật khẩu</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="margin:0">
    <div class="login-container">
        <div class="login-banner"><div class="login-pannel"><img src="~/img/login3.png" alt="" /></div></div>
        <div class="login-option">
            <form class="login-option-site" method="get" action="/Account/Forgot" onsubmit="return false">
                <img src="https://static.chotot.com/storage/APP_WRAPPER/logo/pty-logo-appwrapper.png" alt="" />
                <h3>Quên mật khẩu</h3>
                <label>Email tài khoản</label>
                <input name="email" required />
                <button class="nut" type="submit">Gửi yêu cầu</button>
                <a href="/Account/Reset">Tôi đã có mã</a>
                <a href="/Account/Login">Quay lại đăng nhập</a>
            </form>
        </div>
    </div>
</body>
</html>
