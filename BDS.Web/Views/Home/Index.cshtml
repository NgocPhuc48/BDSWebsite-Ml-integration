@model List<TinBanDTO>
@{
    var tim = (TimKiem)ViewBag.Tim;
    var khuVuc = (KhuVucFilterModel)ViewBag.KhuVuc;
    var tinCongTy = (List<TinBanDTO>)ViewBag.TinCongTy;
}
@functions {
    string ChonLoai(int? dangChon, int value) => dangChon == value ? "selected" : null;
}
<div class="body" style="position:relative">
    <img src="~/img/3.jpg" alt="" style="width:auto;position:absolute;z-index:0;height:512px;left:50%;transform:translate(-50%)" />
    <form method="get" style="position:absolute;margin-top:24px;width:945px;left:50%;transform:translate(-50%);z-index:1">
        <div style="background:rgba(0,0,0,.5);height:128px;border-radius:5px;padding:16px">
            <div style="border-radius:8px;background:rgba(255,255,255,.7);height:48px;display:flex">
                <select class="loai-select" name="loai">
                    <option value="">Loại nhà đất</option>
                    <option value="1" selected="@ChonLoai(tim.loai, 1)">Nhà phố</option>
                    <option value="2" selected="@ChonLoai(tim.loai, 2)">Đất thổ cư</option>
                    <option value="3" selected="@ChonLoai(tim.loai, 3)">Đất nền</option>
                    <option value="4" selected="@ChonLoai(tim.loai, 4)">Chung cư</option>
                </select>
                <input class="search-input" name="keyword" value="@tim.keyword" placeholder="Tìm nhanh" />
                <div style="width:146px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.7)">
                    <button type="submit" style="background:#E03C31;color:#fff;border:0;height:32px;padding:0 14px;border-radius:6px;cursor:pointer">Tìm kiếm</button>
                </div>
            </div>
            <div style="margin-top:14px;display:flex">
                <select class="pill" name="tinhCode">
                    <option value="">Trên toàn quốc</option>
                    @foreach (var tinh in khuVuc.Provinces)
                    {
                        if (tim.tinhCode == tinh.code)
                        {
                            <option value="@tinh.code" selected>@tinh.name</option>
                        }
                        else
                        {
                            <option value="@tinh.code">@tinh.name</option>
                        }
                    }
                </select>
                <div class="pill-box">
                    <input name="min" value="@tim.min" type="number" placeholder="Giá từ" />
                    <input name="max" value="@tim.max" type="number" placeholder="Giá đến" />
                </div>
                <input class="pill" name="dienTich" value="@tim.dienTich" type="number" placeholder="Diện tích" />
                <a href="/" style="height:32px;display:flex;align-items:center;color:#fff;font-size:20px;margin-left:12px;text-decoration:none">↻</a>
            </div>
        </div>
    </form>
    <div style="height:520px"></div>

    <div class="sanpham">
        <div style="width:1164px;margin:0 auto;padding:12px">
            <h5 style="margin-bottom:12px">Bất động sản dành cho bạn</h5>
            <div style="width:1140px;display:inline-block">
                @{ var i = 0; }
                @foreach (var tin in Model)
                {
                    ViewData["Cuoi"] = (i + 1) % 4 == 0;
                    <partial name="_TheTin" model="tin" />
                    i++;
                }
            </div>
        </div>
    </div>

    <div class="tinkhachdang">
        <div style="width:1164px;margin:0 auto;padding:12px">
            <h5 style="margin-bottom:12px">Tin bán nổi bật</h5>
            <div style="width:1140px;display:inline-block">
                @{ var j = 0; }
                @foreach (var tin in tinCongTy)
                {
                    ViewData["Cuoi"] = (j + 1) % 4 == 0;
                    <partial name="_TheTin" model="tin" />
                    j++;
                }
            </div>
        </div>
    </div>

    <div class="tintuc">
        <div style="width:1164px;margin:0 auto;padding:12px">
            <h5 style="margin-bottom:12px">Tin tức</h5>
            <div style="display:flex">
                <div class="item-tintuc active">Tin nổi bật</div>
                <div class="item-tintuc">Tin tức</div>
                <div class="item-tintuc">BDS Hà Tĩnh</div>
                <div class="item-tintuc">BDS Nghệ An</div>
            </div>
            <div style="display:flex;margin-top:12px">
                <div class="img-tin">
                    <img src="https://img.iproperty.com.my/angel/610x342-crop/wp-content/uploads/sites/7/2023/11/MG_9605-scaled.jpg" alt="" style="max-width:610px" />
                    <h4 style="margin-top:12px;font-size:24px;line-height:32px;font-weight:normal;letter-spacing:-0.2px">Tâm điểm BDS khu vực miền trung nhiều biến động trước dịp tết nguyên đán 2027</h4>
                    <span style="color:#999">5 ngày trước</span>
                </div>
                <div class="tintuc-container">
                    <div class="tintuc-title"><span>Cuối năm 2026 có phải thời điểm phù hợp để mua nhà?</span></div>
                    <div class="tintuc-title"><span>Hành Trình Tìm Mua Nhà “Cười Ra Nước Mắt” Của Gia Đình Giun Dế Family</span></div>
                    <div class="tintuc-title"><span>Tiêu chí mua nhà trong năm 2026</span></div>
                    <div class="tintuc-title"><span>Dự án ECO Pank Hà Nội.</span></div>
                    <div class="tintuc-title"><span>Chọn tuổi mua nhà 2026</span></div>
                </div>
            </div>
        </div>
    </div>

    <div style="width:1140px;margin:0 auto">
        <div style="background:#000;padding:8px">
            <h4 style="color:#fff;font-size:18px;font-weight:700;margin:0">
                Trở thành đối tác Nhà Tốt
                <img src="https://static.chotot.com/storage/default_images/pty/shield.svg" alt="" />
            </h4>
        </div>
        <div style="display:flex;align-items:center;height:80px">
            <div style="width:33.33%;display:flex;justify-content:center;align-items:center">
                <img style="height:60px" src="https://cdn.chotot.com/admincentre/cyv7mNjb62sbJme5uSc3WQz0OiNl7RvYiqKw1tf2ZIM/preset:raw/plain/e34f3443057f6cc5b640d117d73a4429-2808379119443443986.jpg" alt="" />
                <span style="margin-left:8px;color:#ff833f;font-weight:700">Chứng nhận đối tác</span>
            </div>
            <div style="width:33.33%;display:flex;justify-content:center;align-items:center">
                <img style="height:60px" src="https://cdn.chotot.com/admincentre/jpZqe68svUuCc0trsTLg9oUuDPqUc78tSMAkukSd7Ns/preset:raw/plain/1d6d2218e5c9703dad0fd94101a805d6-2808379189790155893.jpg" alt="" />
                <span style="margin-left:8px;color:#ff833f;font-weight:700">Đăng tin tiếp cận</span>
            </div>
            <div style="width:33.33%;display:flex;justify-content:center;align-items:center">
                <img style="height:60px" src="https://cdn.chotot.com/admincentre/nIzlhaBBTRc1kI2ORAXWq09FAbD6Wq9DQPM1sSTSjPU/preset:raw/plain/bde99245622feb8caa90ba49c2ff9d81-2808379230799729806.jpg" alt="" />
                <span style="margin-left:8px;color:#ff833f;font-weight:700">Tài khoản doanh nghiệp</span>
            </div>
        </div>
    </div>

    <div class="tintuc">
        <div style="width:1164px;margin:0 auto;padding:12px">
            <h5 style="margin-bottom:12px">Tin tức bất động sản</h5>
            <div style="width:1140px;display:inline-flex">
                <div class="tintuc-noibat">
                    <img style="border-radius:5px" src="https://img.iproperty.com.my/angel/610x342-crop/wp-content/uploads/sites/7/2023/12/2-1.jpg" alt="" />
                    <div style="display:flex;margin-top:12px"><h4 style="font-size:32px;margin:0">01</h4><h4 style="font-size:16px;margin:0 0 0 4px">Bất động sản tại vị trí hiếm: Kênh đầu tư sáng cho nhà đầu tư?</h4></div>
                </div>
                <div class="tintuc-noibat">
                    <img style="border-radius:5px" src="https://img.iproperty.com.my/angel/610x342-crop/wp-content/uploads/sites/7/2023/12/tay-bac.jpg" alt="" />
                    <div style="display:flex;margin-top:12px"><h4 style="font-size:32px;margin:0">02</h4><h4 style="font-size:16px;margin:0 0 0 4px">Bất động sản Tây Bắc dậy sóng đợt cuối năm 2026</h4></div>
                </div>
                <div class="tintuc-noibat">
                    <img style="border-radius:5px" src="https://img.iproperty.com.my/angel/610x342-crop/wp-content/uploads/sites/7/2023/12/tinh-nao-nhieu-khu-cong-nghiep-nhat-viet-nam-2-1.jpg" alt="" />
                    <div style="display:flex;margin-top:12px"><h4 style="font-size:32px;margin:0">03</h4><h4 style="font-size:16px;margin:0 0 0 4px">Các doanh nghiệp nói gì về việc thủ tướng Chính Phủ bác bỏ việc giảm thuế đất khu vực III</h4></div>
                </div>
            </div>
        </div>
    </div>

    <div class="tintuc">
        <div style="width:1164px;margin:0 auto;padding:12px">
            <h5 style="margin-bottom:12px">Hỗ trợ tiện ích</h5>
            <div style="width:1140px;display:inline-flex">
                <div class="congcu"><img src="https://staticfile.batdongsan.com.vn/images/icons/color/ic-ying-yang.svg" alt="" /><span>Xem tuổi xây nhà</span></div>
                <div class="congcu"><img src="https://staticfile.batdongsan.com.vn/images/icons/color/ic-house.svg" alt="" /><span>Chi phí làm nhà</span></div>
                <div class="congcu"><img src="https://staticfile.batdongsan.com.vn/images/home/calculator.svg" alt="" /><span>Tính lãi suất</span></div>
                <div class="congcu"><img src="https://staticfile.batdongsan.com.vn/images/icons/color/ic-feng-shui.svg" alt="" /><span>Tư vấn phong thủy</span></div>
            </div>
        </div>
    </div>

    <div class="tintuc" style="margin-bottom:40px">
        <div style="width:1164px;margin:0 auto;padding:12px">
            <div style="width:1140px;display:inline-flex">
                <div class="congcu2">
                    <img src="https://staticfile.batdongsan.com.vn/images/box-link-footer/ForSale.svg" alt="" />
                    <span style="margin-top:10px;font-size:16px;font-weight:550">Bất động sản bán</span>
                    <span style="text-align:justify">Bạn có thể tìm thấy ngôi nhà mơ ước hoặc cơ hội đầu tư hấp dẫn thông qua lượng tin <span style="color:red">rao lớn</span>, uy tín về các loại hình</span>
                </div>
                <div class="congcu2">
                    <img src="https://staticfile.batdongsan.com.vn/images/box-link-footer/ForRent.svg" alt="" />
                    <span style="margin-top:10px;font-size:16px;font-weight:550">Bất động sản cho thuê</span>
                    <span style="text-align:justify">Cập nhật thường xuyên và đầy đủ các loại hình <span style="color:red">như: thuê phòng trọ, nhà riêng</span>, kinh doanh giúp bạn nhanh chóng tìm được bất động sản ưng ý.</span>
                </div>
                <div class="congcu2">
                    <img src="https://staticfile.batdongsan.com.vn/images/box-link-footer/Projects.svg" alt="" />
                    <span style="margin-top:10px;font-size:16px;font-weight:550">Đánh giá dự án</span>
                    <span style="text-align:justify">Bạn có thể tìm thấy ngôi nhà mơ ước hoặc cơ hội đầu tư hấp dẫn thông qua lượng tin <span style="color:red">rao lớn</span>, uy tín về các loại hình</span>
                </div>
                <div class="congcu2">
                    <img src="https://staticfile.batdongsan.com.vn/images/box-link-footer/Wiki.svg" alt="" />
                    <span style="margin-top:10px;font-size:16px;font-weight:550">Wiki BDS</span>
                    <span style="text-align:justify">Bạn có thể tìm thấy ngôi nhà mơ ước hoặc cơ hội đầu tư hấp dẫn thông qua lượng tin <span style="color:red">rao lớn</span>, uy tín về các loại hình</span>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_Footer" />
