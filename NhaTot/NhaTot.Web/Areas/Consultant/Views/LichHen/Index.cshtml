@model NhaTot.Web.Models.LichHenIndexViewModel
@{
    ViewData["Title"] = "Quản lý Lịch hẹn dẫn khách xem BĐS";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-calendar-check text-primary me-2"></i>Quản lý Lịch Hẹn Dẫn Khách
        </h3>
        <p class="text-muted mb-0">Theo dõi tiến độ các cuộc hẹn dẫn khách xem nhà thực tế, điều phối thời gian và cập nhật kết quả buổi xem BĐS.</p>
    </div>
    <div>
        <a href="/Consultant/YeuCauTuVan" class="btn btn-outline-primary rounded-pill px-3 shadow-sm">
            <i class="bi bi-card-checklist me-1"></i>Xem danh sách yêu cầu tư vấn
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 4 METRIC CARDS THỐNG KÊ LỊCH HẸN -->
<div class="row g-3 mb-4">
    <!-- Card 0: Chờ xác nhận -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-info bg-white">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Chờ xác nhận</span>
                    <h3 class="fw-bold text-info mb-0">@Model.SoLuongChoXacNhan</h3>
                    <small class="text-muted">Khách vừa đặt từ tin đăng</small>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-3">
                    <i class="bi bi-bell fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 1: Sắp diễn ra / Đã xác nhận -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning bg-white">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Đã xác nhận / Sắp tới</span>
                    <h3 class="fw-bold text-warning mb-0">@Model.SoLuongSapDienRa</h3>
                    <small class="text-muted">Đã lên lịch dẫn khách</small>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-3">
                    <i class="bi bi-hourglass-split fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Đã xem nhà -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-success bg-white">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Đã hoàn thành xem nhà</span>
                    <h3 class="fw-bold text-success mb-0">@Model.SoLuongDaXem</h3>
                    <small class="text-success fw-semibold"><i class="bi bi-check2-all me-1"></i>Đã dẫn khách xem thực địa</small>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3">
                    <i class="bi bi-check-circle fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Đã hủy -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-danger bg-white">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Lịch hẹn đã hủy</span>
                    <h3 class="fw-bold text-danger mb-0">@Model.SoLuongDaHuy</h3>
                    <small class="text-muted">Khách hoặc môi giới đã hủy</small>
                </div>
                <div class="p-3 bg-danger-subtle text-danger rounded-3">
                    <i class="bi bi-calendar-x fs-2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc trạng thái Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "ALL" ? "active" : "bg-white text-dark border")" href="/Consultant/LichHen?status=ALL">
            Tất cả lịch hẹn
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.StatusFilter == "CHO_XAC_NHAN" ? "active" : "bg-white text-dark border")" href="/Consultant/LichHen?status=CHO_XAC_NHAN">
            <i class="bi bi-bell me-1 text-info"></i>Chờ xác nhận (@Model.SoLuongChoXacNhan)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.StatusFilter == "SAP_DIEN_RA" ? "active" : "bg-white text-dark border")" href="/Consultant/LichHen?status=SAP_DIEN_RA">
            <i class="bi bi-hourglass-split me-1 text-warning"></i>Sắp diễn ra (@Model.SoLuongSapDienRa)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.StatusFilter == "DA_XEM_NHA" ? "active" : "bg-white text-dark border")" href="/Consultant/LichHen?status=DA_XEM_NHA">
            <i class="bi bi-check-circle me-1 text-success"></i>Đã xem nhà (@Model.SoLuongDaXem)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.StatusFilter == "DA_HUY" ? "active" : "bg-white text-dark border")" href="/Consultant/LichHen?status=DA_HUY">
            <i class="bi bi-x-circle me-1 text-danger"></i>Đã hủy (@Model.SoLuongDaHuy)
        </a>
    </li>
</ul>

<!-- Danh sách lịch hẹn -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0">Danh sách cuộc hẹn dẫn khách</h5>
        <span class="badge bg-secondary rounded-pill px-3 py-2">@Model.DanhSachLichHen.Count cuộc hẹn</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.DanhSachLichHen.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-muted d-block mb-2"></i>
                <h6 class="fw-bold text-secondary">Không có lịch hẹn nào trong mục này</h6>
                <p class="text-muted small">Bạn có thể tạo lịch hẹn dẫn khách xem nhà mới trực tiếp trong trang chi tiết yêu cầu tư vấn.</p>
                <a href="/Consultant/YeuCauTuVan" class="btn btn-sm btn-primary rounded-pill px-3">
                    <i class="bi bi-card-checklist me-1"></i>Xem các yêu cầu tư vấn
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 90px;">Mã hẹn</th>
                            <th>Khách hàng</th>
                            <th>Thời gian gặp</th>
                            <th>Địa điểm hẹn</th>
                            <th>BĐS dẫn xem</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width: 250px;">Cập nhật trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lh in Model.DanhSachLichHen)
                        {
                            <tr>
                                <td><strong>#@lh.MaLichHen</strong></td>
                                <td>
                                    <div class="fw-bold text-dark">@lh.TenKhachHang</div>
                                    <a href="tel:@lh.SoDienThoaiKhach" class="small text-success text-decoration-none">
                                        <i class="bi bi-telephone-fill me-1"></i>@lh.SoDienThoaiKhach
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">
                                        <i class="bi bi-clock me-1"></i>@(lh.ThoiGianHen?.ToString("HH:mm - dd/MM/yyyy") ?? "--")
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-dark fw-semibold">@lh.DiaDiem</span>
                                    @if (!string.IsNullOrEmpty(lh.GhiChu))
                                    {
                                        <small class="d-block text-muted fst-italic">"@lh.GhiChu"</small>
                                    }
                                </td>
                                <td>
                                    @if (lh.MaTin.HasValue)
                                    {
                                        <a href="/TinDang/ChiTiet/@lh.MaTin" target="_blank" class="small text-decoration-none fw-semibold">
                                            #@lh.MaTin: @lh.TieuDeTinDang
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Gặp tư vấn trực tiếp</span>
                                    }
                                </td>
                                <td>
                                    @if (lh.TrangThai == "CHO_XAC_NHAN")
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-bell-fill me-1"></i>Chờ xác nhận</span>
                                    }
                                    else if (lh.TrangThai == "DA_XAC_NHAN")
                                    {
                                        <span class="badge bg-primary text-white"><i class="bi bi-calendar-check me-1"></i>Đã xác nhận</span>
                                    }
                                    else if (lh.TrangThai == "SAP_DIEN_RA" || lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Sắp diễn ra</span>
                                    }
                                    else if (lh.TrangThai == "DA_XEM_NHA" || lh.TrangThai == "COMPLETED")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã xem nhà</span>
                                    }
                                    else if (lh.TrangThai == "DA_HUY" || lh.TrangThai == "CANCELLED")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@lh.TrangThai</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (lh.TrangThai == "CHO_XAC_NHAN")
                                        {
                                            <form method="post" action="/Consultant/LichHen/CapNhatTrangThai" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                <input type="hidden" name="trangThai" value="DA_XAC_NHAN" />
                                                <button type="submit" class="btn btn-sm btn-primary shadow-sm" title="Xác nhận lịch hẹn với khách">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Xác nhận
                                                </button>
                                            </form>
                                            <form method="post" action="/Consultant/LichHen/CapNhatTrangThai" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc muốn từ chối/hủy lịch hẹn này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                <input type="hidden" name="trangThai" value="DA_HUY" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Từ chối/Hủy lịch hẹn">
                                                    <i class="bi bi-x"></i> Hủy
                                                </button>
                                            </form>
                                        }
                                        else if (lh.TrangThai == "DA_XAC_NHAN" || lh.TrangThai == "SAP_DIEN_RA" || lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                        {
                                            <form method="post" action="/Consultant/LichHen/CapNhatTrangThai" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                <input type="hidden" name="trangThai" value="DA_XEM_NHA" />
                                                <button type="submit" class="btn btn-outline-success" title="Đánh dấu đã xem nhà thành công">
                                                    <i class="bi bi-check2"></i> Đã xem
                                                </button>
                                            </form>
                                            <form method="post" action="/Consultant/LichHen/CapNhatTrangThai" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                <input type="hidden" name="trangThai" value="DA_HUY" />
                                                <button type="submit" class="btn btn-outline-danger" title="Hủy cuộc hẹn">
                                                    <i class="bi bi-x"></i> Hủy
                                                </button>
                                            </form>
                                        }
                                        @if (lh.MaYeuCau.HasValue)
                                        {
                                            <a href="/Consultant/YeuCauTuVan/ChiTiet/@lh.MaYeuCau" class="btn btn-outline-secondary ms-1" title="Vào chi tiết yêu cầu tư vấn">
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
