<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kênh Tư Vấn Viên NhaTot</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }
        .consultant-wrapper {
            display: flex;
            min-height: 100vh;
        }
        .consultant-sidebar {
            width: 260px;
            background-color: #0f172a;
            color: #94a3b8;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
        }
        .consultant-sidebar .brand {
            padding: 1.25rem 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            border-bottom: 1px solid #1e293b;
        }
        .consultant-menu {
            padding: 1rem 0;
            flex-grow: 1;
        }
        .consultant-category {
            padding: 0.75rem 1.5rem 0.25rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            font-weight: 600;
        }
        .nav-link-custom {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: #cbd5e1;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .nav-link-custom i {
            font-size: 1.15rem;
            margin-right: 0.75rem;
            width: 24px;
            text-align: center;
        }
        .nav-link-custom:hover, .nav-link-custom.active {
            color: #38bdf8;
            background-color: #1e293b;
            border-left: 4px solid #38bdf8;
        }
        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }
        .top-navbar {
            background-color: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.85rem 1.5rem;
        }
        .content-body {
            padding: 1.75rem;
            flex-grow: 1;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="consultant-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="consultant-sidebar">
            <a href="/Consultant/YeuCauTuVan" class="brand d-flex align-items-center">
                <i class="bi bi-headset text-info me-2"></i> NhaTot Consultant
            </a>

            <div class="consultant-menu">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }
                
                <div class="consultant-category">Quản lý nghiệp vụ</div>
                <a href="/Consultant/YeuCauTuVan" class="nav-link-custom @(currentController == "YeuCauTuVan" ? "active" : "")">
                    <i class="bi bi-card-checklist"></i> Yêu cầu tư vấn
                </a>
                <a href="/Consultant/YeuCauTuVan?tab=available" class="nav-link-custom">
                    <i class="bi bi-inbox-fill text-warning"></i> Nhận việc mới
                </a>
                <a href="/Consultant/LichHen" class="nav-link-custom @(currentController == "LichHen" ? "active" : "")">
                    <i class="bi bi-calendar-check"></i> Quản lý lịch hẹn
                </a>

                <div class="consultant-category mt-3">Tiện ích hỗ trợ</div>
                <a href="/DinhGia" target="_blank" class="nav-link-custom">
                    <i class="bi bi-cpu-fill text-primary"></i> Tra cứu Định giá AI
                </a>
                <a href="/BayGia" target="_blank" class="nav-link-custom">
                    <i class="bi bi-crosshair text-danger"></i> Dữ liệu Bẫy giá BĐS
                </a>
            </div>

            <!-- Footer Sidebar -->
            <div class="p-3 border-top border-secondary">
                <a href="/" class="btn btn-outline-light btn-sm w-100 d-flex align-items-center justify-content-center">
                    <i class="bi bi-box-arrow-left me-2"></i> Về trang khách
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Bar -->
            <header class="top-navbar d-flex justify-content-between align-items-center shadow-sm">
                <div>
                    <span class="fs-6 fw-bold text-dark">Kênh Quản Trị Dành Cho Chuyên Viên Tư Vấn</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 fs-6">
                        <i class="bi bi-person-badge-fill me-1"></i>Tư vấn viên: @User.Identity?.Name
                    </span>
                    <form method="post" action="/TaiKhoan/DangXuat">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <!-- Page Content Body -->
            <main class="content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
