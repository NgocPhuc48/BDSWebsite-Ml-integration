@model NhaTot.Web.Models.ChiTietYeuCauTuVanViewModel
@{
    ViewData["Title"] = $"Chi tiết Yêu cầu tư vấn #{Model.YeuCau.MaYeuCau}";
    var nc = Model.NhuCau;
    var kh = Model.KhachHang;
    var y = Model.YeuCau;
}

<!-- Breadcrumb & Back -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <a href="/Consultant/YeuCauTuVan" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i>Về danh sách yêu cầu tư vấn
    </a>
    <div class="d-flex align-items-center gap-2">
        @if (y.TrangThai == "DANG_TU_VAN" || y.TrangThai == "PROCESSING")
        {
            <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="bi bi-hourglass-split me-1"></i>Đang tư vấn</span>
        }
        else if (y.TrangThai == "DA_HOAN_THANH" || y.TrangThai == "COMPLETED")
        {
            <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check-circle-fill me-1"></i>Đã hoàn thành</span>
        }
        else if (y.TrangThai == "DA_DONG" || y.TrangThai == "CLOSED")
        {
            <span class="badge bg-secondary px-3 py-2 fs-6"><i class="bi bi-x-circle-fill me-1"></i>Đã đóng</span>
        }
        else
        {
            <span class="badge bg-light text-dark border px-3 py-2 fs-6">@y.TrangThai</span>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN KHÁCH HÀNG & NHU CẦU TÌM KIẾM -->
    <div class="col-lg-7">
        <!-- 1. Thông tin Khách hàng -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-person-circle text-primary me-2"></i>Thông tin khách hàng</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Họ và tên khách hàng:</span>
                        <strong class="fs-6 text-dark">@(kh?.HoTen ?? "Khách hàng")</strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Số điện thoại liên hệ:</span>
                        @if (!string.IsNullOrEmpty(kh?.SoDienThoai))
                        {
                            <a href="tel:@kh.SoDienThoai" class="fs-6 fw-bold text-success text-decoration-none">
                                <i class="bi bi-telephone-fill me-1"></i>@kh.SoDienThoai
                            </a>
                        }
                        else
                        {
                            <strong>Chưa cập nhật</strong>
                        }
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Địa chỉ Email:</span>
                        <strong class="text-secondary">@(kh?.Email ?? "Chưa có email")</strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Thời gian gửi yêu cầu:</span>
                        <strong class="text-secondary">@(y.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "--")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Nhu cầu tìm kiếm chi tiết -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-search text-danger me-2"></i>Chi tiết nhu cầu Bất động sản</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="text-muted d-block small">Tiêu đề yêu cầu:</span>
                    <h5 class="fw-bold text-primary mb-1">@y.TieuDe</h5>
                    @if (!string.IsNullOrEmpty(y.NoiDung))
                    {
                        <p class="text-muted mb-0 small" style="white-space: pre-line;">@y.NoiDung</p>
                    }
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Loại Bất động sản:</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                            @(nc?.MaLoaiBdsNavigation?.TenLoaiBds ?? "Bất kỳ")
                        </span>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Hình thức giao dịch:</span>
                        <span class="badge @(nc?.LoaiGiaoDich == "CHO_THUE" ? "bg-info text-dark" : "bg-danger") px-3 py-2">
                            @(nc?.LoaiGiaoDich == "CHO_THUE" ? "Cần thuê" : "Cần mua")
                        </span>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Khu vực mong muốn:</span>
                        <strong class="text-dark">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                            @(nc?.MaPhuongXaNavigation != null ? $"{nc.MaPhuongXaNavigation.TenPhuongXa}, {nc.MaPhuongXaNavigation.MaQuanHuyenNavigation?.TenQuanHuyen}" : "Toàn tỉnh")
                        </strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Khoảng ngân sách dự kiến:</span>
                        <strong class="text-danger fs-6">
                            @(nc?.NganSachMinVnd.HasValue == true ? $"{nc.NganSachMinVnd.Value:N0} đ" : "0 đ") 
                            - 
                            @(nc?.NganSachMaxVnd.HasValue == true ? $"{nc.NganSachMaxVnd.Value:N0} đ" : "Thỏa thuận")
                        </strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Diện tích mong muốn:</span>
                        <strong>
                            @(nc?.DienTichMin.HasValue == true ? $"{nc.DienTichMin.Value:N0} m²" : "Bất kỳ")
                            @if (nc?.DienTichMax.HasValue == true)
                            {
                                <span> - @nc.DienTichMax.Value.ToString("N0") m²</span>
                            }
                        </strong>
                    </div>
                    <div class="col-md-6">
                        <span class="text-muted d-block small">Mục đích tìm kiếm:</span>
                        <strong>@(string.IsNullOrEmpty(nc?.MucDich) ? "Mua/Thuê ở hoặc đầu tư" : nc.MucDich)</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. DANH SÁCH BẤT ĐỘNG SẢN GỢI Ý PHÙ HỢP (TỐI ĐA 5 TIN TỪ TINDANG) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-lightbulb-fill text-warning me-2"></i>Bất động sản gợi ý phù hợp (Tối đa 5 tin)
                </h5>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                    Khớp khu vực & ngân sách
                </span>
            </div>
            <div class="card-body p-4">
                @if (Model.DanhSachTinDangGoiY == null || !Model.DanhSachTinDangGoiY.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-house-exclamation fs-2 d-block mb-2 text-secondary"></i>
                        <span>Hiện chưa tìm thấy tin đăng nào khớp hoàn toàn với khoảng ngân sách và khu vực này.</span>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var tin in Model.DanhSachTinDangGoiY)
                        {
                            <div class="col-12">
                                <div class="border rounded-3 p-3 bg-light hover-shadow transition d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="p-2 bg-white rounded-3 border text-center" style="min-width: 65px;">
                                            <i class="bi bi-house-door-fill text-primary fs-3"></i>
                                            <span class="d-block small text-muted">#@tin.MaTin</span>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">
                                                <a href="/TinDang/ChiTiet/@tin.MaTin" target="_blank" class="text-decoration-none text-dark hover-primary">
                                                    @tin.TieuDe
                                                </a>
                                            </h6>
                                            <div class="small text-muted mb-1">
                                                <i class="bi bi-geo-alt me-1 text-danger"></i>@(string.IsNullOrEmpty(tin.DiaChi) ? "Khu vực Nghệ An" : tin.DiaChi)
                                                @if (tin.DienTichDat.HasValue)
                                                {
                                                    <span>&bull; <i class="bi bi-aspect-ratio me-1"></i>@tin.DienTichDat.Value.ToString("N1") m²</span>
                                                }
                                                @if (!string.IsNullOrEmpty(tin.Huong))
                                                {
                                                    <span>&bull; <i class="bi bi-compass me-1"></i>@tin.Huong</span>
                                                }
                                            </div>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@tin.TenLoaiBds</span>
                                        </div>
                                    </div>
                                    <div class="text-md-end">
                                        <div class="fs-6 fw-bold text-danger mb-2">
                                            @(tin.GiaRaoVnd.HasValue ? $"{tin.GiaRaoVnd.Value:N0} VNĐ" : "Giá: Liên hệ")
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/TinDang/ChiTiet/@tin.MaTin" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-eye me-1"></i>Xem tin
                                            </a>
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="chonTinVaoFormHen(@tin.MaTin, '@(tin.TieuDe?.Replace("'", "\\'") ?? "")', '@(tin.DiaChi?.Replace("'", "\\'") ?? "")')">
                                                <i class="bi bi-calendar-plus me-1"></i>Chọn hẹn
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 4. Form Cập nhật trạng thái xử lý yêu cầu -->
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-sliders text-secondary me-2"></i>Cập nhật tiến độ tư vấn</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Trạng thái hiện tại:</span>
                        <strong class="text-primary fs-6">@y.TrangThai</strong>
                    </div>
                    <div class="d-flex gap-2">
                        @if (y.TrangThai != "DANG_TU_VAN" && y.TrangThai != "PROCESSING")
                        {
                            <form method="post" action="/Consultant/YeuCauTuVan/CapNhatTrangThai">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@y.MaYeuCau" />
                                <input type="hidden" name="trangThai" value="DANG_TU_VAN" />
                                <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                                    <i class="bi bi-hourglass-split me-1"></i>Đang tư vấn (DANG_TU_VAN)
                                </button>
                            </form>
                        }
                        @if (y.TrangThai != "DA_HOAN_THANH" && y.TrangThai != "COMPLETED")
                        {
                            <form method="post" action="/Consultant/YeuCauTuVan/CapNhatTrangThai" onsubmit="return confirm('Bạn có chắc muốn đánh dấu HOÀN THÀNH yêu cầu tư vấn này? Hệ thống sẽ gửi thông báo đến khách hàng.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@y.MaYeuCau" />
                                <input type="hidden" name="trangThai" value="DA_HOAN_THANH" />
                                <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã hoàn thành (DA_HOAN_THANH)
                                </button>
                            </form>
                        }
                        @if (y.TrangThai != "DA_DONG" && y.TrangThai != "CLOSED")
                        {
                            <form method="post" action="/Consultant/YeuCauTuVan/CapNhatTrangThai" onsubmit="return confirm('Bạn có chắc muốn ĐÓNG yêu cầu này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@y.MaYeuCau" />
                                <input type="hidden" name="trangThai" value="DA_DONG" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-x-circle me-1"></i>Đã đóng (DA_DONG)
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: LỊCH HẸN DẪN KHÁCH & FORM TẠO LỊCH HẸN -->
    <div class="col-lg-5">
        <!-- Thẻ Tạo Lịch Hẹn Mới -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" id="formTaoLichHen">
            <div class="card-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-plus me-2"></i>Thiết lập Lịch hẹn dẫn khách</h5>
            </div>
            <div class="card-body p-4 bg-white">
                <form method="post" action="/Consultant/YeuCauTuVan/TaoLichHen">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MaYeuCau" value="@y.MaYeuCau" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Chọn tin BĐS dẫn xem (Gợi ý phù hợp)</label>
                        <select id="selectMaTin" name="MaTin" class="form-select">
                            <option value="">-- Gặp tư vấn trực tiếp (Chưa gắn tin cụ thể) --</option>
                            @if (Model.DanhSachTinDangGoiY != null && Model.DanhSachTinDangGoiY.Any())
                            {
                                foreach (var tin in Model.DanhSachTinDangGoiY)
                                {
                                    <option value="@tin.MaTin">
                                        #@tin.MaTin: @tin.TieuDe - @(tin.GiaRaoVnd.HasValue ? $"{tin.GiaRaoVnd.Value:N0} đ" : "Thỏa thuận")
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Thời gian hẹn <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="ThoiGianHen" class="form-control" required value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:00")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Địa điểm hẹn gặp <span class="text-danger">*</span></label>
                        <input type="text" id="inputDiaDiem" name="DiaDiem" class="form-control" required placeholder="Ví dụ: Tại BĐS số 12 đường Lê Mao, TP Vinh" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-secondary">Ghi chú cho cuộc hẹn</label>
                        <textarea name="GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Đã liên hệ chủ nhà mở cửa đón khách..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-pill shadow-sm">
                        <i class="bi bi-send-check me-1"></i>Xác nhận & Báo thông báo cho khách
                    </button>
                </form>
            </div>
        </div>

        <!-- Danh sách các lịch hẹn của yêu cầu này -->
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Lịch hẹn đã lên</h5>
                <span class="badge bg-secondary rounded-pill">@Model.DanhSachLichHen.Count</span>
            </div>
            <div class="card-body p-3">
                @if (!Model.DanhSachLichHen.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-calendar-x fs-3 d-block mb-1 text-secondary"></i>
                        Chưa có lịch hẹn nào cho yêu cầu này.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var lh in Model.DanhSachLichHen)
                        {
                            <div class="border rounded-3 p-3 bg-light shadow-sm">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="fw-bold text-primary">
                                        <i class="bi bi-clock me-1"></i>@(lh.ThoiGianHen?.ToString("HH:mm - dd/MM/yyyy") ?? "--")
                                    </span>
                                    @if (lh.TrangThai == "SAP_DIEN_RA" || lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Sắp diễn ra</span>
                                    }
                                    else if (lh.TrangThai == "DA_XEM_NHA" || lh.TrangThai == "COMPLETED")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã xem</span>
                                    }
                                    else if (lh.TrangThai == "DA_HUY" || lh.TrangThai == "CANCELLED")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                    }
                                </div>

                                <div class="small text-dark mb-1">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>@lh.DiaDiem
                                </div>

                                @if (lh.MaTin.HasValue)
                                {
                                    <div class="small text-muted mb-2">
                                        <i class="bi bi-house me-1"></i>Tin BĐS #@lh.MaTin: <strong>@(lh.MaTinNavigation?.TieuDe ?? "BĐS")</strong>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(lh.GhiChu))
                                {
                                    <div class="small text-secondary mb-2 fst-italic">
                                        "@lh.GhiChu"
                                    </div>
                                }

                                @if (lh.TrangThai == "SAP_DIEN_RA" || lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                {
                                    <div class="d-flex gap-2 mt-2 pt-2 border-top">
                                        <form method="post" action="/Consultant/YeuCauTuVan/CapNhatLichHen" class="flex-grow-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                            <input type="hidden" name="trangThai" value="DA_XEM_NHA" />
                                            <input type="hidden" name="returnYeuCauId" value="@y.MaYeuCau" />
                                            <button type="submit" class="btn btn-sm btn-outline-success w-100 rounded-pill">
                                                <i class="bi bi-check2"></i> Đã xem
                                            </button>
                                        </form>
                                        <form method="post" action="/Consultant/YeuCauTuVan/CapNhatLichHen" class="flex-grow-1" onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                            <input type="hidden" name="trangThai" value="DA_HUY" />
                                            <input type="hidden" name="returnYeuCauId" value="@y.MaYeuCau" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                                                <i class="bi bi-x"></i> Hủy
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function chonTinVaoFormHen(maTin, tieuDe, diaChi) {
            const sel = document.getElementById('selectMaTin');
            if (sel) {
                sel.value = maTin;
            }
            const loc = document.getElementById('inputDiaDiem');
            if (loc && (!loc.value || loc.value.trim() === '')) {
                loc.value = diaChi || '';
            }
            const formSection = document.getElementById('formTaoLichHen');
            if (formSection) {
                formSection.scrollIntoView({ behavior: 'smooth' });
                formSection.classList.add('border', 'border-primary', 'shadow');
                setTimeout(() => {
                    formSection.classList.remove('border', 'border-primary', 'shadow');
                }, 1500);
            }
        }
    </script>
}
