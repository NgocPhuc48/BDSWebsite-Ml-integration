@model NhaTot.Web.Models.TuVanIndexViewModel
@{
    ViewData["Title"] = "Kênh Quản trị Yêu Cầu Tư Vấn";
}

<!-- Header banner -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-headset text-primary me-2"></i>Kênh Tiếp Nhận & Quản Lý Tư Vấn BĐS
        </h3>
        <p class="text-muted mb-0">Theo dõi danh sách khách hàng cần mua/thuê, tiếp nhận xử lý yêu cầu và điều phối lịch hẹn dẫn khách xem thực địa.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
            <i class="bi bi-person-check-fill me-1"></i>Chuyên viên tư vấn
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 1. THỐNG KÊ NHANH METRIC CARDS -->
<div class="row g-3 mb-4">
    <!-- Card 1: Đang phụ trách -->
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-primary">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Yêu cầu đang phụ trách</span>
                    <h3 class="fw-bold text-primary mb-0">@Model.SoLuongCuaToi</h3>
                    <small class="text-muted">Đang theo sát hỗ trợ khách</small>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="bi bi-folder-check fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Yêu cầu mới chờ nhận -->
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-warning">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Yêu cầu mới chờ nhận</span>
                    <h3 class="fw-bold text-warning mb-0">@Model.SoLuongChuaNhan</h3>
                    <small class="text-danger fw-semibold"><i class="bi bi-lightning-fill me-1"></i>Chưa có ai tiếp nhận</small>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-3">
                    <i class="bi bi-inbox-fill fs-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Lịch hẹn sắp tới -->
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-success">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small d-block mb-1">Lịch hẹn dẫn khách</span>
                    <h3 class="fw-bold text-success mb-0">@Model.DanhSachLichHen.Count</h3>
                    <small class="text-muted">@Model.SoLuongLichHenSapToi cuộc hẹn sắp tới</small>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3">
                    <i class="bi bi-calendar-event fs-2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nav Pills Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.ActiveTab == "my_tasks" ? "active" : "bg-white text-dark border")" href="/Consultant/YeuCauTuVan?tab=my_tasks">
            <i class="bi bi-folder-check me-1"></i>Việc tôi đang phụ trách
            <span class="badge bg-white text-primary ms-1">@Model.SoLuongCuaToi</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.ActiveTab == "available" ? "active" : "bg-white text-dark border")" href="/Consultant/YeuCauTuVan?tab=available">
            <i class="bi bi-inbox-fill me-1"></i>Hàng chờ yêu cầu mới
            <span class="badge @(Model.SoLuongChuaNhan > 0 ? "bg-danger text-white" : "bg-secondary") ms-1">@Model.SoLuongChuaNhan</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill px-4 @(Model.ActiveTab == "schedule" ? "active" : "bg-white text-dark border")" href="/Consultant/YeuCauTuVan?tab=schedule">
            <i class="bi bi-calendar-event me-1"></i>Lịch trình dẫn khách
            <span class="badge bg-secondary ms-1">@Model.DanhSachLichHen.Count</span>
        </a>
    </li>
</ul>

<!-- TAB 1: VIỆC TÔI ĐANG PHỤ TRÁCH -->
@if (Model.ActiveTab == "my_tasks")
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Danh sách yêu cầu tư vấn đang phụ trách</h5>
            <small class="text-muted">Tổng cộng @Model.DanhSachYeuCauCuaToi.Count yêu cầu</small>
        </div>
        <div class="card-body p-0">
            @if (!Model.DanhSachYeuCauCuaToi.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                    <h6 class="fw-bold text-secondary">Bạn chưa tiếp nhận yêu cầu tư vấn nào</h6>
                    <p class="text-muted small">Hãy chuyển sang tab <strong>'Hàng chờ yêu cầu mới'</strong> để nhận việc ngay!</p>
                    <a href="/Consultant/YeuCauTuVan?tab=available" class="btn btn-sm btn-primary rounded-pill px-3">
                        <i class="bi bi-plus-circle me-1"></i>Xem yêu cầu mới
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Mã</th>
                                <th>Khách hàng</th>
                                <th>Nội dung nhu cầu BĐS</th>
                                <th>Khu vực & Ngân sách</th>
                                <th>Trạng thái</th>
                                <th>Ngày tiếp nhận</th>
                                <th class="text-end" style="width: 130px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DanhSachYeuCauCuaToi)
                            {
                                <tr>
                                    <td><strong>#@item.MaYeuCau</strong></td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.TenKhachHang</div>
                                        <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i>@item.SoDienThoai</small>
                                        <small class="text-muted"><i class="bi bi-envelope me-1"></i>@item.Email</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle mb-1">@item.TenLoaiBds</span>
                                        <div class="small text-truncate" style="max-width: 280px;" title="@item.TieuDe">@item.TieuDe</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-secondary"><i class="bi bi-geo-alt me-1 text-danger"></i>@item.KhuVuc</div>
                                        <div class="small text-danger fw-bold">
                                            @(item.NganSachMaxVnd.HasValue ? $"{item.NganSachMaxVnd.Value:N0} đ" : "Thỏa thuận")
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.TrangThai == "DANG_TU_VAN" || item.TrangThai == "PROCESSING")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Đang tư vấn</span>
                                        }
                                        else if (item.TrangThai == "DA_HOAN_THANH" || item.TrangThai == "COMPLETED")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã hoàn thành</span>
                                        }
                                        else if (item.TrangThai == "DA_DONG" || item.TrangThai == "CLOSED")
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Đã đóng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@item.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(item.NgayPhanCong?.ToString("dd/MM/yyyy HH:mm") ?? item.NgayTao?.ToString("dd/MM/yyyy HH:mm"))
                                    </td>
                                    <td class="text-end">
                                        <a href="/Consultant/YeuCauTuVan/ChiTiet/@item.MaYeuCau" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<!-- TAB 2: YÊU CẦU MỚI CHƯA CÓ NGƯỜI NHẬN -->
@if (Model.ActiveTab == "available")
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Hàng chờ các yêu cầu tư vấn mới từ khách hàng</h5>
            <small class="text-danger fw-bold">@Model.DanhSachYeuCauChuaNhan.Count yêu cầu đang chờ chuyên viên nhận</small>
        </div>
        <div class="card-body p-0">
            @if (!Model.DanhSachYeuCauChuaNhan.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                    <h6 class="fw-bold text-dark">Hiện tại tất cả yêu cầu tư vấn đều đã có người tiếp nhận</h6>
                    <p class="text-muted small">Hệ thống sẽ cập nhật ngay khi có khách hàng gửi yêu cầu tư vấn mới.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Mã</th>
                                <th>Khách hàng gửi</th>
                                <th>Tiêu đề & Nội dung</th>
                                <th>Loại BĐS & Khu vực</th>
                                <th>Ngân sách dự kiến</th>
                                <th>Thời gian gửi</th>
                                <th class="text-end" style="width: 160px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DanhSachYeuCauChuaNhan)
                            {
                                <tr>
                                    <td><strong>#@item.MaYeuCau</strong></td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.TenKhachHang</div>
                                        <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i>@item.SoDienThoai</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-primary">@item.TieuDe</div>
                                        <div class="small text-muted text-truncate" style="max-width: 300px;">@(string.IsNullOrEmpty(item.NoiDung) ? "Không có ghi chú thêm" : item.NoiDung)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border mb-1">@item.TenLoaiBds</span>
                                        <div class="small text-secondary"><i class="bi bi-geo-alt me-1 text-danger"></i>@item.KhuVuc</div>
                                    </td>
                                    <td>
                                        <strong class="text-danger">
                                            @(item.NganSachMaxVnd.HasValue ? $"{item.NganSachMaxVnd.Value:N0} đ" : "Thỏa thuận")
                                        </strong>
                                    </td>
                                    <td class="text-muted small">
                                        @item.NgayTao?.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="text-end">
                                        <form method="post" action="/Consultant/YeuCauTuVan/NhanTuVan/@item.MaYeuCau" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn tiếp nhận tư vấn cho khách hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                                <i class="bi bi-hand-index-thumb-fill me-1"></i>Nhận tư vấn
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<!-- TAB 3: QUẢN LÝ LỊCH HẸN DẪN KHÁCH -->
@if (Model.ActiveTab == "schedule")
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">Lịch trình hẹn dẫn khách xem BĐS thực địa</h5>
            <span class="badge bg-primary rounded-pill px-3 py-2">@Model.DanhSachLichHen.Count cuộc hẹn</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.DanhSachLichHen.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-muted d-block mb-2"></i>
                    <h6 class="fw-bold text-secondary">Chưa có lịch hẹn nào được thiết lập</h6>
                    <p class="text-muted small">Bạn có thể tạo lịch hẹn dẫn khách xem nhà trực tiếp trong trang chi tiết của từng yêu cầu tư vấn.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã hẹn</th>
                                <th>Khách hàng</th>
                                <th>Thời gian hẹn</th>
                                <th>Địa điểm gặp</th>
                                <th>BĐS dẫn xem</th>
                                <th>Trạng thái</th>
                                <th class="text-end" style="width: 220px;">Cập nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lh in Model.DanhSachLichHen)
                            {
                                <tr>
                                    <td><strong>#@lh.MaLichHen</strong></td>
                                    <td>
                                        <div class="fw-bold text-dark">@lh.TenKhachHang</div>
                                        <small class="text-muted"><i class="bi bi-telephone me-1"></i>@lh.SoDienThoaiKhach</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-primary">
                                            <i class="bi bi-clock me-1"></i>@(lh.ThoiGianHen?.ToString("HH:mm - dd/MM/yyyy") ?? "--")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="small text-dark fw-semibold">@lh.DiaDiem</span>
                                        @if (!string.IsNullOrEmpty(lh.GhiChu))
                                        {
                                            <small class="d-block text-muted">(@lh.GhiChu)</small>
                                        }
                                    </td>
                                    <td>
                                        @if (lh.MaTin.HasValue)
                                        {
                                            <a href="/TinDang/ChiTiet/@lh.MaTin" target="_blank" class="small text-decoration-none fw-semibold">
                                                Tin #@lh.MaTin: @lh.TieuDeTinDang
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa chỉ định tin cụ thể</span>
                                        }
                                    </td>
                                    <td>
                                        @if (lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Sắp diễn ra</span>
                                        }
                                        else if (lh.TrangThai == "COMPLETED")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đã xem nhà</span>
                                        }
                                        else if (lh.TrangThai == "CANCELLED")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@lh.TrangThai</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                            {
                                                <form method="post" action="/Consultant/YeuCauTuVan/CapNhatLichHen" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                    <input type="hidden" name="trangThai" value="COMPLETED" />
                                                    <button type="submit" class="btn btn-outline-success" title="Đánh dấu đã xem nhà">
                                                        <i class="bi bi-check2"></i> Đã xem
                                                    </button>
                                                </form>
                                                <form method="post" action="/Consultant/YeuCauTuVan/CapNhatLichHen" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc muốn hủy cuộc hẹn này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                    <input type="hidden" name="trangThai" value="CANCELLED" />
                                                    <button type="submit" class="btn btn-outline-danger" title="Hủy lịch hẹn">
                                                        <i class="bi bi-x"></i> Hủy
                                                    </button>
                                                </form>
                                            }
                                            @if (lh.MaYeuCau.HasValue)
                                            {
                                                <a href="/Consultant/YeuCauTuVan/ChiTiet/@lh.MaYeuCau" class="btn btn-outline-secondary ms-1" title="Vào chi tiết yêu cầu">
                                                    <i class="bi bi-arrow-right"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
