@model NhaTot.Web.Areas.Admin.Models.ApifyConnectionModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Kết nối Apify"; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <h3>Kết nối Apify</h3><a asp-action="Index" class="btn btn-outline-secondary">Về SocialBot</a>
</div>
@if (TempData["ConnectionMessage"] is string message)
{ <div class="alert alert-success" role="status">@message</div> }
@if (TempData["ConnectionError"] is string error)
{ <div class="alert alert-danger" role="alert">@error</div> }

<div class="card card-body mb-3" style="max-width:640px">
    <h5><i class="bi bi-file-earmark-lock me-2"></i>Nạp API từ file api.txt</h5>
    <p class="text-muted">Hệ thống sẽ đọc các token trong <code>ToolCaoData/api.txt</code>, kiểm tra từng token và lưu token hợp lệ đầu tiên. Không cần nhập token thủ công.</p>
    <form asp-action="NapTuApiTxt" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-dark">
            <i class="bi bi-upload me-1"></i>Nạp và kiểm tra api.txt
        </button>
    </form>
</div>

<div class="card card-body" style="max-width:640px">
    <h5>@(Model.HasToken ? "Đã có token trên server" : "Trạng thái kết nối")</h5>
    <p class="text-muted">Nhập thủ công chỉ dùng khi không thể sử dụng file api.txt.</p>
    <details>
        <summary class="text-primary" style="cursor:pointer">Nhập một API token thủ công</summary>
        <form asp-action="KetNoi" method="post" class="mt-3">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <label for="Token" class="form-label">@(Model.HasToken ? "Token mới (thay thế token đang dùng)" : "API token Apify")</label>
            <input id="Token" name="Token" type="password" value="" class="form-control" autocomplete="new-password" spellcheck="false" required maxlength="512" />
            <p class="small text-muted mt-2">Token được mã hóa trước khi lưu và không hiển thị lại.</p>
            <button type="submit" class="btn btn-primary">Kiểm tra và lưu kết nối</button>
        </form>
    </details>
</div>
<div class="mt-3 d-flex flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-primary">Thêm nguồn và cào thử</a>
    <a asp-action="LichCao" class="btn btn-outline-primary">Thiết lập lịch tự động</a>
</div>
