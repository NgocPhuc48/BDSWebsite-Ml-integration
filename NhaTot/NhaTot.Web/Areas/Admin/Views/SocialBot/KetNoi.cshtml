@model NhaTot.Web.Areas.Admin.Models.ApifyConnectionModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Kết nối Apify"; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <h3>Kết nối Apify</h3><a asp-action="Index" class="btn btn-outline-secondary">Về SocialBot</a>
</div>
@if (TempData["ConnectionMessage"] is string message)
{ <div class="alert alert-success" role="status">@message</div> }
<div class="card card-body" style="max-width:640px">
    <h5>@(Model.HasToken ? "Đã có token trên server" : "Nhập token để bắt đầu")</h5>
    <p class="text-muted">Lấy API token từ tài khoản Apify của bạn, dán vào đây và lưu một lần. Hệ thống sẽ kiểm tra kết nối; bước này không chạy cào dữ liệu.</p>
    <form asp-action="KetNoi" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <label for="Token" class="form-label">@(Model.HasToken ? "Token mới (thay thế token đang dùng)" : "API token Apify")</label>
        <input id="Token" name="Token" type="password" value="" class="form-control" autocomplete="new-password" spellcheck="false" required maxlength="512" />
        <p class="small text-muted mt-2">Token được mã hóa trước khi lưu, không hiển thị lại trên trang. Nếu kiểm tra thất bại, token hiện tại vẫn được giữ.</p>
        <button type="submit" class="btn btn-primary">Kiểm tra và lưu kết nối</button>
    </form>
</div>
<div class="mt-3 d-flex flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-primary">Thêm nguồn và cào thử</a>
    <a asp-action="LichCao" class="btn btn-outline-primary">Thiết lập lịch tự động</a>
</div>
