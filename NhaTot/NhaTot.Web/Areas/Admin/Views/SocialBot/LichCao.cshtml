@model NhaTot.Web.Areas.Admin.Models.CrawlScheduleModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Lịch cào tự động";
   var state = (NhaTot.Domain.Entities.LichCaoDuLieu)ViewBag.Schedule;
   string LocalTime(DateTime? value) => value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") : "—";
}
<div class="d-flex flex-wrap justify-content-between mb-3 gap-2"><h3>Lịch cào tự động</h3><a asp-action="Index" class="btn btn-outline-secondary">Về SocialBot</a></div>
@if (TempData["ScheduleMessage"] is string message) { <div class="alert alert-info" role="status">@message</div> }
<div class="row g-4">
    <div class="col-lg-6">
        <form asp-action="LichCao" method="post" class="card card-body gap-2">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-check"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">Bật cào theo lịch</label></div>
            <label asp-for="IntervalMinutes">Khoảng cách giữa hai phiên (phút)</label>
            <input asp-for="IntervalMinutes" type="number" min="15" max="1440" class="form-control" />
            <label asp-for="PostsPerSource">Số bài tối đa mỗi nguồn</label>
            <input asp-for="PostsPerSource" type="number" min="1" max="100" class="form-control" />
            <label asp-for="LookbackDays">Thời gian đăng bài</label>
            <select asp-for="LookbackDays" class="form-select"><option value="1">24 giờ qua</option><option value="7">7 ngày qua</option><option value="30">30 ngày qua</option></select>
            @if (state.Status == "START_UNKNOWN")
            {
                <div class="form-check"><input asp-for="CheckedApifyConsole" class="form-check-input" /><label asp-for="CheckedApifyConsole" class="form-check-label">Tôi đã kiểm tra Apify Console và dừng phiên chưa xác định.</label></div>
            }
            <p class="small text-muted">Sử dụng 1–10 nguồn Facebook công khai đang bật. Tự lưu, chống trùng và bóc tách; bài mới vẫn cần Admin duyệt. Apify tính lượt cào theo tài khoản đã cấu hình.</p>
            <button class="btn btn-primary" type="submit">Lưu lịch</button>
        </form>
    </div>
    <div class="col-lg-6">
        <section class="card card-body">
            <h5>Trạng thái lịch</h5>
            <dl><dt>Lịch</dt><dd>@(state.Enabled ? "Đang bật" : "Đang tắt")</dd>
                <dt>Phiên gần nhất</dt><dd>@state.Status</dd>
                <dt>ID phiên đang theo dõi</dt><dd>@(state.ActiveRunId ?? "—")</dd>
                <dt>Bắt đầu gần nhất (giờ Việt Nam)</dt><dd>@LocalTime(state.LastStartedUtc)</dd>
                <dt>Dự kiến chạy tiếp (giờ Việt Nam)</dt><dd>@(state.Enabled ? LocalTime(state.NextRunUtc) : "Lịch đã tắt")</dd>
                <dt>Kết quả</dt><dd>@(state.LastMessage ?? "Chưa có phiên tự động.")</dd>
            </dl>
            <p class="small text-muted">Ứng dụng phải luôn chạy để lịch hoạt động. Khoảng cách tính từ khi phiên trước hoàn tất. Tắt lịch ngăn tạo phiên mới; phiên hiện tại tiếp tục được theo dõi. Tải lại trang để cập nhật trạng thái.</p>
            <a asp-action="LichCao" class="btn btn-outline-secondary">Cập nhật trạng thái</a>
        </section>
    </div>
</div>
