@model IEnumerable<NhaTot.Domain.Entities.PhienBanMoHinh>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản trị MLOps AI Định giá BĐS";
    var activeModel = ViewBag.ActiveModel as NhaTot.Domain.Entities.PhienBanMoHinh;
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-cpu text-primary me-2"></i>MLOps - Registry & Đánh giá Mô hình AI</h3>
        <p class="text-muted mb-0">Quản lý các phiên bản mô hình Học máy (XGBoost / Random Forest) và đo lường chỉ số sai số định giá</p>
    </div>
</div>

<!-- Active Model Hero Card -->
@if (activeModel != null)
{
    <div class="card border-0 shadow-sm bg-primary text-white mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge bg-light text-primary fw-bold text-uppercase mb-2">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Active Production Model
                    </span>
                    <h2 class="fw-bold text-white mb-1">@activeModel.TenMoHinh (v@activeModel.PhienBan)</h2>
                    <p class="mb-0 text-white-50">
                        <i class="bi bi-folder2-open me-1"></i>Artifact: <code>@activeModel.DuongDanArtifact</code> | 
                        Số mẫu huấn luyện: <strong>@string.Format("{0:N0}", activeModel.SoMauHuanLuyen)</strong> mẫu
                    </p>
                </div>
                <div class="text-end">
                    <small class="text-white-50 d-block">Thời điểm huấn luyện</small>
                    <span class="fw-bold fs-5">@activeModel.NgayHuanLuyen?.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>
}

<!-- Model Registry Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 py-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-layers me-2 text-primary"></i>Danh sách Phiên bản Mô hình (Model Registry)</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Mã</th>
                        <th>Tên thuật toán / Model</th>
                        <th>Phiên bản</th>
                        <th>Số mẫu Train</th>
                        <th>Ngày huấn luyện</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 250px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaPhienBan">
                                <td><strong>#@item.MaPhienBan</strong></td>
                                <td>
                                    <div class="fw-bold text-dark">@item.TenMoHinh</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@(item.GhiChu ?? "---")</small>
                                </td>
                                <td><span class="badge bg-info-subtle text-info border border-info-subtle fw-bold">v@item.PhienBan</span></td>
                                <td><strong>@string.Format("{0:N0}", item.SoMauHuanLuyen)</strong> mẫu</td>
                                <td><small class="text-muted">@item.NgayHuanLuyen?.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td>
                                    @if (item.TrangThai == "ACTIVE")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle-fill me-1"></i>ACTIVE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">DEPRECATED</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info me-1" onclick="viewMetrics(@item.MaPhienBan)">
                                        <i class="bi bi-bar-chart-line me-1"></i> Báo cáo MAE/R²
                                    </button>
                                    @if (item.TrangThai != "ACTIVE")
                                    {
                                        <button class="btn btn-sm btn-success" onclick="setActiveModel(@item.MaPhienBan)">
                                            <i class="bi bi-lightning"></i> Kích hoạt
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có phiên bản mô hình AI nào trong Registry.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Xem Báo Cáo Chỉ Số MAE, RMSE, R² -->
<div class="modal fade" id="metricsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Báo cáo Chỉ số Sai số Model <span id="modalModelTitle" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tập dữ liệu (Dataset)</th>
                                <th>MAE (Sai số tuyệt đối TB)</th>
                                <th>RMSE (Căn phương sai)</th>
                                <th>R² Score (Độ chính xác)</th>
                                <th>Số mẫu kiểm thử</th>
                            </tr>
                        </thead>
                        <tbody id="metricsTableBody">
                            <!-- Dữ liệu JS render ở đây -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const metricsModal = new bootstrap.Modal(document.getElementById('metricsModal'));

        // 1. Lấy chỉ số đánh giá sai số từ Server
        async function viewMetrics(id) {
            try {
                const res = await fetch(`/Admin/MlOps/GetEvaluationMetrics/${id}`);
                const result = await res.json();

                if (result.success) {
                    document.getElementById('modalModelTitle').innerText = `${result.modelName} (v${result.version})`;
                    const tbody = document.getElementById('metricsTableBody');
                    tbody.innerHTML = '';

                    if (result.metrics && result.metrics.length > 0) {
                        result.metrics.forEach(m => {
                            const r2Formatted = (m.r2 * 100).toFixed(2) + '%';
                            tbody.innerHTML += `
                                <tr>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">${m.tapDuLieu}</span></td>
                                    <td><strong class="text-danger">${m.mae ? m.mae.toLocaleString('vi-VN') : 0} VNĐ</strong></td>
                                    <td><strong class="text-warning">${m.rmse ? m.rmse.toLocaleString('vi-VN') : 0} VNĐ</strong></td>
                                    <td><span class="badge bg-success fs-6">${r2Formatted}</span></td>
                                    <td>${m.soMau ? m.soMau.toLocaleString('vi-VN') : 0} mẫu</td>
                                </tr>
                            `;
                        });
                    } else {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Chưa có kết quả đánh giá chỉ số cho phiên bản này.</td></tr>';
                    }

                    metricsModal.show();
                } else { 
                    alert(result.message); 
                }
            } catch (e) { 
                alert('Không thể kết nối đến máy chủ!'); 
            }
        }

        // 2. Chuyển đổi Model chính cho Production
        async function setActiveModel(id) {
            if (confirm(`Bạn có chắc chắn muốn chuyển Phiên bản #${id} làm Production Model chính cho AI Valuation Engine?`)) {
                try {
                    const res = await fetch(`/Admin/MlOps/SetActiveModel/${id}`, { method: 'POST' });
                    const result = await res.json();
                    if (result.success) { 
                        location.reload(); 
                    } else { 
                        alert(result.message); 
                    }
                } catch (e) { 
                    alert('Lỗi khi kích hoạt Model!'); 
                }
            }
        }
    </script>
}