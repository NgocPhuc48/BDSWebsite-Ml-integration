@model IEnumerable<NhaTot.Domain.Entities.LoaiBd>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Loại Bất động sản";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-houses me-2 text-primary"></i>Quản lý Loại Bất động sản</h3>
        <p class="text-muted mb-0">Danh mục phân loại các loại hình BĐS trên hệ thống NhaTot</p>
    </div>
    <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i> Thêm Loại BĐS mới
    </button>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã loại</th>
                        <th>Tên Loại BĐS</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaLoaiBds">
                                <td><strong>#@item.MaLoaiBds</strong></td>
                                <td><span class="fw-semibold text-dark">@item.TenLoaiBds</span></td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</small></td>
                                <td>
                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Tạm khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.MaLoaiBds)">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@item.MaLoaiBds, '@item.TenLoaiBds')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu Loại Bất động sản</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Popup Thêm / Sửa -->
<div class="modal fade" id="loaiBdsModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="loaiBdsModalTitle">Thêm Loại Bất động sản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="loaiBdsForm">
                    <input type="hidden" id="MaLoaiBds" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Loại BĐS <span class="text-danger">*</span></label>
                        <input type="text" id="TenLoaiBds" class="form-control" placeholder="Ví dụ: Đất nền, Nhà phố, Căn hộ chung cư..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả chi tiết</label>
                        <textarea id="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả đặc điểm loại hình BĐS..."></textarea>
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="TrangThai" checked>
                        <label class="form-check-label fw-semibold" for="TrangThai">Kích hoạt hoạt động</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveLoaiBds()">
                    <i class="bi bi-save me-1"></i> Lưu lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('loaiBdsModal');
        const loaiBdsModal = new bootstrap.Modal(modalElement);

        // 1. Mở Modal Thêm mới
        function openCreateModal() {
            document.getElementById('loaiBdsModalTitle').innerText = 'Thêm Loại Bất động sản mới';
            document.getElementById('MaLoaiBds').value = 0;
            document.getElementById('TenLoaiBds').value = '';
            document.getElementById('MoTa').value = '';
            document.getElementById('TrangThai').checked = true;
            loaiBdsModal.show();
        }

        // 2. Mở Modal Sửa (Lấy dữ liệu qua AJAX)
        async function openEditModal(id) {
            try {
                const response = await fetch(`/Admin/LoaiBds/GetById/${id}`);
                const result = await response.json();

                if (result.success) {
                    const data = result.data;
                    document.getElementById('loaiBdsModalTitle').innerText = 'Chỉnh sửa Loại Bất động sản';
                    document.getElementById('MaLoaiBds').value = data.maLoaiBds;
                    document.getElementById('TenLoaiBds').value = data.tenLoaiBds || '';
                    document.getElementById('MoTa').value = data.moTa || '';
                    document.getElementById('TrangThai').checked = data.trangThai === true;
                    loaiBdsModal.show();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Có lỗi xảy ra khi tải dữ liệu!');
            }
        }

        // 3. Xử lý Lưu dữ liệu (Thêm hoặc Sửa)
        async function saveLoaiBds() {
            const maLoaiBds = parseInt(document.getElementById('MaLoaiBds').value);
            const tenLoaiBds = document.getElementById('TenLoaiBds').value.trim();
            const moTa = document.getElementById('MoTa').value.trim();
            const trangThai = document.getElementById('TrangThai').checked;

            if (!tenLoaiBds) {
                alert('Vui lòng nhập tên Loại Bất động sản!');
                return;
            }

            const payload = {
                MaLoaiBds: maLoaiBds,
                TenLoaiBds: tenLoaiBds,
                MoTa: moTa,
                TrangThai: trangThai
            };

            try {
                const response = await fetch('/Admin/LoaiBds/Save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    loaiBdsModal.hide();
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Không thể kết nối đến máy chủ!');
            }
        }

        // 4. Xử lý Xóa qua AJAX
        async function confirmDelete(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa "${name}" không?`)) {
                try {
                    const response = await fetch(`/Admin/LoaiBds/Delete/${id}`, {
                        method: 'POST'
                    });

                    const result = await response.json();
                    if (result.success) {
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert('Lỗi khi thực hiện xóa!');
                }
            }
        }
    </script>
}