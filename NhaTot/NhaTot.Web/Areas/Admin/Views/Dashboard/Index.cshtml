@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Trang tổng quan Quản trị";
    var tinChoDuyetList = ViewBag.TinChoDuyetList as List<NhaTot.Domain.Entities.TinDang>;
    var nguoiDungMoiList = ViewBag.NguoiDungMoiList as List<NhaTot.Domain.Entities.NguoiDung>;
}

<!-- Header & Thao tác nhanh -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-speedometer2 me-2 text-primary"></i>Tổng quan hệ thống</h3>
        <p class="text-muted mb-0">Theo dõi chỉ số vận hành BĐS, ví điểm và luồng duyệt tin rao</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="LoaiBds" asp-action="Create" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Loại BĐS
        </a>
        <a asp-area="Admin" asp-controller="TinDang" asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-check2-square me-1"></i> Duyệt tin ngay (@ViewBag.TinChoDuyet)
        </a>
    </div>
</div>

<!-- Grid Card Thống Kê Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Người dùng -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1">Tổng người dùng</span>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.TongNguoiDung</h3>
                    <small class="text-success"><i class="bi bi-person-badge me-1"></i>@ViewBag.TongMoiGioi Môi giới</small>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Tin chờ duyệt -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1">Tin chờ duyệt</span>
                    <h3 class="fw-bold text-warning mb-0">@ViewBag.TinChoDuyet</h3>
                    <small class="text-muted">Trên tổng @ViewBag.TongTinDang tin rao</small>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-3">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Ví điểm -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1">Tổng số dư Ví điểm</span>
                    <h3 class="fw-bold text-success mb-0">@string.Format("{0:N0}", ViewBag.TongSoDuDiem)</h3>
                    <small class="text-muted">Điểm hệ thống</small>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3">
                    <i class="bi bi-wallet2 fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: AI & Social Lead -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1">Loại Bất động sản</span>
                    <h3 class="fw-bold text-info mb-0">@ViewBag.TongLoaiBds</h3>
                    <small class="text-muted"><i class="bi bi-cpu me-1"></i>@ViewBag.TongLuotDinhGia lượt định giá</small>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-3">
                    <i class="bi bi-tags-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Section: Bảng Tin Chờ Duyệt & Người Dùng Mới -->
<div class="row g-4">
    <!-- Bảng Tin Đăng Chờ Duyệt -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-warning me-2"></i>Tin đăng chờ duyệt mới nhất</h5>
                <a asp-area="Admin" asp-controller="TinDang" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã tin</th>
                                <th>Tiêu đề bài rao</th>
                                <th>Loại GD</th>
                                <th>Giá rao</th>
                                <th>Ngày đăng</th>
                                <th class="text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (tinChoDuyetList != null && tinChoDuyetList.Any())
                            {
                                foreach (var tin in tinChoDuyetList)
                                {
                                    <tr>
                                        <td><strong>#@tin.MaTin</strong></td>
                                        <td>
                                            <span class="fw-semibold text-dark d-block text-truncate" style="max-width: 260px;">@tin.TieuDe</span>
                                        </td>
                                        <td>
                                            @if (tin.LoaiGiaoDich == "BAN")
                                            {
                                                <span class="badge bg-danger">BÁN</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">CHO THUÊ</span>
                                            }
                                        </td>
                                        <td class="text-success fw-bold">
                                            @string.Format("{0:N0} đ", tin.GiaRaoVnd)
                                        </td>
                                        <td class="text-muted small">@tin.NgayDang?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <a asp-area="Admin" asp-controller="TinDang" asp-action="Edit" asp-route-id="@tin.MaTin" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Duyệt
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-check-circle fs-3 d-block mb-1 text-success"></i>
                                        Không có tin đăng nào đang chờ duyệt!
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng Thành Viên Mới -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-plus text-primary me-2"></i>Thành viên mới</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (nguoiDungMoiList != null && nguoiDungMoiList.Any())
                    {
                        foreach (var user in nguoiDungMoiList)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h6 class="mb-0 fw-bold">@user.HoTen</h6>
                                    <small class="text-muted">@user.SoDienThoai - @user.Email</small>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary">
                                    @(user.VaiTro == 2 ? "Môi giới" : "Khách")
                                </span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center py-4 text-muted">Chưa có người dùng mới</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>