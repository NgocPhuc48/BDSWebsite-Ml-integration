@model IEnumerable<NhaTot.Domain.Entities.PhuongXa>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Phường / Xã / Thị trấn";
    var quanHuyenList = ViewBag.QuanHuyens as List<NhaTot.Domain.Entities.QuanHuyen>;
    int? selectedQuanHuyen = ViewBag.SelectedQuanHuyen as int?;
}

<!-- Header & Filter -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-geo me-2 text-primary"></i>Quản lý Phường / Xã / Thị trấn</h3>
        <p class="text-muted mb-0">Danh mục đơn vị hành chính cấp 3 trên hệ thống NhaTot</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="maQuanHuyen" class="form-select shadow-sm" onchange="this.form.submit()" style="min-width: 240px;">
                <option value="">-- Tất cả Quận / Huyện --</option>
                @if (quanHuyenList != null)
                {
                    foreach (var q in quanHuyenList)
                    {
                        var isSelected = selectedQuanHuyen == q.MaQuanHuyen ? "selected" : null;
                        <option value="@q.MaQuanHuyen" selected="@isSelected">
                            @q.TenQuanHuyen (@(q.MaTinhNavigation?.TenTinh ?? "Nghệ An"))
                        </option>
                    }
                }
            </select>
        </form>

        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="bi bi-plus-circle me-1"></i> Thêm Phường / Xã mới
        </button>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Mã Xã</th>
                        <th>Tên Phường / Xã / Thị trấn</th>
                        <th>Thuộc Quận / Huyện</th>
                        <th>Tỉnh / Thành</th>
                        <th>Mã hành chính</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaPhuongXa">
                                <td><strong>#@item.MaPhuongXa</strong></td>
                                <td><span class="fw-semibold text-dark">@item.TenPhuongXa</span></td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle fs-6 fw-normal">
                                        @(item.MaQuanHuyenNavigation?.TenQuanHuyen ?? "---")
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @(item.MaQuanHuyenNavigation?.MaTinhNavigation?.TenTinh ?? "---")
                                    </small>
                                </td>
                                <td><code>@(string.IsNullOrEmpty(item.MaHanhChinh) ? "---" : item.MaHanhChinh)</code></td>
                                <td>
                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Tạm khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.MaPhuongXa)">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@item.MaPhuongXa, '@item.TenPhuongXa')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu Phường / Xã phù hợp</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Popup Thêm / Sửa -->
<div class="modal fade" id="phuongXaModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="phuongXaModalTitle">Thêm Phường / Xã</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="phuongXaForm">
                    <input type="hidden" id="MaPhuongXa" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thuộc Quận / Huyện <span class="text-danger">*</span></label>
                        <select id="MaQuanHuyen" class="form-select" required>
                            <option value="">-- Chọn Quận / Huyện --</option>
                            @if (quanHuyenList != null)
                            {
                                foreach (var q in quanHuyenList)
                                {
                                    <option value="@q.MaQuanHuyen">
                                        @q.TenQuanHuyen (@(q.MaTinhNavigation?.TenTinh ?? "Nghệ An"))
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Phường / Xã / Thị trấn <span class="text-danger">*</span></label>
                        <input type="text" id="TenPhuongXa" class="form-control" placeholder="Ví dụ: Phường Hưng Dũng, Xã Nghi Phú..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã hành chính</label>
                        <input type="text" id="MaHanhChinh" class="form-control" placeholder="Ví dụ: 18109..." />
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="TrangThai" checked>
                        <label class="form-check-label fw-semibold" for="TrangThai">Kích hoạt hoạt động</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4" onclick="savePhuongXa()">
                    <i class="bi bi-save me-1"></i> Lưu lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('phuongXaModal');
        const phuongXaModal = new bootstrap.Modal(modalElement);

        // 1. Mở Modal Thêm mới
        function openCreateModal() {
            document.getElementById('phuongXaModalTitle').innerText = 'Thêm Phường / Xã mới';
            document.getElementById('MaPhuongXa').value = 0;
            document.getElementById('MaQuanHuyen').value = document.querySelector('select[name="maQuanHuyen"]')?.value || '';
            document.getElementById('TenPhuongXa').value = '';
            document.getElementById('MaHanhChinh').value = '';
            document.getElementById('TrangThai').checked = true;
            phuongXaModal.show();
        }

        // 2. Mở Modal Sửa (Lấy dữ liệu qua AJAX)
        async function openEditModal(id) {
            try {
                const response = await fetch(`/Admin/PhuongXa/GetById/${id}`);
                const result = await response.json();

                if (result.success) {
                    const data = result.data;
                    document.getElementById('phuongXaModalTitle').innerText = 'Chỉnh sửa Phường / Xã';
                    document.getElementById('MaPhuongXa').value = data.maPhuongXa;
                    document.getElementById('MaQuanHuyen').value = data.maQuanHuyen || '';
                    document.getElementById('TenPhuongXa').value = data.tenPhuongXa || '';
                    document.getElementById('MaHanhChinh').value = data.maHanhChinh || '';
                    document.getElementById('TrangThai').checked = data.trangThai === true;
                    phuongXaModal.show();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Có lỗi xảy ra khi tải dữ liệu!');
            }
        }

        // 3. Xử lý Lưu dữ liệu (Thêm hoặc Sửa)
        async function savePhuongXa() {
            const maPhuongXa = parseInt(document.getElementById('MaPhuongXa').value);
            const maQuanHuyen = parseInt(document.getElementById('MaQuanHuyen').value);
            const tenPhuongXa = document.getElementById('TenPhuongXa').value.trim();
            const maHanhChinh = document.getElementById('MaHanhChinh').value.trim();
            const trangThai = document.getElementById('TrangThai').checked;

            if (!maQuanHuyen) {
                alert('Vui lòng chọn Quận / Huyện!');
                return;
            }

            if (!tenPhuongXa) {
                alert('Vui lòng nhập tên Phường / Xã!');
                return;
            }

            const payload = {
                MaPhuongXa: maPhuongXa,
                MaQuanHuyen: maQuanHuyen,
                TenPhuongXa: tenPhuongXa,
                MaHanhChinh: maHanhChinh,
                TrangThai: trangThai
            };

            try {
                const response = await fetch('/Admin/PhuongXa/Save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    phuongXaModal.hide();
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Không thể kết nối đến máy chủ!');
            }
        }

        // 4. Xử lý Xóa qua AJAX
        async function confirmDelete(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa "${name}" không?`)) {
                try {
                    const response = await fetch(`/Admin/PhuongXa/Delete/${id}`, {
                        method: 'POST'
                    });

                    const result = await response.json();
                    if (result.success) {
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert('Lỗi khi thực hiện xóa!');
                }
            }
        }
    </script>
}