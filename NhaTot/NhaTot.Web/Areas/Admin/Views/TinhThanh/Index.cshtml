@model IEnumerable<NhaTot.Domain.Entities.TinhThanh>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Tỉnh / Thành phố";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-map me-2 text-primary"></i>Quản lý Tỉnh / Thành phố</h3>
        <p class="text-muted mb-0">Danh mục các tỉnh thành hỗ trợ trên hệ thống NhaTot</p>
    </div>
    <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i> Thêm Tỉnh / Thành mới
    </button>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã tỉnh</th>
                        <th>Tên Tỉnh / Thành phố</th>
                        <th>Mã hành chính</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaTinh">
                                <td><strong>#@item.MaTinh</strong></td>
                                <td><span class="fw-semibold text-dark">@item.TenTinh</span></td>
                                <td><code>@(string.IsNullOrEmpty(item.MaHanhChinh) ? "---" : item.MaHanhChinh)</code></td>
                                <td>
                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Tạm khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.MaTinh)">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@item.MaTinh, '@item.TenTinh')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu Tỉnh / Thành phố</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Popup Thêm / Sửa -->
<div class="modal fade" id="tinhThanhModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="tinhThanhModalTitle">Thêm Tỉnh / Thành phố</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="tinhThanhForm">
                    <input type="hidden" id="MaTinh" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Tỉnh / Thành phố <span class="text-danger">*</span></label>
                        <input type="text" id="TenTinh" class="form-control" placeholder="Ví dụ: Tỉnh Nghệ An, TP Hà Nội..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã hành chính</label>
                        <input type="text" id="MaHanhChinh" class="form-control" placeholder="Ví dụ: 40, 01..." />
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="TrangThai" checked>
                        <label class="form-check-label fw-semibold" for="TrangThai">Kích hoạt hoạt động</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveTinhThanh()">
                    <i class="bi bi-save me-1"></i> Lưu lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('tinhThanhModal');
        const tinhThanhModal = new bootstrap.Modal(modalElement);

        // 1. Mở Modal Thêm mới
        function openCreateModal() {
            document.getElementById('tinhThanhModalTitle').innerText = 'Thêm Tỉnh / Thành phố mới';
            document.getElementById('MaTinh').value = 0;
            document.getElementById('TenTinh').value = '';
            document.getElementById('MaHanhChinh').value = '';
            document.getElementById('TrangThai').checked = true;
            tinhThanhModal.show();
        }

        // 2. Mở Modal Sửa (Lấy dữ liệu qua Fetch API AJAX)
        async function openEditModal(id) {
            try {
                const response = await fetch(`/Admin/TinhThanh/GetById/${id}`);
                const result = await response.json();

                if (result.success) {
                    const data = result.data;
                    document.getElementById('tinhThanhModalTitle').innerText = 'Chỉnh sửa Tỉnh / Thành phố';
                    document.getElementById('MaTinh').value = data.maTinh;
                    document.getElementById('TenTinh').value = data.tenTinh || '';
                    document.getElementById('MaHanhChinh').value = data.maHanhChinh || '';
                    document.getElementById('TrangThai').checked = data.trangThai === true;
                    tinhThanhModal.show();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Có lỗi xảy ra khi tải dữ liệu!');
            }
        }

        // 3. Xử lý Lưu dữ liệu (Thêm hoặc Sửa)
        async function saveTinhThanh() {
            const maTinh = parseInt(document.getElementById('MaTinh').value);
            const tenTinh = document.getElementById('TenTinh').value.trim();
            const maHanhChinh = document.getElementById('MaHanhChinh').value.trim();
            const trangThai = document.getElementById('TrangThai').checked;

            if (!tenTinh) {
                alert('Vui lòng nhập tên Tỉnh / Thành phố!');
                return;
            }

            const payload = {
                MaTinh: maTinh,
                TenTinh: tenTinh,
                MaHanhChinh: maHanhChinh,
                TrangThai: trangThai
            };

            try {
                const response = await fetch('/Admin/TinhThanh/Save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    tinhThanhModal.hide();
                    location.reload(); // Tải lại trang để cập nhật danh sách
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Không thể kết nối đến máy chủ!');
            }
        }

        // 4. Xử lý Xóa qua AJAX
        async function confirmDelete(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa "${name}" không?`)) {
                try {
                    const response = await fetch(`/Admin/TinhThanh/Delete/${id}`, {
                        method: 'POST'
                    });

                    const result = await response.json();
                    if (result.success) {
                        // Xóa dòng khỏi bảng hiển thị tức thì
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert('Lỗi khi thực hiện xóa!');
                }
            }
        }
    </script>
}