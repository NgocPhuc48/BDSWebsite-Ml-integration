@model IEnumerable<NhaTot.Domain.Entities.YeuCauTuVan>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Phân công & Quản lý Tư vấn";
    string currentStatus = ViewBag.CurrentStatus ?? "PENDING";
    var danhSachTuVanVien = ViewBag.DanhSachTuVanVien as List<NhaTot.Domain.Entities.NguoiDung>;
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-headset text-primary me-2"></i>Phân công & Quản lý Yêu cầu Tư vấn</h3>
        <p class="text-muted mb-0">Điều phối công việc tư vấn cho khách hàng đến đội ngũ Tư vấn viên chuyên nghiệp</p>
    </div>
</div>

<!-- Cards Thống kê trạng thái -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm bg-warning text-dark h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-dark-50 small fw-bold text-uppercase">Chờ phân công</div>
                        <h3 class="fw-bold my-1">@ViewBag.CountPending</h3>
                        <small class="text-dark-50"><i class="bi bi-exclamation-circle me-1"></i>Cần xử lý ngay</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm bg-info text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Đang tư vấn</div>
                        <h3 class="fw-bold my-1">@ViewBag.CountInProgress</h3>
                        <small class="text-white-50"><i class="bi bi-person-check me-1"></i>Đã phân công nhân viên</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-telephone-outbound"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Đã hoàn thành</div>
                        <h3 class="fw-bold my-1">@ViewBag.CountClosed</h3>
                        <small class="text-white-50"><i class="bi bi-check2-all me-1"></i>Đã hỗ trợ xong</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-check-circle-fill"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Lọc Trạng Thái -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "PENDING" ? "active" : "") fw-semibold" href="/Admin/PhanCongTuVan?trangThai=PENDING">
                    <i class="bi bi-clock-history me-1"></i> Chờ phân công <span class="badge bg-warning text-dark ms-1">@ViewBag.CountPending</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "IN_PROGRESS" ? "active" : "") fw-semibold" href="/Admin/PhanCongTuVan?trangThai=IN_PROGRESS">
                    <i class="bi bi-gear-wide-connected me-1"></i> Đang tư vấn <span class="badge bg-info ms-1">@ViewBag.CountInProgress</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "CLOSED" ? "active" : "") fw-semibold" href="/Admin/PhanCongTuVan?trangThai=CLOSED">
                    <i class="bi bi-check-circle me-1"></i> Đã đóng <span class="badge bg-success ms-1">@ViewBag.CountClosed</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "ALL" ? "active" : "") fw-semibold" href="/Admin/PhanCongTuVan?trangThai=ALL">Tất cả yêu cầu</a>
            </li>
        </ul>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Mã YC</th>
                        <th>Khách hàng gửi</th>
                        <th>Tiêu đề yêu cầu</th>
                        <th>Ưu tiên</th>
                        <th>Tư vấn viên tiếp nhận</th>
                        <th>Thời gian gửi</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var latestAssign = item.PhanCongTuVans.OrderByDescending(p => p.NgayPhanCong).FirstOrDefault();
                            <tr id="row-@item.MaYeuCau">
                                <td><strong>#@item.MaYeuCau</strong></td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.MaNguoiGuiNavigation?.HoTen ?? "N/A")</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(item.MaNguoiGuiNavigation?.SoDienThoai ?? "---")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 260px;">@item.TieuDe</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 260px;">@(item.NoiDung ?? "---")</small>
                                </td>
                                <td>
                                    @switch (item.MucDoUuTien)
                                    {
                                        case 3:
                                            <span class="badge bg-danger text-white"><i class="bi bi-exclamation-triangle me-1"></i>Cao</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-warning text-dark">Trung bình</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Thường</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (latestAssign?.MaTuVanVienNavigation != null)
                                    {
                                        <div class="fw-semibold text-primary"><i class="bi bi-person-badge me-1"></i>@latestAssign.MaTuVanVienNavigation.HoTen</div>
                                        <small class="text-muted">@latestAssign.NgayPhanCong?.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa phân công</span>
                                    }
                                </td>
                                <td><small class="text-muted">@item.NgayTao?.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td>
                                    @if (item.TrangThai == "IN_PROGRESS")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Đang tư vấn</span>
                                    }
                                    else if (item.TrangThai == "CLOSED")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đã hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ phân công</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info me-1" onclick="viewDetail(@item.MaYeuCau)">
                                        <i class="bi bi-eye"></i> Xem
                                    </button>
                                    @if (item.TrangThai != "CLOSED")
                                    {
                                        <button class="btn btn-sm btn-primary" onclick="openAssignModal(@item.MaYeuCau, '@item.TieuDe', @(latestAssign?.MaTuVanVien ?? 0))">
                                            <i class="bi bi-person-plus"></i> @(latestAssign != null ? "Đổi TVV" : "Phân công")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy yêu cầu tư vấn nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Phân công Tư vấn viên -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary">Phân công Tư vấn viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <input type="hidden" id="assignMaYeuCau" value="0" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Yêu cầu tư vấn:</label>
                    <input type="text" id="assignTieuDe" class="form-control bg-light" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn Tư vấn viên tiếp nhận <span class="text-danger">*</span></label>
                    <select id="assignMaTuVanVien" class="form-select" required>
                        <option value="">-- Chọn Tư vấn viên --</option>
                        @if (danhSachTuVanVien != null)
                        {
                            foreach (var tvv in danhSachTuVanVien)
                            {
                                <option value="@tvv.MaNguoiDung">@tvv.HoTen (@(string.IsNullOrEmpty(tvv.SoDienThoai) ? tvv.Email : tvv.SoDienThoai))</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ghi chú cho Tư vấn viên</label>
                    <textarea id="assignGhiChu" class="form-control" rows="3" placeholder="Nhập chỉ đạo hoặc ghi chú thêm cho nhân viên..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveAssign()">
                    <i class="bi bi-check-circle me-1"></i> Xác nhận Phân công
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xem Chi Tiết Yêu Cầu -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Chi tiết Yêu cầu Tư vấn <span id="detailMaYeuCau" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <h5 id="detailTieuDe" class="fw-bold text-dark mb-2"></h5>
                <div class="d-flex gap-3 mb-3 text-muted small">
                    <span><i class="bi bi-person me-1"></i>Khách hàng: <strong id="detailKhachHang" class="text-dark"></strong></span>
                    <span><i class="bi bi-telephone me-1"></i>SĐT: <strong id="detailSdt" class="text-dark"></strong></span>
                    <span><i class="bi bi-calendar me-1"></i>Thời gian: <strong id="detailThoiGian"></strong></span>
                </div>
                <div class="mb-3">
                    <label class="fw-bold text-dark">Nội dung yêu cầu:</label>
                    <div id="detailNoiDung" class="p-3 bg-light rounded text-dark" style="white-space: pre-line;"></div>
                </div>

                <hr />
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-1"></i>Lịch sử Phân công & Xử lý</h6>
                <div id="assignHistoryList" class="list-group list-group-flush"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const assignModal = new bootstrap.Modal(document.getElementById('assignModal'));
        const detailModal = new bootstrap.Modal(document.getElementById('detailModal'));

        // 1. Mở Modal Phân công
        function openAssignModal(id, title, currentTvvId) {
            document.getElementById('assignMaYeuCau').value = id;
            document.getElementById('assignTieuDe').value = title;
            document.getElementById('assignMaTuVanVien').value = currentTvvId || '';
            document.getElementById('assignGhiChu').value = '';
            assignModal.show();
        }

        // 2. Lưu Phân công Tư vấn viên
        async function saveAssign() {
            const maYeuCau = parseInt(document.getElementById('assignMaYeuCau').value);
            const maTuVanVien = parseInt(document.getElementById('assignMaTuVanVien').value);
            const ghiChu = document.getElementById('assignGhiChu').value.trim();

            if (!maTuVanVien) {
                alert('Vui lòng chọn Tư vấn viên tiếp nhận!');
                return;
            }

            const payload = {
                MaYeuCau: maYeuCau,
                MaTuVanVien: maTuVanVien,
                GhiChu: ghiChu
            };

            try {
                const res = await fetch('/Admin/PhanCongTuVan/Assign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();
                if (result.success) {
                    assignModal.hide();
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (e) {
                alert('Không thể kết nối đến máy chủ!');
            }
        }

        // 3. Xem Chi tiết Yêu cầu & Lịch sử
        async function viewDetail(id) {
            try {
                const res = await fetch(`/Admin/PhanCongTuVan/GetDetail/${id}`);
                const result = await res.json();

                if (result.success) {
                    const data = result.data;
                    document.getElementById('detailMaYeuCau').innerText = `#${data.maYeuCau}`;
                    document.getElementById('detailTieuDe').innerText = data.tieuDe || 'Không có tiêu đề';
                    document.getElementById('detailKhachHang').innerText = data.maNguoiGuiNavigation?.hoTen || 'N/A';
                    document.getElementById('detailSdt').innerText = data.maNguoiGuiNavigation?.soDienThoai || 'N/A';
                    document.getElementById('detailThoiGian').innerText = new Date(data.ngayTao).toLocaleString('vi-VN');
                    document.getElementById('detailNoiDung').innerText = data.noiDung || 'Không có nội dung';

                    // Đổ danh sách lịch sử phân công
                    const historyBox = document.getElementById('assignHistoryList');
                    historyBox.innerHTML = '';

                    if (data.phanCongTuVans && data.phanCongTuVans.length > 0) {
                        data.phanCongTuVans.forEach(item => {
                            const timeStr = new Date(item.ngayPhanCong).toLocaleString('vi-VN');
                            const tvvName = item.maTuVanVienNavigation?.hoTen || 'N/A';
                            const adminName = item.maNguoiPhanCongNavigation?.hoTen || 'Admin';

                            historyBox.innerHTML += `
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-primary"><i class="bi bi-person-check me-1"></i>${tvvName}</strong>
                                        <small class="text-muted">${timeStr}</small>
                                    </div>
                                    <div class="small text-muted mb-1">Phân công bởi: ${adminName}</div>
                                    ${item.ghiChu ? `<div class="small bg-light p-2 rounded text-dark">Ghi chú: ${item.ghiChu}</div>` : ''}
                                </div>
                            `;
                        });
                    } else {
                        historyBox.innerHTML = '<div class="text-muted small py-2">Chưa có lịch sử phân công.</div>';
                    }

                    detailModal.show();
                } else {
                    alert(result.message);
                }
            } catch (e) {
                alert('Có lỗi khi tải dữ liệu chi tiết!');
            }
        }
    </script>
}