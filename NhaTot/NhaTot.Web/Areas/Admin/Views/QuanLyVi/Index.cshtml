@model IEnumerable<NhaTot.Domain.Entities.LichSuGiaoDich>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Ví điểm & Giao dịch";
    var danhSachVi = ViewBag.DanhSachVi as List<NhaTot.Domain.Entities.ViTaiKhoan>;
    string? currentLoai = ViewBag.LoaiGiaoDich as string;
}

<!-- Header & Action -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-wallet2 text-primary me-2"></i>Quản lý Ví điểm & Giao dịch</h3>
        <p class="text-muted mb-0">Theo dõi tổng dòng tiền, nhật ký biến động số dư và điều chỉnh ví người dùng</p>
    </div>
    <button type="button" class="btn btn-primary shadow-sm" onclick="openAdjustModal()">
        <i class="bi bi-plus-circle me-1"></i> Cộng / Trừ điểm thủ công
    </button>
</div>

<!-- Cards Thống Kê Dòng Tiền -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Tổng số dư hệ thống</div>
                        <h3 class="fw-bold my-1">@string.Format("{0:N0}", ViewBag.TongSoDuHeThong)</h3>
                        <small class="text-white-50"><i class="bi bi-person-check me-1"></i>@ViewBag.TongViHoatDong ví đang hoạt động</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-cash-stack"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Tổng điểm đã nạp</div>
                        <h3 class="fw-bold my-1">@string.Format("{0:N0}", ViewBag.TongDiemNap)</h3>
                        <small class="text-white-50"><i class="bi bi-arrow-up-right me-1"></i>Giao dịch nạp điểm</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-arrow-down-left-circle"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-info text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Tổng điểm hoàn cọc</div>
                        <h3 class="fw-bold my-1">@string.Format("{0:N0}", ViewBag.TongDiemHoanCoc)</h3>
                        <small class="text-white-50"><i class="bi bi-shield-check me-1"></i>Bẫy giá mục tiêu</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-arrow-counterclockwise"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold text-uppercase">Số lượng giao dịch</div>
                        <h3 class="fw-bold my-1">@(Model?.Count() ?? 0)</h3>
                        <small class="text-white-50"><i class="bi bi-clock-history me-1"></i>Bản ghi hiển thị</small>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Card Lọc Giao Dịch -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Loại giao dịch</label>
                <select name="loaiGiaoDich" class="form-select shadow-sm">
                    <option value="ALL" selected="@(currentLoai == "ALL")">-- Tất cả loại GD --</option>
                    <option value="NAP_TIEN_QR" selected="@(currentLoai == "NAP_TIEN_QR")">Nạp tiền bằng QR</option>
                    <option value="NAP_DIEM" selected="@(currentLoai == "NAP_DIEM")">Nạp điểm thủ công</option>
                    <option value="TRU_DIEM" selected="@(currentLoai == "TRU_DIEM")">Trừ điểm / Cọc bẫy giá</option>
                    <option value="HOAN_COC" selected="@(currentLoai == "HOAN_COC")">Hoàn tiền cọc bẫy giá</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Từ ngày</label>
                <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control shadow-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">Đến ngày</label>
                <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control shadow-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Từ khóa tìm kiếm</label>
                <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control shadow-sm" placeholder="Tên, Email, SĐT, Mô tả..." />
            </div>
            <div class="col-md-2 d-flex gap-1 align-self-end">
                <button type="submit" class="btn btn-primary w-100 shadow-sm"><i class="bi bi-search me-1"></i> Lọc</button>
                <a href="/Admin/QuanLyVi" class="btn btn-outline-secondary shadow-sm" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Mã GD</th>
                        <th>Khách hàng</th>
                        <th>Loại giao dịch</th>
                        <th>Số điểm</th>
                        <th>Số dư sau GD</th>
                        <th>Nội dung mô tả</th>
                        <th>Thời gian</th>
                        <th class="text-end" style="width: 100px;">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var isPlus = item.LoaiGiaoDich == "NAP_DIEM" || item.LoaiGiaoDich == "NAP_TIEN_QR" || item.LoaiGiaoDich == "HOAN_COC" || item.LoaiGiaoDich == "HOAN_TIEN_COC";
                            <tr id="row-@item.MaGiaoDich">
                                <td><strong>#@item.MaGiaoDich</strong></td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.MaViNavigation?.MaNguoiDungNavigation?.HoTen ?? "N/A")</div>
                                    <small class="text-muted"><i class="bi bi-envelope me-1"></i>@(item.MaViNavigation?.MaNguoiDungNavigation?.Email ?? "---")</small>
                                </td>
                                <td>
                                    @switch (item.LoaiGiaoDich)
                                    {
                                        case "NAP_TIEN_QR":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-qr-code me-1"></i>Nạp tiền QR</span>
                                            break;
                                        case "NAP_DIEM":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-plus-lg me-1"></i>Nạp điểm Admin</span>
                                            break;
                                        case "HOAN_COC":
                                        case "HOAN_TIEN_COC":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-arrow-return-left me-1"></i>Hoàn cọc bẫy giá</span>
                                            break;
                                        case "TRU_DIEM":
                                        case "TAM_GIU_COC":
                                        case "TRU_COC":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-dash-lg me-1"></i>Trừ điểm (Cọc bẫy giá)</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border">@(item.LoaiGiaoDich ?? "Khác")</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold @(isPlus ? "text-success" : "text-danger")">
                                        @(isPlus ? "+" : "-")@string.Format("{0:N0} đ", item.SoDiem)
                                    </span>
                                </td>
                                <td><span class="fw-semibold text-dark">@string.Format("{0:N0} đ", item.SoDuSauGiaoDich)</span></td>
                                <td><small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@(item.MoTa ?? "---")</small></td>
                                <td><small class="text-muted">@item.NgayTao?.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info" onclick="viewDetail(@item.MaGiaoDich)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có lịch sử giao dịch phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Cộng / Trừ Điểm Thủ Công -->
<div class="modal fade" id="adjustModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary">Cộng / Trừ điểm thủ công</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn Ví khách hàng <span class="text-danger">*</span></label>
                    <select id="adjustMaVi" class="form-select shadow-sm" required>
                        <option value="">-- Chọn khách hàng --</option>
                        @if (danhSachVi != null)
                        {
                            foreach (var v in danhSachVi)
                            {
                                <option value="@v.MaVi">
                                    @(v.MaNguoiDungNavigation?.HoTen ?? "N/A") (@(v.MaNguoiDungNavigation?.Email ?? "---")) - Số dư: @string.Format("{0:N0}", v.SoDuDiem) điểm
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Thao tác <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="adjustAction" id="actionPlus" value="NAP_DIEM" checked>
                            <label class="form-check-label text-success fw-bold" for="actionPlus">
                                <i class="bi bi-plus-circle me-1"></i> Cộng điểm (Nạp)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="adjustAction" id="actionMinus" value="TRU_DIEM">
                            <label class="form-check-label text-danger fw-bold" for="actionMinus">
                                <i class="bi bi-dash-circle me-1"></i> Trừ điểm
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Số điểm điều chỉnh <span class="text-danger">*</span></label>
                    <input type="number" id="adjustSoDiem" class="form-control" placeholder="Ví dụ: 100000" min="1000" step="1000" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Lý do / Mô tả chi tiết <span class="text-danger">*</span></label>
                    <textarea id="adjustMoTa" class="form-control" rows="3" placeholder="Ví dụ: Nạp điểm khuyến mãi, Hoàn tiền khiếu nại..." required></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveAdjustBalance()">
                    <i class="bi bi-check-circle me-1"></i> Thực hiện
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Giao Dịch -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Chi tiết Giao dịch <span id="detailMaGiaoDich" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Khách hàng:</span>
                        <strong id="detailKhachHang" class="text-dark"></strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email:</span>
                        <span id="detailEmail"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Loại giao dịch:</span>
                        <span id="detailLoaiGiaoDich"></span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Số điểm biến động:</span>
                        <strong id="detailSoDiem"></strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Số dư sau giao dịch:</span>
                        <strong id="detailSoDuSau" class="text-primary"></strong>
                    </div>
                    <div class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Thời gian thực hiện:</span>
                        <span id="detailThoiGian"></span>
                    </div>
                    <div class="list-group-item px-0">
                        <span class="text-muted d-block mb-1">Mô tả / Nội dung:</span>
                        <div id="detailMoTa" class="p-2 bg-light rounded text-dark small"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const adjustModal = new bootstrap.Modal(document.getElementById('adjustModal'));
        const detailModal = new bootstrap.Modal(document.getElementById('detailModal'));

        // 1. Mở Modal Điều chỉnh điểm
        function openAdjustModal() {
            document.getElementById('adjustMaVi').value = '';
            document.getElementById('actionPlus').checked = true;
            document.getElementById('adjustSoDiem').value = '';
            document.getElementById('adjustMoTa').value = '';
            adjustModal.show();
        }

        // 2. Thực hiện Lưu Điều chỉnh điểm
        async function saveAdjustBalance() {
            const maVi = parseInt(document.getElementById('adjustMaVi').value);
            const action = document.querySelector('input[name="adjustAction"]:checked').value;
            const soDiem = parseFloat(document.getElementById('adjustSoDiem').value);
            const moTa = document.getElementById('adjustMoTa').value.trim();

            if (!maVi) {
                alert('Vui lòng chọn Ví khách hàng!');
                return;
            }

            if (!soDiem || soDiem <= 0) {
                alert('Vui lòng nhập số điểm hợp lệ lớn hơn 0!');
                return;
            }

            if (!moTa) {
                alert('Vui lòng nhập lý do điều chỉnh!');
                return;
            }

            const payload = {
                MaVi: maVi,
                LoaiGiaoDich: action,
                SoDiem: soDiem,
                MoTa: moTa
            };

            try {
                const res = await fetch('/Admin/QuanLyVi/AdjustBalance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();
                if (result.success) {
                    adjustModal.hide();
                    location.reload();
                } else {
                    alert(result.message);
                }
            } catch (e) {
                alert('Không thể kết nối đến máy chủ!');
            }
        }

        // 3. Xem Chi tiết giao dịch
        async function viewDetail(id) {
            try {
                const res = await fetch(`/Admin/QuanLyVi/GetDetail/${id}`);
                const result = await res.json();

                if (result.success) {
                    const data = result.data;
                    document.getElementById('detailMaGiaoDich').innerText = `#${data.maGiaoDich}`;
                    document.getElementById('detailKhachHang').innerText = data.tenKhachHang || 'N/A';
                    document.getElementById('detailEmail').innerText = `${data.emailKhachHang || '---'} (SĐT: ${data.sdtKhachHang || '---'})`;
                    
                    let loaiText = data.loaiGiaoDich;
                    if (data.loaiGiaoDich === 'NAP_TIEN_QR') loaiText = 'Nạp tiền bằng VietQR';
                    else if (data.loaiGiaoDich === 'NAP_DIEM') loaiText = 'Nạp điểm (Admin cộng)';
                    else if (data.loaiGiaoDich === 'TRU_DIEM' || data.loaiGiaoDich === 'TAM_GIU_COC' || data.loaiGiaoDich === 'TRU_COC') loaiText = 'Trừ điểm (Cọc bẫy giá)';
                    else if (data.loaiGiaoDich === 'HOAN_COC' || data.loaiGiaoDich === 'HOAN_TIEN_COC') loaiText = 'Hoàn cọc bẫy giá';

                    document.getElementById('detailLoaiGiaoDich').innerText = loaiText;

                    const isPlus = data.loaiGiaoDich === 'NAP_DIEM' || data.loaiGiaoDich === 'NAP_TIEN_QR' || data.loaiGiaoDich === 'HOAN_COC' || data.loaiGiaoDich === 'HOAN_TIEN_COC';
                    const sign = isPlus ? '+' : '-';
                    const colorClass = isPlus ? 'text-success' : 'text-danger';

                    const soDiemElem = document.getElementById('detailSoDiem');
                    soDiemElem.innerText = `${sign}${data.soDiem ? data.soDiem.toLocaleString('vi-VN') : 0} đ`;
                    soDiemElem.className = `fw-bold ${colorClass}`;

                    document.getElementById('detailSoDuSau').innerText = `${data.soDuSauGiaoDich ? data.soDuSauGiaoDich.toLocaleString('vi-VN') : 0} đ`;
                    document.getElementById('detailThoiGian').innerText = data.ngayTaoHienThi || (data.ngayTao ? new Date(data.ngayTao).toLocaleString('vi-VN') : '---');
                    document.getElementById('detailMoTa').innerText = data.moTa || 'Không có mô tả';

                    detailModal.show();
                } else {
                    alert(result.message);
                }
            } catch (e) {
                console.error("Lỗi khi tải chi tiết giao dịch:", e);
                alert('Có lỗi khi tải dữ liệu giao dịch!');
            }
        }
            } catch (e) {
                alert('Có lỗi khi tải dữ liệu giao dịch!');
            }
        }
    </script>
}