@model IEnumerable<NhaTot.Domain.Entities.QuanHuyen>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Quận / Huyện / Thị xã";
    var tinhThanhList = ViewBag.TinhThanhs as List<NhaTot.Domain.Entities.TinhThanh>;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Quản lý Quận / Huyện / Thị xã</h3>
        <p class="text-muted mb-0">Danh mục đơn vị hành chính cấp 2 trên hệ thống NhaTot</p>
    </div>
    <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i> Thêm Quận / Huyện mới
    </button>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã Huyện</th>
                        <th>Tên Quận / Huyện / Thị xã</th>
                        <th>Tỉnh / Thành phố</th>
                        <th>Mã hành chính</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaQuanHuyen">
                                <td><strong>#@item.MaQuanHuyen</strong></td>
                                <td><span class="fw-semibold text-dark">@item.TenQuanHuyen</span></td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle fs-6 fw-normal">
                                        <i class="bi bi-building me-1"></i>@(item.MaTinhNavigation?.TenTinh ?? "---")
                                    </span>
                                </td>
                                <td><code>@(string.IsNullOrEmpty(item.MaHanhChinh) ? "---" : item.MaHanhChinh)</code></td>
                                <td>
                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Tạm khóa</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@item.MaQuanHuyen)">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@item.MaQuanHuyen, '@item.TenQuanHuyen')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu Quận / Huyện</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Pagination", ViewBag.Pagination as NhaTot.Web.Models.PaginationViewModel)

<!-- Modal Popup Thêm / Sửa -->
<div class="modal fade" id="quanHuyenModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="quanHuyenModalTitle">Thêm Quận / Huyện</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form id="quanHuyenForm">
                    <input type="hidden" id="MaQuanHuyen" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thuộc Tỉnh / Thành phố <span class="text-danger">*</span></label>
                        <select id="MaTinh" class="form-select" required>
                            <option value="">-- Chọn Tỉnh / Thành phố --</option>
                            @if (tinhThanhList != null)
                            {
                                foreach (var t in tinhThanhList)
                                {
                                    <option value="@t.MaTinh">@t.TenTinh</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Quận / Huyện / Thị xã <span class="text-danger">*</span></label>
                        <input type="text" id="TenQuanHuyen" class="form-control" placeholder="Ví dụ: TP. Vinh, Huyện Nghi Lộc..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã hành chính</label>
                        <input type="text" id="MaHanhChinh" class="form-control" placeholder="Ví dụ: 421, 422..." />
                    </div>

                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="TrangThai" checked>
                        <label class="form-check-label fw-semibold" for="TrangThai">Kích hoạt hoạt động</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveQuanHuyen()">
                    <i class="bi bi-save me-1"></i> Lưu lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('quanHuyenModal');
        const quanHuyenModal = new bootstrap.Modal(modalElement);

        // 1. Mở Modal Thêm mới
        function openCreateModal() {
            document.getElementById('quanHuyenModalTitle').innerText = 'Thêm Quận / Huyện mới';
            document.getElementById('MaQuanHuyen').value = 0;
            document.getElementById('MaTinh').value = '';
            document.getElementById('TenQuanHuyen').value = '';
            document.getElementById('MaHanhChinh').value = '';
            document.getElementById('TrangThai').checked = true;
            quanHuyenModal.show();
        }

        // 2. Mở Modal Sửa (Lấy dữ liệu qua AJAX)
        async function openEditModal(id) {
            try {
                const response = await fetch(`/Admin/QuanHuyen/GetById/${id}`);
                const result = await response.json();

                if (result.success) {
                    const data = result.data;
                    document.getElementById('quanHuyenModalTitle').innerText = 'Chỉnh sửa Quận / Huyện';
                    document.getElementById('MaQuanHuyen').value = data.maQuanHuyen;
                    document.getElementById('MaTinh').value = data.maTinh || '';
                    document.getElementById('TenQuanHuyen').value = data.tenQuanHuyen || '';
                    document.getElementById('MaHanhChinh').value = data.maHanhChinh || '';
                    document.getElementById('TrangThai').checked = data.trangThai === true;
                    quanHuyenModal.show();
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Có lỗi xảy ra khi tải dữ liệu!');
            }
        }

        // 3. Xử lý Lưu dữ liệu (Thêm hoặc Sửa)
        async function saveQuanHuyen() {
            const maQuanHuyen = parseInt(document.getElementById('MaQuanHuyen').value);
            const maTinh = parseInt(document.getElementById('MaTinh').value);
            const tenQuanHuyen = document.getElementById('TenQuanHuyen').value.trim();
            const maHanhChinh = document.getElementById('MaHanhChinh').value.trim();
            const trangThai = document.getElementById('TrangThai').checked;

            if (!maTinh) {
                alert('Vui lòng chọn Tỉnh / Thành phố!');
                return;
            }

            if (!tenQuanHuyen) {
                alert('Vui lòng nhập tên Quận / Huyện / Thị xã!');
                return;
            }

            const payload = {
                MaQuanHuyen: maQuanHuyen,
                MaTinh: maTinh,
                TenQuanHuyen: tenQuanHuyen,
                MaHanhChinh: maHanhChinh,
                TrangThai: trangThai
            };

            try {
                const response = await fetch('/Admin/QuanHuyen/Save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    quanHuyenModal.hide();
                    location.reload(); // Tải lại trang để cập nhật danh sách
                } else {
                    alert(result.message);
                }
            } catch (error) {
                alert('Không thể kết nối đến máy chủ!');
            }
        }

        // 4. Xử lý Xóa qua AJAX
        async function confirmDelete(id, name) {
            if (confirm(`Bạn có chắc chắn muốn xóa "${name}" không?`)) {
                try {
                    const response = await fetch(`/Admin/QuanHuyen/Delete/${id}`, {
                        method: 'POST'
                    });

                    const result = await response.json();
                    if (result.success) {
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert('Lỗi khi thực hiện xóa!');
                }
            }
        }
    </script>
}