@model NhaTot.Web.Models.PaginationViewModel?
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Primitives

@if (Model == null || Model.TotalItems == 0)
{
    return;
}

@{
    string PageUrl(int targetPage)
    {
        var queryDict = new Dictionary<string, StringValues>(StringComparer.OrdinalIgnoreCase);
        foreach (var kv in Context.Request.Query)
        {
            if (!string.Equals(kv.Key, "page", StringComparison.OrdinalIgnoreCase))
            {
                queryDict[kv.Key] = kv.Value;
            }
        }
        queryDict["page"] = targetPage.ToString();

        var pairs = new List<string>();
        foreach (var kv in queryDict)
        {
            foreach (var val in kv.Value)
            {
                pairs.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(val ?? string.Empty)}");
            }
        }
        return $"{Context.Request.Path}?{string.Join("&", pairs)}";
    }

    int start = Math.Max(1, Model.CurrentPage - 2);
    int end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 px-1">
    <div class="small text-muted">
        Hiển thị <strong>@Model.StartItem–@Model.EndItem</strong> / <strong>@Model.TotalItems.ToString("N0")</strong> bản ghi
        (Trang @Model.CurrentPage / @Model.TotalPages)
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasPrevious ? PageUrl(1) : "#")" aria-label="Trang đầu">&laquo;</a>
                </li>
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasPrevious ? PageUrl(Model.CurrentPage - 1) : "#")" aria-label="Trang trước">&lsaquo;</a>
                </li>

                @if (start > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                    if (start > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }

                @for (int p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@PageUrl(p)">@p</a>
                    </li>
                }

                @if (end < Model.TotalPages)
                {
                    if (end < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasNext ? PageUrl(Model.CurrentPage + 1) : "#")" aria-label="Trang sau">&rsaquo;</a>
                </li>
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" href="@(Model.HasNext ? PageUrl(Model.TotalPages) : "#")" aria-label="Trang cuối">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
