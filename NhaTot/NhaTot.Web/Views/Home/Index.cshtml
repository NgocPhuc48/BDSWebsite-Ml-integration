@model NhaTot.Web.Models.HomeViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tìm kiếm Bất động sản Thông minh";
}

<style>
    /* Hero Search Banner Container */
    .hero-banner {
        position: relative;
        background: linear-gradient(180deg, #eef2f6 0%, #ffffff 100%);
        padding: 40px 0 60px 0;
    }
    
    /* Clean Search Card */
    .search-card-modern {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
        border: 1px solid #f1f5f9;
        padding: 24px;
    }

    /* Tabbed Switcher (Bán / Cho Thuê) */
    .nav-search-tabs .nav-link {
        font-weight: 600;
        color: #64748b;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        transition: all 0.2s;
    }
    .nav-search-tabs .nav-link.active {
        background-color: #0d6efd;
        color: #ffffff;
    }

    /* Custom Input Controls */
    .form-control-modern, .form-select-modern {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.95rem;
    }
    .form-control-modern:focus, .form-select-modern:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
    }

    /* GIS Map Style */
    #gisMapContainer {
        height: 520px;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        border: 1px solid #e2e8f0;
    }

    /* Custom Leaflet Price Tag Marker */
    .custom-price-marker {
        background: #0d6efd;
        color: white;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 5px 10px;
        border-radius: 20px;
        border: 2px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        white-space: nowrap;
        text-align: center;
    }
    .custom-price-marker:hover {
        background: #dc3545;
        transform: scale(1.1);
        z-index: 1000 !important;
    }

    /* Property Card Modern */
    .bds-card-modern {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        transition: all 0.25s ease;
        overflow: hidden;
    }
    .bds-card-modern:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.01);
    }
    .bds-card-img {
        height: 200px;
        object-fit: cover;
    }
</style>

<!-- HERO SEARCH SECTION -->
<section class="hero-banner">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-4">
            <h1 class="fw-bold text-dark display-6 mb-2">Bất Động Sản Nghệ An Thực Sự Dễ Dàng</h1>
            <p class="text-muted">Tra cứu hàng ngàn tin đăng chính chủ, bản đồ trực quan & gợi ý từ AI Định Giá</p>
        </div>

        <div class="search-card-modern">
            <form method="get" action="/" id="mainSearchForm">
                <input type="hidden" id="LoaiGiaoDichVal" name="LoaiGiaoDich" value="@(Model.Filter.LoaiGiaoDich ?? "BAN")" />

                <!-- Tabs chọn Bán / Cho thuê -->
                <ul class="nav nav-search-tabs gap-2 mb-4">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(Model.Filter.LoaiGiaoDich != "CHO_THUE" ? "active" : "")" onclick="setTransactionType('BAN', this)">
                            <i class="bi bi-house-door me-2"></i>Mua Bán
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(Model.Filter.LoaiGiaoDich == "CHO_THUE" ? "active" : "")" onclick="setTransactionType('CHO_THUE', this)">
                            <i class="bi bi-key me-2"></i>Cho Thuê
                        </button>
                    </li>
                </ul>

                <!-- Hàng 1: Từ khóa & Loại BĐS -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-7">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-3"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="TuKhoa" value="@Model.Filter.TuKhoa" class="form-control form-control-modern border-start-0 ps-0" placeholder="Nhập tên đường, Phường/Xã, dự án (Ví dụ: Nguyễn Văn Cừ, Hưng Dũng...)" />
                        </div>
                    </div>
                    <div class="col-12 col-md-5">
                        <select name="MaLoaiBds" class="form-select form-select-modern">
                            <option value="">-- Tất cả loại hình BĐS --</option>
                            @foreach (var item in Model.DanhSachLoaiBds)
                            {
                                <option value="@item.MaLoaiBds" selected="@(Model.Filter.MaLoaiBds == item.MaLoaiBds)">@item.TenLoaiBds</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Hàng 2: Địa chính tinh gọn (Tỉnh/Thành -> Phường/Xã) -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <select id="ddlTinhThanh" name="MaTinh" class="form-select form-select-modern">
                            <option value="">-- Tỉnh / Thành phố --</option>
                            @foreach (var t in Model.DanhSachTinhThanh)
                            {
                                <option value="@t.MaTinh" selected="@(Model.Filter.MaTinh == t.MaTinh)">@t.TenTinh</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <select id="ddlPhuongXa" name="MaPhuongXa" class="form-select form-select-modern">
                            <option value="">-- Phường / Xã --</option>
                        </select>
                    </div>
                </div>

                <!-- Hàng 3: Khoảng Giá, Diện tích & Nút Tìm kiếm -->
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <input type="number" name="GiaTu" value="@Model.Filter.GiaTu" class="form-control form-control-modern" placeholder="Giá từ (VNĐ)" />
                            <span class="input-group-text bg-light border-0">-</span>
                            <input type="number" name="GiaDen" value="@Model.Filter.GiaDen" class="form-control form-control-modern" placeholder="Đến (VNĐ)" />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <input type="number" name="DienTichTu" value="@Model.Filter.DienTichTu" class="form-control form-control-modern" placeholder="Diện tích từ (m²)" />
                            <span class="input-group-text bg-light border-0">-</span>
                            <input type="number" name="DienTichDen" value="@Model.Filter.DienTichDen" class="form-control form-control-modern" placeholder="Đến (m²)" />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-funnel me-2"></i>Tìm Kiếm BĐS
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- GIS INTERACTIVE MAP SECTION -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1"><i class="bi bi-geo-alt text-primary me-2"></i>Khám Phá Theo Bản Đồ GIS</h3>
                <p class="text-muted mb-0 small">Kéo thả hoặc phóng to bản đồ để cập nhật vị trí & mức giá BĐS theo khu vực</p>
            </div>
            <button class="btn btn-outline-secondary btn-sm rounded-pill" onclick="resetMapLocation()">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Về vị trí TP Vinh
            </button>
        </div>

        <div id="gisMapContainer"></div>
    </div>
</section>

<!-- FEATURED LISTINGS GRID -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1"><i class="bi bi-houses text-danger me-2"></i>Danh Sách Tin Rao Mới Nhất</h3>
                <p class="text-muted mb-0 small">Tin đăng đã qua phê duyệt minh bạch thông tin</p>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2 rounded-pill">
                @Model.TinMoiNhat.Count kết quả
            </span>
        </div>

        <div class="row g-4">
            @if (Model.TinMoiNhat.Any())
            {
                var defaultImg = "https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=600&q=80";

                foreach (var item in Model.TinMoiNhat)
                {
                    // Lấy ảnh đầu tiên (img[0]) từ DanhSachAnhDatDai (hỗ trợ cả JSON mảng và chuỗi ngăn cách bởi , ; | \n)
                    string anhDaiDien = defaultImg;
                    string rawAnh = item.AnhDaiDien ?? item.HinhAnh ?? "";

                    if (!string.IsNullOrWhiteSpace(rawAnh))
                    {
                        rawAnh = rawAnh.Trim();
                        if (rawAnh.StartsWith("[") && rawAnh.EndsWith("]"))
                        {
                            try
                            {
                                var jsonArr = System.Text.Json.JsonSerializer.Deserialize<List<string>>(rawAnh);
                                if (jsonArr != null && jsonArr.Count > 0 && !string.IsNullOrWhiteSpace(jsonArr[0]))
                                {
                                    anhDaiDien = jsonArr[0].Trim();
                                }
                            }
                            catch
                            {
                                // Fallback nếu parse JSON lỗi
                                var parts = rawAnh.Trim('[', ']', '"', '\'').Split(new[] { "\",\"", "','", ",", ";", "|" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                if (parts.Length > 0 && !string.IsNullOrWhiteSpace(parts[0]))
                                {
                                    anhDaiDien = parts[0].Trim('"', '\'', ' ');
                                }
                            }
                        }
                        else
                        {
                            var parts = rawAnh.Split(new[] { ',', ';', '|', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                            if (parts.Length > 0 && !string.IsNullOrWhiteSpace(parts[0]))
                            {
                                anhDaiDien = parts[0].Trim();
                            }
                        }
                    }

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 bds-card-modern">
                            <div class="position-relative">
                                <img src="@anhDaiDien" 
                                     class="card-img-top bds-card-img" 
                                     alt="@item.TieuDe"
                                     onerror="this.onerror=null; this.src='@defaultImg';">
                                <span class="position-absolute top-0 start-0 m-3 badge @(item.LoaiGiaoDich == "BAN" ? "bg-danger" : "bg-success")">
                                    @(item.LoaiGiaoDich == "BAN" ? "BÁN" : "CHO THUÊ")
                                </span>
                                <button class="btn btn-white btn-sm rounded-circle position-absolute top-0 end-0 m-3 shadow-sm border-0" onclick="toggleFavorite(@item.MaTin)">
                                    <i class="bi bi-heart text-danger"></i>
                                </button>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <span class="small fw-semibold text-primary mb-1">@item.TenLoaiBds</span>
                                <h6 class="fw-bold text-dark text-truncate-2 mb-2" style="height: 42px;" title="@item.TieuDe">
                                    @item.TieuDe
                                </h6>

                                <div class="d-flex align-items-baseline justify-content-between my-2">
                                    <span class="fw-bold text-danger fs-5">
                                        @(item.GiaRaoVnd.HasValue ? (item.GiaRaoVnd.Value >= 1000000000 ? $"{item.GiaRaoVnd.Value / 1000000000:0.##} tỷ" : $"{item.GiaRaoVnd.Value / 1000000:0.##} triệu") : "Thỏa thuận")
                                    </span>
                                    <span class="small text-muted fw-semibold"><i class="bi bi-arrows-angle me-1"></i>@item.DienTichDat m²</span>
                                </div>

                                <small class="text-muted text-truncate mb-3"><i class="bi bi-geo-alt me-1 text-secondary"></i>@item.DiaChiHienThi</small>

                                <a href="/TinDang/ChiTiet/@item.MaTin" class="btn btn-outline-primary btn-sm rounded-3 mt-auto w-100 fw-semibold">
                                    Xem thông tin chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 py-5 text-center text-muted">
                    <i class="bi bi-building-exclamation fs-1 d-block mb-3"></i>
                    <h5>Chưa tìm thấy Bất động sản nào!</h5>
                    <p class="small">Hãy thử thay đổi bộ lọc khoảng giá hoặc chọn khu vực khác.</p>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // 1. Chuyển đổi loại giao dịch Tab Mua bán / Cho thuê
        function setTransactionType(type, btn) {
            document.getElementById('LoaiGiaoDichVal').value = type;
            document.querySelectorAll('.nav-search-tabs .nav-link').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        // 2. Cascading Dropdown Địa chính (Tỉnh -> Phường/Xã trực tiếp)
        const selectedTinh = "@Model.Filter.MaTinh";
        const selectedPhuong = "@Model.Filter.MaPhuongXa";

        document.getElementById('ddlTinhThanh').addEventListener('change', function () { loadPhuongXa(this.value); });

        async function loadPhuongXa(maTinh, selectedId = null) {
            const ddl = document.getElementById('ddlPhuongXa');
            ddl.innerHTML = '<option value="">-- Phường / Xã --</option>';
            if (!maTinh) return;

            try {
                const res = await fetch(`/Home/GetPhuongXa?maTinh=${maTinh}`);
                const data = await res.json();
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.maPhuongXa;
                    opt.textContent = p.tenPhuongXa;
                    if (selectedId && selectedId == p.maPhuongXa) opt.selected = true;
                    ddl.appendChild(opt);
                });
            } catch (err) {
                console.error("Lỗi tải phường xã:", err);
            }
        }

        if (selectedTinh) {
            loadPhuongXa(selectedTinh, selectedPhuong);
        }

        // 3. Leaflet GIS Map với Tile CartoDB Positron (Nền xám trắng cực sạch)
        const defaultLat = 18.6738;
        const defaultLng = 105.6925;

        const map = L.map('gisMapContainer', { zoomControl: false }).setView([defaultLat, defaultLng], 13);
        L.control.zoom({ position: 'bottomright' }).addTo(map);

        // Tile CartoDB Positron giúp bản đồ load nhanh, đẹp chuẩn SaaS
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Tiles © Esri'
        }).addTo(map);

        let markerGroup = L.layerGroup().addTo(map);

        function resetMapLocation() {
            map.setView([defaultLat, defaultLng], 13);
        }

        // Tải Markers với custom nhãn giá theo bộ lọc đang tìm kiếm
        async function fetchMapMarkers() {
            const bounds = map.getBounds();
            
            // Đọc các giá trị lọc từ Form tìm kiếm
            const form = document.getElementById('mainSearchForm');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            params.append('minLat', bounds.getSouth());
            params.append('maxLat', bounds.getNorth());
            params.append('minLng', bounds.getWest());
            params.append('maxLng', bounds.getEast());

            for (const [key, value] of formData.entries()) {
                if (value && value.trim() !== '') {
                    params.append(key, value.trim());
                }
            }

            try {
                const res = await fetch(`/Home/GetMapLocations?${params.toString()}`);
                const pins = await res.json();

                markerGroup.clearLayers();

                if (pins.length > 0) {
                    const boundsList = [];
                    pins.forEach(p => {
                        const priceFormatted = p.giaRaoVnd 
                            ? (p.giaRaoVnd >= 1000000000 ? (p.giaRaoVnd / 1000000000).toFixed(1) + ' tỷ' : (p.giaRaoVnd / 1000000).toFixed(0) + ' tr')
                            : 'Thỏa thuận';

                        // Custom DivIcon hiển thị trực tiếp nhãn giá
                        const customIcon = L.divIcon({
                            className: 'custom-price-marker-wrapper',
                            html: `<div class="custom-price-marker">${priceFormatted}</div>`,
                            iconSize: [60, 30],
                            iconAnchor: [30, 15]
                        });

                        // Đảm bảo tọa độ là số float hợp lệ chuẩn Quốc tế
                        const lat = parseFloat(p.viDo);
                        const lng = parseFloat(p.kinhDo);
                        if (isNaN(lat) || isNaN(lng)) return;

                        const marker = L.marker([lat, lng], { icon: customIcon });
                        boundsList.push([lat, lng]);

                        const popupHtml = `
                            <div style="width: 220px; font-family: 'Inter', sans-serif;">
                                <h6 class="fw-bold mb-1 text-dark">${p.tieuDe}</h6>
                                <div class="text-danger fw-bold mb-1">${priceFormatted} ${p.dienTichDat ? '- ' + p.dienTichDat + 'm²' : ''}</div>
                                <small class="text-muted d-block mb-2">${p.diaChi || ''}</small>
                                <a href="/TinDang/ChiTiet/${p.maTin}" class="btn btn-sm btn-primary w-100 text-white fw-bold">Xem Chi Tiết</a>
                            </div>
                        `;
                        marker.bindPopup(popupHtml);
                        markerGroup.addLayer(marker);
                    });

                    // Nếu có ghim và đang tải ban đầu, tự căn chỉnh khung nhìn bản đồ bao trọn các ghim
                    if (boundsList.length > 0 && map.getZoom() === 13) {
                        try {
                            const b = L.latLngBounds(boundsList);
                            if (b.isValid()) {
                                map.fitBounds(b, { padding: [40, 40], maxZoom: 14 });
                            }
                        } catch (e) { }
                    }
                }
            } catch (err) {
                console.error("Lỗi tải ghim bản đồ:", err);
            }
        }

        map.on('moveend', fetchMapMarkers);
        fetchMapMarkers();

        async function toggleFavorite(maTin) {
            const res = await fetch('/Home/ToggleYeuThich', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `maTin=${maTin}`
            });
            const data = await res.json();
            alert(data.message);
        }
    </script>
}