@model NhaTot.Web.Models.DinhGiaInputModel
@using NhaTot.Domain.Entities
@{
    ViewData["Title"] = "Định giá AI & Dự báo xu hướng giá BĐS";
    var activeModel = ViewBag.ActiveModel as PhienBanMoHinh;
    var activeEval = ViewBag.ActiveEval as KetQuaDanhGiaMoHinh;
}

<style>
    .dinhgia-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 65%, #0ea5e9 100%);
        color: #ffffff;
    }
    .model-status-strip {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    .dinhgia-card {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        box-shadow: 0 20px 35px -12px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }
    .dinhgia-section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1rem;
    }
    .dinhgia-input {
        border-radius: 12px;
        border-color: #cbd5e1;
        padding: 0.65rem 0.9rem;
    }
    .dinhgia-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }
    .result-kpi-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .result-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    }
    .result-kpi-primary {
        border-color: #fecaca;
        background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
    }
</style>

<div class="container my-4 my-lg-5">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card dinhgia-card bg-white">
                <!-- Header Banner -->
                <div class="dinhgia-hero py-4 px-4 px-md-5 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 small fw-semibold mb-2">
                            <i class="bi bi-cpu-fill text-info"></i> PropTech AI Valuation · Nghệ An & Hà Tĩnh
                        </div>
                        <h3 class="m-0 fw-bold">Định giá Bất động sản AI & Dự báo 6 tháng</h3>
                        <p class="mb-0 text-white-50 small mt-1">
                            Ước tính giá rao theo mô hình học máy huấn luyện trên dữ liệu thực tế đã làm sạch
                        </p>
                    </div>
                    <div class="text-md-end">
                        @if (activeModel != null)
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill fs-6 shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> @activeModel.TenMoHinh · Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-6 shadow-sm">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Chế độ so sánh dữ liệu
                            </span>
                        }
                    </div>
                </div>

                <!-- Live Model Status Strip -->
                <div class="model-status-strip px-4 px-md-5 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                    @if (activeModel != null)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-3 text-secondary">
                            <span><strong class="text-dark">Phiên bản:</strong> <code>@activeModel.PhienBan</code></span>
                            <span><strong class="text-dark">Mẫu huấn luyện:</strong> @(activeModel.SoMauHuanLuyen?.ToString("N0") ?? "—") mẫu</span>
                            @if (activeEval != null)
                            {
                                <span><strong class="text-dark">R² kiểm tra:</strong> @activeEval.R2?.ToString("0.000")</span>
                                <span><strong class="text-dark">MAE:</strong> @((activeEval.Mae ?? 0).ToString("N0")) đ</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Chưa có mô hình ML đang kích hoạt. Hệ thống sẽ tham khảo tin bán tương đồng trong phường/xã.</span>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Admin/MlOps" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold">
                            <i class="bi bi-sliders me-1"></i>Quản lý MLOps
                        </a>
                    }
                </div>

                <div class="card-body p-4 p-md-5">
                    <form id="formDinhGia">
                        @Html.AntiForgeryToken()

                        <!-- 1. THÔNG TIN ĐỊNH GIÁ CỐT LÕI -->
                        <div class="dinhgia-section-title">
                            <span class="badge bg-primary rounded-circle" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                            Vị trí, loại hình & diện tích (bắt buộc cho mô hình AI)
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Loại bất động sản <span class="text-danger">*</span></label>
                                <select id="MaLoaiBds" class="form-select dinhgia-input" required>
                                    <option value="">-- Chọn loại BĐS --</option>
                                    @if (ViewBag.DanhSachLoaiBds != null)
                                    {
                                        foreach (var loai in ViewBag.DanhSachLoaiBds)
                                        {
                                            <option value="@loai.MaLoaiBds">@loai.TenLoaiBds</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Diện tích (m²) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" step="0.1" min="1" max="100000" id="DienTichDat" class="form-control dinhgia-input" value="100" placeholder="Ví dụ: 100" required />
                                    <span class="input-group-text bg-light rounded-end-3">m²</span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select id="ddlTinhThanh" class="form-select dinhgia-input" required>
                                    <option value="">-- Chọn Tỉnh/Thành --</option>
                                    @if (ViewBag.DanhSachTinhThanh != null)
                                    {
                                        foreach (var t in ViewBag.DanhSachTinhThanh)
                                        {
                                            <option value="@t.MaTinh" selected="@(t.MaTinh == 1)">@t.TenTinh</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Quận / Huyện / Thị xã</label>
                                <select id="ddlQuanHuyen" class="form-select dinhgia-input">
                                    <option value="">-- Chọn Quận/Huyện --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Phường / Xã <span class="text-danger">*</span></label>
                                <select id="ddlPhuongXa" class="form-select dinhgia-input" required>
                                    <option value="">-- Chọn Phường/Xã --</option>
                                </select>
                            </div>
                        </div>

                        <!-- 2. THÔNG TIN THAM KHẢO THÊM -->
                        <div class="dinhgia-section-title mt-4">
                            <span class="badge bg-secondary rounded-circle" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                            Thông số kỹ thuật bổ sung <span class="text-muted fw-normal small">(tùy chọn, dùng lưu hồ sơ định giá)</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-3 col-6">
                                <label class="form-label small fw-semibold text-muted">Mặt tiền (m)</label>
                                <input type="number" step="0.1" id="ChieuRongMatTien" class="form-control dinhgia-input" placeholder="VD: 5.5" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small fw-semibold text-muted">Đường vào (m)</label>
                                <input type="number" step="0.1" id="DuongVaoRong" class="form-control dinhgia-input" placeholder="VD: 6.0" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small fw-semibold text-muted">Hướng</label>
                                <select id="Huong" class="form-select dinhgia-input">
                                    <option value="">-- Chọn hướng --</option>
                                    <option value="Đông">Đông</option>
                                    <option value="Tây">Tây</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Bắc">Bắc</option>
                                    <option value="Đông Nam" selected>Đông Nam</option>
                                    <option value="Đông Bắc">Đông Bắc</option>
                                    <option value="Tây Nam">Tây Nam</option>
                                    <option value="Tây Bắc">Tây Bắc</option>
                                </select>
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small fw-semibold text-muted">Pháp lý</label>
                                <select id="PhapLy" class="form-select dinhgia-input">
                                    <option value="Sổ đỏ / Sổ hồng chính chủ" selected>Sổ đỏ / Sổ hồng</option>
                                    <option value="Đang chờ cấp sổ">Đang chờ cấp sổ</option>
                                    <option value="Giấy tờ viết tay / Hợp đồng">Viết tay / Hợp đồng</option>
                                </select>
                            </div>
                        </div>

                        <!-- 3. CÁC TRƯỜNG RIÊNG CỦA NHÀ Ở -->
                        <div id="sectionDacTinhNha" class="mb-4">
                            <div class="row g-3 p-3 bg-light rounded-4 border" id="containerDacTinhNha">
                                <div class="col-12 pb-1">
                                    <span class="fw-semibold text-primary small"><i class="bi bi-house-door me-1"></i>Đặc tính công trình nhà ở / căn hộ (tự ẩn khi chọn Đất nền)</span>
                                </div>
                                <div class="col-md-2 col-4">
                                    <label class="form-label small fw-semibold">Số tầng</label>
                                    <input type="number" id="SoTang" class="form-control dinhgia-input" min="1" value="2" />
                                </div>
                                <div class="col-md-2 col-4">
                                    <label class="form-label small fw-semibold">Phòng ngủ</label>
                                    <input type="number" id="SoPhongNgu" class="form-control dinhgia-input" min="1" value="3" />
                                </div>
                                <div class="col-md-2 col-4">
                                    <label class="form-label small fw-semibold">Phòng WC</label>
                                    <input type="number" id="SoWc" class="form-control dinhgia-input" min="1" value="2" />
                                </div>
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-semibold">Tình trạng nhà</label>
                                    <input type="text" id="TinhTrangNha" class="form-control dinhgia-input" placeholder="Mới xây, còn mới..." />
                                </div>
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-semibold">Nội thất</label>
                                    <input type="text" id="NoiThat" class="form-control dinhgia-input" placeholder="Đầy đủ, cơ bản..." />
                                </div>
                            </div>
                        </div>

                        <button type="button" id="btnTinhGia" onclick="thucHienDinhGia()" class="btn btn-primary w-100 py-3 fw-bold rounded-pill shadow-sm fs-5">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Định giá AI & Dự báo 6 tháng tới
                        </button>
                    </form>

                    <!-- KẾT QUẢ ĐỊNH GIÁ -->
                    <div id="valuationMessage" class="alert alert-info mt-4 d-none rounded-3" role="status"></div>

                    <div id="ketQuaBox" class="mt-4 p-4 border rounded-4 bg-light d-none">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-3 border-bottom">
                            <div>
                                <h4 class="text-dark fw-bold mb-1">
                                    <i class="bi bi-award-fill text-warning me-2"></i>Kết quả định giá tham khảo
                                </h4>
                                <small class="text-muted">Tính theo mô hình và dữ liệu đã kiểm duyệt tại thời điểm hiện tại</small>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span id="badgeDoTinCay" class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold d-none">
                                    Độ phù hợp test: <strong id="txtConfidencePct">—</strong>
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fw-semibold">
                                    <i class="bi bi-cpu me-1"></i>Nguồn: <strong id="txtDoTinCai">—</strong>
                                </span>
                            </div>
                        </div>

                        <!-- 3 Thẻ số liệu chính -->
                        <div class="row g-3 mb-4 text-center">
                            <div class="col-md-4">
                                <div class="card h-100 result-kpi-card result-kpi-primary p-3">
                                    <small class="text-muted fw-semibold">Giá trị dự đoán (AI)</small>
                                    <h2 id="txtGiaDuDoanShort" class="text-danger fw-bold mt-2 mb-1">—</h2>
                                    <div id="txtGiaDuDoan" class="small text-secondary fw-semibold mb-2">0 đ</div>
                                    <span class="badge bg-white text-dark border rounded-pill mx-auto px-3 py-1">
                                        Đơn giá: <strong id="txtDonGiaM2" class="text-primary">0 đ/m²</strong>
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 result-kpi-card p-3 justify-content-center">
                                    <small class="text-muted fw-semibold">Khoảng giá thấp (Biên dưới)</small>
                                    <h3 id="txtGiaMinShort" class="text-primary fw-bold mt-2 mb-1">—</h3>
                                    <div id="txtGiaMin" class="small text-muted">0 đ</div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100 result-kpi-card p-3 justify-content-center">
                                    <small class="text-muted fw-semibold">Khoảng giá cao (Biên trên)</small>
                                    <h3 id="txtGiaMaxShort" class="text-primary fw-bold mt-2 mb-1">—</h3>
                                    <div id="txtGiaMax" class="small text-muted">0 đ</div>
                                </div>
                            </div>
                        </div>

                        <!-- BIỂU ĐỒ + BẢNG DỰ BÁO 6 THÁNG -->
                        <div id="forecastBox" class="card border rounded-4 p-4 bg-white mt-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-graph-up-arrow text-danger me-2"></i>Dự báo xu hướng giá 6 tháng tới
                                </h5>
                                <span class="badge bg-light text-muted border">Ngoại suy xu hướng từ RidgeLogPrice-v1</span>
                            </div>
                            <div style="position: relative; height: 300px; width: 100%;" class="mb-4">
                                <canvas id="chartDuBao"></canvas>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" id="tblDuBao6Thang">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Mốc thời gian</th>
                                            <th class="text-end">Giá dự báo</th>
                                            <th class="text-end">Khoảng Min – Max</th>
                                            <th class="text-end">Biến động vs hiện tại</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ddlLoaiBds = document.getElementById('MaLoaiBds');
        const sectionDacTinhNha = document.getElementById('sectionDacTinhNha');

        function toggleDacTinhNha() {
            const selectedText = ddlLoaiBds.options[ddlLoaiBds.selectedIndex]?.text?.toLowerCase() || '';
            const isDat = selectedText.includes('đất') || selectedText.includes('dat');
            sectionDacTinhNha.classList.toggle('d-none', isDat);
        }

        if (ddlLoaiBds) {
            if (ddlLoaiBds.options.length > 1 && !ddlLoaiBds.value) {
                ddlLoaiBds.selectedIndex = 1;
            }
            ddlLoaiBds.addEventListener('change', toggleDacTinhNha);
            toggleDacTinhNha();
        }

        const ddlTinh = document.getElementById('ddlTinhThanh');
        const ddlQuan = document.getElementById('ddlQuanHuyen');
        const ddlPhuong = document.getElementById('ddlPhuongXa');

        async function loadQuanHuyen(maTinh) {
            ddlQuan.innerHTML = '<option value="">-- Đang tải... --</option>';
            ddlPhuong.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            if (!maTinh) {
                ddlQuan.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                return;
            }
            try {
                const res = await fetch(`/Home/GetQuanHuyen?maTinh=${maTinh}`);
                const data = await res.json();
                ddlQuan.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                data.forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = q.maQuanHuyen;
                    opt.textContent = q.tenQuanHuyen;
                    ddlQuan.appendChild(opt);
                });
                if (data.length > 0) {
                    ddlQuan.selectedIndex = 1;
                    await loadPhuongXa(ddlQuan.value);
                }
            } catch (e) {
                ddlQuan.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            }
        }

        async function loadPhuongXa(maQuanHuyen) {
            ddlPhuong.innerHTML = '<option value="">-- Đang tải... --</option>';
            if (!maQuanHuyen) {
                ddlPhuong.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                return;
            }
            try {
                const res = await fetch(`/Home/GetPhuongXa?maQuanHuyen=${maQuanHuyen}`);
                const data = await res.json();
                ddlPhuong.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.maPhuongXa;
                    opt.textContent = p.tenPhuongXa;
                    ddlPhuong.appendChild(opt);
                });
                if (data.length > 0) {
                    ddlPhuong.selectedIndex = 1;
                }
            } catch (e) {
                ddlPhuong.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            }
        }

        if (ddlTinh) {
            ddlTinh.addEventListener('change', function () {
                loadQuanHuyen(this.value);
            });
            if (ddlTinh.value) {
                loadQuanHuyen(ddlTinh.value);
            }
        }

        if (ddlQuan) {
            ddlQuan.addEventListener('change', function () {
                loadPhuongXa(this.value);
            });
        }

        function formatShortVnd(v) {
            if (!v || v <= 0) return '0 đ';
            if (v >= 1_000_000_000) return (v / 1_000_000_000).toLocaleString('vi-VN', { maximumFractionDigits: 2 }) + ' tỷ';
            if (v >= 1_000_000) return (v / 1_000_000).toLocaleString('vi-VN', { maximumFractionDigits: 1 }) + ' triệu';
            return Math.round(v).toLocaleString('vi-VN') + ' đ';
        }

        let duBaoChartInstance = null;

        document.getElementById('formDinhGia')?.addEventListener('submit', function (e) {
            e.preventDefault();
            thucHienDinhGia();
        });

        async function thucHienDinhGia() {
            const btn = document.getElementById('btnTinhGia');
            const maLoaiBds = parseInt(document.getElementById('MaLoaiBds').value);
            const maPhuongXa = parseInt(document.getElementById('ddlPhuongXa').value);
            const dienTich = parseFloat(document.getElementById('DienTichDat').value);
            const isDat = sectionDacTinhNha.classList.contains('d-none');

            if (!maLoaiBds) { alert('Vui lòng chọn loại bất động sản.'); return; }
            if (!maPhuongXa) { alert('Vui lòng chọn Phường/Xã.'); return; }
            if (!dienTich || dienTich <= 0) { alert('Vui lòng nhập diện tích lớn hơn 0.'); return; }

            const payload = {
                maLoaiBds: maLoaiBds,
                maPhuongXa: maPhuongXa,
                dienTich: dienTich,
                chieuRongMatTien: parseFloat(document.getElementById('ChieuRongMatTien').value) || null,
                duongVaoRong: parseFloat(document.getElementById('DuongVaoRong').value) || null,
                huong: document.getElementById('Huong').value || null,
                phapLy: document.getElementById('PhapLy').value || null,
                soTang: isDat ? null : (parseInt(document.getElementById('SoTang')?.value) || null),
                soPhongNgu: isDat ? null : (parseInt(document.getElementById('SoPhongNgu')?.value) || null),
                soWc: isDat ? null : (parseInt(document.getElementById('SoWc')?.value) || null),
                tinhTrangNha: isDat ? null : (document.getElementById('TinhTrangNha')?.value || null),
                noiThat: isDat ? null : (document.getElementById('NoiThat')?.value || null)
            };

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang chạy mô hình AI phân tích...';

            try {
                const res = await fetch('/DinhGia/TinhGia', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                const msgEl = document.getElementById('valuationMessage');
                const ketQuaBox = document.getElementById('ketQuaBox');
                ketQuaBox.classList.add('d-none');

                if (!res.ok) {
                    msgEl.textContent = `Máy chủ trả về lỗi HTTP ${res.status}. Vui lòng tải lại trang và thử lại.`;
                    msgEl.className = 'alert alert-danger mt-4 rounded-3';
                    return;
                }

                const data = await res.json();

                msgEl.textContent = data.message || '';
                msgEl.className = 'alert mt-4 rounded-3 ' + (data.success ? 'alert-info' : 'alert-warning');

                if (!data.success) return;

                ketQuaBox.classList.remove('d-none');
                document.getElementById('txtGiaDuDoanShort').innerText = formatShortVnd(data.giaDuDoanVnd);
                document.getElementById('txtGiaDuDoan').innerText = (data.giaDuDoanVnd || 0).toLocaleString('vi-VN') + ' đ';
                document.getElementById('txtGiaMinShort').innerText = formatShortVnd(data.giaThapNhatVnd);
                document.getElementById('txtGiaMin').innerText = (data.giaThapNhatVnd || 0).toLocaleString('vi-VN') + ' đ';
                document.getElementById('txtGiaMaxShort').innerText = formatShortVnd(data.giaCaoNhatVnd);
                document.getElementById('txtGiaMax').innerText = (data.giaCaoNhatVnd || 0).toLocaleString('vi-VN') + ' đ';
                document.getElementById('txtDonGiaM2').innerText = (data.donGiaTrenM2Vnd || 0).toLocaleString('vi-VN') + ' đ/m²';
                document.getElementById('txtDoTinCai').innerText = data.tenMoHinh || 'Chưa có mô hình';

                const badgeConf = document.getElementById('badgeDoTinCay');
                if (data.doTinCayPhanTram != null) {
                    document.getElementById('txtConfidencePct').innerText = data.doTinCayPhanTram + '%';
                    badgeConf.classList.remove('d-none');
                } else {
                    badgeConf.classList.add('d-none');
                }

                const hasForecast = Array.isArray(data.danhSachDuBao6Thang) && data.danhSachDuBao6Thang.length > 0;
                document.getElementById('forecastBox').classList.toggle('d-none', !hasForecast);
                if (hasForecast) {
                    veBieuDoDuBao(data.giaDuDoanVnd, data.danhSachDuBao6Thang, data.giaThapNhatVnd, data.giaCaoNhatVnd);
                    renderForecastTable(data.danhSachDuBao6Thang);
                }

                ketQuaBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch (e) {
                alert('Lỗi kết nối máy chủ khi định giá.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-lightning-charge-fill me-1"></i> Định giá AI & Dự báo 6 tháng tới';
            }
        }

        function renderForecastTable(list) {
            const tbody = document.querySelector('#tblDuBao6Thang tbody');
            tbody.innerHTML = '';
            list.forEach(item => {
                const pct = Number(item.phanTramTangTruong || 0);
                const sign = pct > 0 ? '+' : '';
                const pctClass = pct > 0 ? 'text-success' : (pct < 0 ? 'text-danger' : 'text-muted');
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="fw-semibold">${item.nhanThang}</td>
                    <td class="text-end fw-bold text-danger">${formatShortVnd(item.giaDuBaoVnd)}</td>
                    <td class="text-end small text-muted">${formatShortVnd(item.giaMinVnd)} – ${formatShortVnd(item.giaMaxVnd)}</td>
                    <td class="text-end fw-semibold ${pctClass}">${sign}${pct.toFixed(2)}%</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function veBieuDoDuBao(giaHienTai, danhSachDuBao, giaMin, giaMax) {
            const ctx = document.getElementById('chartDuBao').getContext('2d');
            const labels = ['Hiện tại'];
            const dataPrices = [giaHienTai / 1000000];
            const dataMin = [giaMin / 1000000];
            const dataMax = [giaMax / 1000000];

            danhSachDuBao.forEach(item => {
                labels.push(item.nhanThang);
                dataPrices.push(item.giaDuBaoVnd / 1000000);
                dataMin.push(item.giaMinVnd / 1000000);
                dataMax.push(item.giaMaxVnd / 1000000);
            });

            if (duBaoChartInstance) {
                duBaoChartInstance.destroy();
            }

            duBaoChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Giá dự báo AI (Triệu VNĐ)',
                            data: dataPrices,
                            borderColor: '#dc3545',
                            backgroundColor: 'rgba(220, 53, 69, 0.1)',
                            borderWidth: 3,
                            pointBackgroundColor: '#dc3545',
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Biên độ Max (Triệu VNĐ)',
                            data: dataMax,
                            borderColor: '#0d6efd',
                            borderWidth: 1.5,
                            borderDash: [5, 5],
                            pointRadius: 3,
                            fill: false,
                            tension: 0.3
                        },
                        {
                            label: 'Biên độ Min (Triệu VNĐ)',
                            data: dataMin,
                            borderColor: '#198754',
                            borderWidth: 1.5,
                            borderDash: [5, 5],
                            pointRadius: 3,
                            fill: false,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { font: { family: 'Inter', size: 12, weight: 'bold' } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label + ': ' + context.parsed.y.toLocaleString('vi-VN', { maximumFractionDigits: 1 }) + ' triệu VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            title: { display: true, text: 'Giá trị (Triệu VNĐ)', font: { weight: 'bold' } },
                            ticks: { callback: v => v.toLocaleString('vi-VN') + ' tr' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    </script>
}
