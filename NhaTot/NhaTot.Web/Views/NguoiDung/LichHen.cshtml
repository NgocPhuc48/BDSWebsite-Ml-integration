@model IEnumerable<NhaTot.Domain.Entities.LichHen>
@{
    ViewData["Title"] = "Lịch hẹn của tôi - Xem nhà";
    long currentUserId = ViewBag.CurrentUserId ?? 0;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-calendar-check text-primary me-2"></i>Lịch hẹn của tôi
            </h3>
            <p class="text-muted small mb-0">Theo dõi các cuộc hẹn xem nhà bạn đã đăng ký với chuyên viên tư vấn và chủ nhà.</p>
        </div>
        <a href="/" class="btn btn-outline-primary fw-semibold rounded-pill px-4 shadow-sm">
            <i class="bi bi-search me-1"></i>Tìm thêm BĐS
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold text-dark">Chưa có lịch hẹn nào</h5>
            <p class="text-muted">Khi bạn bấm nút "Hẹn xem nhà" tại trang chi tiết tin đăng, các cuộc hẹn sẽ hiển thị đầy đủ tại đây.</p>
            <div>
                <a href="/" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-house me-1"></i>Khám phá tin đăng
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">Danh sách cuộc hẹn (@Model.Count())</h6>
                <span class="small text-muted">Cập nhật theo thời gian thực</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Mã LH</th>
                            <th scope="col">Bất động sản</th>
                            <th scope="col">Thời gian hẹn</th>
                            <th scope="col">Địa điểm gặp</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ghi chú</th>
                            <th scope="col" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lh in Model)
                        {
                            bool laNguoiDat = (lh.MaNguoiTao == currentUserId);
                            bool coTheHuy = (lh.TrangThai == "CHO_XAC_NHAN" || lh.TrangThai == "DA_XAC_NHAN" || lh.TrangThai == "SAP_DIEN_RA" || lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED");
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@lh.MaLichHen</td>
                                <td>
                                    @if (lh.MaTin.HasValue)
                                    {
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 260px;">
                                            <a href="/TinDang/ChiTiet/@lh.MaTin" target="_blank" class="text-decoration-none text-dark hover-primary">
                                                @(lh.MaTinNavigation?.TieuDe ?? "BĐS #" + lh.MaTin)
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">Gặp tư vấn trực tiếp</div>
                                    }
                                    <small class="text-muted d-block text-truncate" style="max-width: 260px;">
                                        @(lh.MaTinNavigation?.MaBdsNavigation?.DiaChiMoTa ?? "")
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">
                                        <i class="bi bi-clock me-1"></i>
                                        @(lh.ThoiGianHen?.ToString("HH:mm - dd/MM/yyyy") ?? "--")
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-dark fw-semibold">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(lh.DiaDiem) ? "Tại BĐS" : lh.DiaDiem)
                                    </span>
                                </td>
                                <td>
                                    @if (lh.TrangThai == "DA_XAC_NHAN")
                                    {
                                        <span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-check-circle me-1"></i>Đã xác nhận</span>
                                    }
                                    else if (lh.TrangThai == "DA_XEM_NHA" || lh.TrangThai == "COMPLETED")
                                    {
                                        <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check2-all me-1"></i>Đã xem nhà</span>
                                    }
                                    else if (lh.TrangThai == "DA_HUY" || lh.TrangThai == "CANCELLED" || lh.TrangThai == "HUY")
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                    }
                                    else if (lh.TrangThai == "SAP_DIEN_RA" || lh.TrangThai == "SCHEDULED" || lh.TrangThai == "CONFIRMED")
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Sắp diễn ra</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-bell-fill me-1"></i>Chờ xác nhận</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-secondary fst-italic">@(string.IsNullOrWhiteSpace(lh.GhiChu) ? "—" : lh.GhiChu)</small>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        @if (lh.MaTin.HasValue)
                                        {
                                            <a href="/TinDang/ChiTiet/@lh.MaTin" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Xem chi tiết tin">
                                                <i class="bi bi-eye"></i> Xem tin
                                            </a>
                                        }

                                        @if (coTheHuy)
                                        {
                                            <form method="post" action="/NguoiDung/HuyLichHen" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn xem nhà này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maLichHen" value="@lh.MaLichHen" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Hủy lịch hẹn này">
                                                    <i class="bi bi-x-circle me-1"></i>Hủy lịch
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

