@model IEnumerable<NhaTot.Domain.Entities.LichHen>
@{
    ViewData["Title"] = "Quản lý Lịch hẹn xem nhà";
    long currentUserId = ViewBag.CurrentUserId ?? 0;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Quản lý Lịch hẹn xem nhà</h3>
            <p class="text-muted small mb-0">Theo dõi các lịch hẹn xem bất động sản bạn đã đặt hoặc khách hẹn xem tin của bạn</p>
        </div>
        <a href="/" class="btn btn-outline-primary fw-semibold rounded-pill px-4">
            <i class="bi bi-search me-1"></i>Tìm thêm BĐS
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
            <h5>Chưa có lịch hẹn nào</h5>
            <p class="text-muted">Khi bạn đặt lịch hẹn xem tại trang chi tiết tin đăng, thông tin sẽ được cập nhật tại đây.</p>
            <div>
                <a href="/" class="btn btn-primary rounded-pill px-4">Khám phá tin đăng</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Mã LH</th>
                            <th scope="col">Bất động sản</th>
                            <th scope="col">Thời gian hẹn</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col">Ghi chú</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col" class="text-end pe-4">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lh in Model)
                        {
                            bool laNguoiDat = (lh.MaNguoiTao == currentUserId);
                            <tr>
                                <td class="ps-4 fw-semibold">#@lh.MaLichHen</td>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 300px;">
                                        @(lh.MaTinNavigation?.TieuDe ?? "Tin đăng #" + lh.MaTin)
                                    </div>
                                    <small class="text-muted">
                                        @(lh.MaTinNavigation?.MaBdsNavigation?.DiaChiMoTa ?? "")
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @(lh.ThoiGianHen?.ToString("dd/MM/yyyy HH:mm") ?? "--")
                                    </span>
                                </td>
                                <td>
                                    @if (laNguoiDat)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Người đi xem</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Chủ nhà / Môi giới</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(lh.GhiChu) ? "—" : lh.GhiChu)</td>
                                <td>
                                    @if (lh.TrangThai == "DA_XAC_NHAN")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Đã xác nhận</span>
                                    }
                                    else if (lh.TrangThai == "HUY")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Chờ xác nhận</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="/TinDang/ChiTiet/@lh.MaTin" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        Xem tin
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

