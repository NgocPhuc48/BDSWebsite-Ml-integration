@model NhaTot.Domain.Entities.ViTaiKhoan
@{
    ViewData["Title"] = "Ví tài khoản";
    var lichSu = ViewBag.LichSu as List<NhaTot.Domain.Entities.LichSuGiaoDich> ?? new List<NhaTot.Domain.Entities.LichSuGiaoDich>();
}

<div class="container py-4">
    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white h-100 position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-white-50 small text-uppercase fw-semibold">Số dư ví của bạn</span>
                    <i class="bi bi-wallet2 fs-3 text-warning"></i>
                </div>
                <h2 class="display-6 fw-bold mb-3" id="lblSoDuVi">@((Model.SoDuDiem ?? 0).ToString("N0")) đ</h2>
                <div class="mt-auto d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-semibold">Trạng thái: @Model.TrangThai</span>
                    <button type="button" class="btn btn-warning text-dark fw-bold rounded-pill px-3 py-2 ms-auto shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNapTienQr">
                        <i class="bi bi-qr-code-scan me-1"></i>Nạp tiền bằng QR
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Quyền lợi điểm thưởng & số dư ví</h5>
                    <a href="/BayGia" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Đến trang Bẫy Giá
                    </a>
                </div>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2 d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Sử dụng điểm để <strong>kích hoạt Bẫy Giá</strong> (10 điểm / lần tạo mục tiêu) tự động theo dõi và bắt đáy BĐS.
                    </li>
                    <li class="mb-2 d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Sử dụng số dư để đẩy tin VIP, nổi bật bất động sản tăng tốc độ tiếp cận khách mua.
                    </li>
                    <li class="mb-2 d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Nhận thưởng điểm khi có khách hàng tương tác hoặc giao dịch thành công.
                    </li>
                    <li class="d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Được chuyên viên tư vấn ưu tiên hỗ trợ trong hệ thống.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0">Lịch sử giao dịch ví</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Mã GD</th>
                        <th scope="col">Loại giao dịch</th>
                        <th scope="col">Số điểm</th>
                        <th scope="col">Số dư sau GD</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col" class="text-end pe-4">Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!lichSu.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có phát sinh giao dịch nào</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var gd in lichSu)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">#@gd.MaGiaoDich</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@gd.LoaiGiaoDich</span>
                                </td>
                                <td class="fw-bold text-success">+@((gd.SoDiem ?? 0).ToString("N0"))</td>
                                <td>@((gd.SoDuSauGiaoDich ?? 0).ToString("N0"))</td>
                                <td>@(gd.MoTa ?? "")</td>
                                <td class="text-end pe-4 text-muted small">@(gd.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "--")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nạp Tiền Bằng Mã QR & Lưu CSDL (Phục vụ Test Bẫy Giá) -->
<div class="modal fade" id="modalNapTienQr" tabindex="-1" aria-labelledby="modalNapTienQrLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="modalNapTienQrLabel">
                    <i class="bi bi-qr-code me-2"></i>Nạp tiền vào ví qua mã VietQR
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Nhập số tiền nạp để tự động sinh mã VietQR chuyển khoản, đồng thời bấm nút <strong>"Xác nhận đã chuyển tiền (Lưu CSDL)"</strong> để cộng ngay số dư phục vụ kiểm thử tính năng <strong>Bẫy Giá</strong>.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Số tiền muốn nạp (VNĐ hoặc Điểm) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="number" id="txtSoTienNap" class="form-control form-control-lg fw-bold text-success" 
                               value="50000" min="1000" step="1000" placeholder="Ví dụ: 50000" oninput="capNhatMaQr()" />
                        <span class="input-group-text fw-bold">VNĐ</span>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="chonNhanhTien(20000)">20.000đ</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="chonNhanhTien(50000)">50.000đ</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="chonNhanhTien(100000)">100.000đ</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="chonNhanhTien(200000)">200.000đ</button>
                    </div>
                </div>

                <!-- Khung hiển thị mã QR VietQR -->
                <div class="text-center p-3 bg-light rounded-4 border my-3">
                    <div class="d-inline-block p-2 bg-white rounded-3 shadow-sm mb-2">
                        <img id="imgVietQr" 
                             src="https://img.vietqr.io/image/MB-0382375128-compact2.png?amount=50000&addInfo=NAPVI%20@Model.MaVi&accountName=NHA%20TOT%20SYSTEM" 
                             alt="VietQR Code" 
                             class="img-fluid" 
                             style="max-width: 240px; height: auto;" />
                    </div>
                    <div class="small text-muted">
                        <div><strong>Ngân hàng:</strong> MBBank (Quân Đội)</div>
                        <div><strong>Số tài khoản:</strong> <code>0382375128</code></div>
                        <div><strong>Chủ tài khoản:</strong> NHA TOT SYSTEM</div>
                        <div><strong>Nội dung:</strong> <span class="badge bg-secondary" id="txtNoiDungChuyenKhoan">NAPVI @Model.MaVi</span></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted">Ghi chú giao dịch (Tùy chọn)</label>
                    <input type="text" id="txtGhiChuNap" class="form-control form-control-sm" placeholder="Ví dụ: Nạp tiền test tính năng Bẫy Giá..." />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnXacNhanNap" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" onclick="xacNhanNapTien()">
                    <i class="bi bi-check2-circle me-1"></i>Xác nhận đã chuyển tiền (Lưu CSDL)
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const maVi = @Model.MaVi;

        function chonNhanhTien(val) {
            document.getElementById('txtSoTienNap').value = val;
            capNhatMaQr();
        }

        function capNhatMaQr() {
            let amount = parseFloat(document.getElementById('txtSoTienNap').value) || 0;
            if (amount < 0) amount = 0;
            const noiDung = `NAPVI ${maVi}`;
            const qrUrl = `https://img.vietqr.io/image/MB-0382375128-compact2.png?amount=${amount}&addInfo=${encodeURIComponent(noiDung)}&accountName=NHA%20TOT%20SYSTEM`;
            document.getElementById('imgVietQr').src = qrUrl;
        }

        async function xacNhanNapTien() {
            const amountInput = document.getElementById('txtSoTienNap');
            const soTien = parseFloat(amountInput.value);
            if (isNaN(soTien) || soTien <= 0) {
                alert('Vui lòng nhập số tiền nạp hợp lệ lớn hơn 0!');
                amountInput.focus();
                return;
            }

            const ghiChu = document.getElementById('txtGhiChuNap').value;
            const btn = document.getElementById('btnXacNhanNap');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý lưu CSDL...';

            try {
                const response = await fetch('/NguoiDung/NapTienTest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        soDiem: soTien,
                        ghiChu: ghiChu
                    })
                });

                const res = await response.json();
                if (res.success) {
                    alert(res.message);
                    location.reload();
                } else {
                    alert(res.message || 'Lỗi khi nạp ví!');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Xác nhận đã chuyển tiền (Lưu CSDL)';
                }
            } catch (err) {
                console.error('Lỗi khi gọi API nạp tiền:', err);
                alert('Có lỗi xảy ra khi kết nối máy chủ!');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Xác nhận đã chuyển tiền (Lưu CSDL)';
            }
        }
    </script>
}

