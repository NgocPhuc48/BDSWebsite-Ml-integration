@model NhaTot.Domain.Entities.ViTaiKhoan
@{
    ViewData["Title"] = "Ví tài khoản";
    var lichSu = ViewBag.LichSu as List<NhaTot.Domain.Entities.LichSuGiaoDich> ?? new List<NhaTot.Domain.Entities.LichSuGiaoDich>();
}

<div class="container py-4">
    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-primary text-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-white-50 small text-uppercase fw-semibold">Số dư ví của bạn</span>
                    <i class="bi bi-wallet2 fs-3 text-warning"></i>
                </div>
                <h2 class="display-6 fw-bold mb-3">@((Model.SoDuDiem ?? 0).ToString("N0")) đ</h2>
                <div class="mt-auto d-flex gap-2">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-semibold">Trạng thái: @Model.TrangThai</span>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-3">Quyền lợi điểm thưởng & số dư ví</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2 d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Sử dụng số dư để đẩy tin VIP, nổi bật bất động sản.
                    </li>
                    <li class="mb-2 d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Nhận thưởng điểm khi có khách hàng tương tác hoặc giao dịch thành công.
                    </li>
                    <li class="d-flex align-items-center text-muted">
                        <i class="bi bi-check-circle-fill text-success me-2"></i> Được chuyên viên tư vấn ưu tiên hỗ trợ trong hệ thống.
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0">Lịch sử giao dịch ví</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Mã GD</th>
                        <th scope="col">Loại giao dịch</th>
                        <th scope="col">Số điểm</th>
                        <th scope="col">Số dư sau GD</th>
                        <th scope="col">Mô tả</th>
                        <th scope="col" class="text-end pe-4">Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!lichSu.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có phát sinh giao dịch nào</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var gd in lichSu)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">#@gd.MaGiaoDich</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@gd.LoaiGiaoDich</span>
                                </td>
                                <td class="fw-bold text-success">+@((gd.SoDiem ?? 0).ToString("N0"))</td>
                                <td>@((gd.SoDuSauGiaoDich ?? 0).ToString("N0"))</td>
                                <td>@(gd.MoTa ?? "")</td>
                                <td class="text-end pe-4 text-muted small">@(gd.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "--")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

