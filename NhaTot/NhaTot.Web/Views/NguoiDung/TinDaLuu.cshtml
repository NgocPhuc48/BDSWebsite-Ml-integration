@model IEnumerable<NhaTot.Domain.Entities.YeuThich>
@{
    ViewData["Title"] = "Tin đã lưu";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold mb-1">Tin bất động sản đã lưu</h3>
        <p class="text-muted small mb-0">Danh sách các bất động sản bạn quan tâm và lưu lại để theo dõi</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-heart fs-1 text-muted mb-3"></i>
            <h5>Chưa có tin nào được lưu</h5>
            <p class="text-muted">Khi bạn tìm thấy bất động sản ưng ý, hãy nhấn vào biểu tượng trái tim để lưu lại tại đây.</p>
            <div>
                <a href="/" class="btn btn-outline-primary rounded-pill px-4">Khám phá bất động sản</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold">
                                <a href="/TinDang/ChiTiet/@item.MaTin" class="text-decoration-none text-dark">
                                    @(item.MaTinNavigation?.TieuDe ?? "Bất động sản")
                                </a>
                            </h6>
                            <div class="text-danger fw-bold fs-5 mb-2">
                                @((item.MaTinNavigation?.GiaRaoVnd ?? 0).ToString("N0")) đ
                            </div>
                            <div class="text-muted small mb-3">
                                <i class="bi bi-geo-alt me-1"></i>@(item.MaTinNavigation?.MaBdsNavigation?.DiaChiMoTa ?? "")
                            </div>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Đã lưu: @(item.NgayLuu?.ToString("dd/MM/yyyy") ?? "--")</span>
                                <a href="/TinDang/ChiTiet/@item.MaTin" class="btn btn-sm btn-primary rounded-pill px-3">Xem ngay</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
