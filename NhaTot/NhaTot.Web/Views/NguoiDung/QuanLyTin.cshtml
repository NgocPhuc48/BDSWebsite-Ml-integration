@model IEnumerable<NhaTot.Domain.Entities.TinDang>
@{
    ViewData["Title"] = "Quản lý tin đăng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Quản lý tin đăng của bạn</h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái, lượt xem và thông tin các bất động sản đã đăng</p>
        </div>
        <a href="/TinDang/DangTin" class="btn btn-primary fw-semibold rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i>Đăng tin mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
            <h5>Bạn chưa đăng tin nào</h5>
            <p class="text-muted">Hãy bắt đầu tiếp cận khách hàng tiềm năng bằng cách đăng tin bất động sản ngay!</p>
            <div>
                <a href="/TinDang/DangTin" class="btn btn-primary rounded-pill px-4">Đăng tin ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Tiêu đề</th>
                            <th scope="col">Loại BĐS</th>
                            <th scope="col">Giá</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ngày đăng</th>
                            <th scope="col" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-truncate" style="max-width: 350px;">
                                        @item.TieuDe
                                    </div>
                                    <small class="text-muted">
                                        @(item.MaBdsNavigation?.DiaChiMoTa ?? "")
                                    </small>
                                </td>
                                <td>@(item.MaBdsNavigation?.MaLoaiBdsNavigation?.TenLoaiBds ?? "BĐS")</td>
                                <td class="fw-bold text-danger">
                                    @((item.GiaRaoVnd ?? 0).ToString("N0")) đ
                                </td>
                                <td>
                                    @if (item.TrangThai == "APPROVED")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Đã duyệt</span>
                                    }
                                    else if (item.TrangThai == "REJECTED")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Bị từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Chờ duyệt</span>
                                    }
                                </td>
                                <td>@(item.NgayDang?.ToString("dd/MM/yyyy") ?? "--")</td>
                                <td class="text-end pe-4">
                                    <a href="/TinDang/ChiTiet/@item.MaTin" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
