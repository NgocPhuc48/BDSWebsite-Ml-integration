@model NhaTot.Web.Models.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold text-center text-primary mb-4">Đăng nhập</h3>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-action="DangNhap" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="EmailHoacSdt" class="form-label fw-bold">Email hoặc Số điện thoại</label>
                            <input asp-for="EmailHoacSdt" class="form-control" placeholder="Email hoặc SĐT" />
                            <span asp-validation-for="EmailHoacSdt" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-bold">Mật khẩu</label>
                            <input asp-for="MatKhau" type="password" class="form-control" placeholder="******" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="GhiNhoDangNhap" class="form-check-input" />
                            <label asp-for="GhiNhoDangNhap" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Đăng nhập</button>
                    </form>

                    <div class="text-center mt-3">
                        <small>Chưa có tài khoản? <a asp-action="DangKy" class="text-decoration-none">Đăng ký mới</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}