@model NhaTot.Web.Models.DangTinViewModel
@{
    ViewData["Title"] = "Đăng tin Bất động sản mới";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h4 class="m-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Đăng tin Bất động sản mới</h4>
                    <span class="badge bg-light text-primary fw-semibold px-3 py-2">
                        <i class="bi bi-shield-check me-1"></i>Đăng tin miễn phí
                    </span>
                </div>
                <div class="card-body p-4 bg-white">
                    <form asp-action="DangTin" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- 1. THÔNG TIN TIN ĐĂNG -->
                        <h5 class="fw-bold text-primary mb-3">
                            <i class="bi bi-info-circle me-1"></i> 1. Thông tin cơ bản tin đăng
                        </h5>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="TieuDe" class="form-label fw-bold">Tiêu đề tin đăng <span class="text-danger">*</span></label>
                                <input asp-for="TieuDe" class="form-control" placeholder="Ví dụ: Bán nhà 3 tầng mặt đường Nguyễn Văn Cừ, TP Vinh" />
                                <span asp-validation-for="TieuDe" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="MaLoaiBds" class="form-label fw-bold">Loại BĐS <span class="text-danger">*</span></label>
                                <select asp-for="MaLoaiBds" id="ddlLoaiBds" class="form-select" required>
                                    <option value="">-- Chọn loại BĐS --</option>
                                    @if (ViewBag.DanhSachLoaiBds != null)
                                    {
                                        foreach (var loai in ViewBag.DanhSachLoaiBds)
                                        {
                                            <option value="@loai.MaLoaiBds">@loai.TenLoaiBds</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="MaLoaiBds" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="LoaiGiaoDich" class="form-label fw-bold">Hình thức giao dịch <span class="text-danger">*</span></label>
                                <select asp-for="LoaiGiaoDich" class="form-select">
                                    <option value="BAN">Cần bán</option>
                                    <option value="CHO_THUE">Cho thuê</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="GiaRaoVnd" class="form-label fw-bold">Giá rao (VNĐ) <span class="text-danger">*</span></label>
                                <input asp-for="GiaRaoVnd" type="number" class="form-control" placeholder="Ví dụ: 2500000000" />
                                <span asp-validation-for="GiaRaoVnd" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="MoTa" class="form-label fw-bold">Nội dung mô tả chi tiết <span class="text-danger">*</span></label>
                                <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Mô tả chi tiết về vị trí, tiện ích xung quanh, phong thủy..."></textarea>
                                <span asp-validation-for="MoTa" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 2. THUỘC TÍNH CHUNG CỦA BẤT ĐỘNG SẢN (BatDongSan) -->
                        <h5 class="fw-bold text-primary mb-3">
                            <i class="bi bi-building me-1"></i> 2. Thuộc tính & Vị trí Bất động sản
                        </h5>
                        <div class="row g-3 mb-4">
                            <!-- Tỉnh / Thành -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select id="ddlTinhThanh" name="MaTinh" class="form-select" required>
                                    <option value="">-- Chọn Tỉnh/Thành --</option>
                                    @if (ViewBag.DanhSachTinhThanh != null)
                                    {
                                        foreach (var t in ViewBag.DanhSachTinhThanh)
                                        {
                                            <option value="@t.MaTinh" selected="@(Model.MaTinh == t.MaTinh || t.MaTinh == 1)">@t.TenTinh</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Quận / Huyện -->
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Quận / Huyện</label>
                                <select id="ddlQuanHuyen" name="MaQuanHuyen" class="form-select">
                                    <option value="">-- Chọn Quận/Huyện --</option>
                                </select>
                            </div>

                            <!-- Phường / Xã -->
                            <div class="col-md-4">
                                <label asp-for="MaPhuongXa" class="form-label fw-bold">Phường / Xã <span class="text-danger">*</span></label>
                                <select asp-for="MaPhuongXa" id="ddlPhuongXa" class="form-select" required>
                                    <option value="">-- Chọn Phường/Xã --</option>
                                </select>
                                <span asp-validation-for="MaPhuongXa" class="text-danger"></span>
                            </div>

                            <!-- Tên dự án -->
                            <div class="col-md-6">
                                <label asp-for="TenDuAn" class="form-label fw-bold">Tên dự án / Khu đô thị (Nếu có)</label>
                                <input asp-for="TenDuAn" class="form-control" placeholder="Ví dụ: KĐT Tecco, Vinhomes Quang Trung..." />
                            </div>

                            <!-- Địa chỉ mô tả -->
                            <div class="col-md-6">
                                <label asp-for="DiaChiMoTa" class="form-label fw-bold">Địa chỉ chi tiết (Số nhà, tên đường)</label>
                                <input asp-for="DiaChiMoTa" class="form-control" placeholder="Ví dụ: Số 12, Ngõ 45, Đường Lê Duẩn" />
                            </div>

                            <!-- Diện tích đất -->
                            <div class="col-md-3">
                                <label asp-for="DienTichDatM2" class="form-label fw-bold">Diện tích đất (m²) <span class="text-danger">*</span></label>
                                <input asp-for="DienTichDatM2" step="0.1" type="number" class="form-control" placeholder="Ví dụ: 100" />
                                <span asp-validation-for="DienTichDatM2" class="text-danger"></span>
                            </div>

                            <!-- Diện tích sử dụng -->
                            <div class="col-md-3">
                                <label asp-for="DienTichSuDungM2" class="form-label fw-bold">Diện tích sử dụng (m²)</label>
                                <input asp-for="DienTichSuDungM2" step="0.1" type="number" class="form-control" placeholder="Ví dụ: 250" />
                            </div>

                            <!-- Hướng -->
                            <div class="col-md-3">
                                <label asp-for="Huong" class="form-label fw-bold">Hướng BĐS</label>
                                <select asp-for="Huong" class="form-select">
                                    <option value="">-- Chọn hướng --</option>
                                    <option value="Đông">Đông</option>
                                    <option value="Tây">Tây</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Bắc">Bắc</option>
                                    <option value="Đông Nam">Đông Nam</option>
                                    <option value="Đông Bắc">Đông Bắc</option>
                                    <option value="Tây Nam">Tây Nam</option>
                                    <option value="Tây Bắc">Tây Bắc</option>
                                </select>
                            </div>

                            <!-- Pháp lý -->
                            <div class="col-md-3">
                                <label asp-for="PhapLy" class="form-label fw-bold">Pháp lý</label>
                                <select asp-for="PhapLy" class="form-select">
                                    <option value="Sổ đỏ / Sổ hồng chính chủ">Sổ đỏ / Sổ hồng chính chủ</option>
                                    <option value="Đang chờ cấp sổ">Đang chờ cấp sổ</option>
                                    <option value="Hợp đồng mua bán">Hợp đồng mua bán</option>
                                    <option value="Giấy tờ viết tay">Giấy tờ viết tay</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="MoTaDacDiem" class="form-label fw-bold">Mô tả đặc điểm nổi bật BĐS</label>
                                <input asp-for="MoTaDacDiem" class="form-control" placeholder="Ví dụ: Lô góc 2 mặt tiền thoáng mát, kinh doanh thuận tiện..." />
                            </div>

                            <!-- Tọa độ bản đồ GIS -->
                            <div class="col-12 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-bold mb-0">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Tọa độ bản đồ GIS
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnAutoLocate">
                                        <i class="bi bi-crosshair me-1"></i> Tự định vị vị trí hiện tại
                                    </button>
                                </div>
                                <div id="locateAlert" class="alert alert-warning py-1 px-3 small d-none mb-2"></div>
                                <div class="alert alert-light border py-2 px-3 small text-muted mb-2">
                                    <i class="bi bi-info-circle me-1"></i> Bạn có thể click trực tiếp trên bản đồ hoặc kéo ghim để chọn tọa độ chính xác cho bất động sản.
                                </div>
                                <div id="mapPicker" style="height: 320px; border-radius: 8px; border: 1px solid #dee2e6;" class="mb-3"></div>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light">Vĩ độ (Latitude)</span>
                                            <input asp-for="ViDo" id="inpViDo" class="form-control" placeholder="Ví dụ: 18.6738" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-light">Kinh độ (Longitude)</span>
                                            <input asp-for="KinhDo" id="inpKinhDo" class="form-control" placeholder="Ví dụ: 105.6925" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. CHI TIẾT RIÊNG CHO ĐẤT (ChiTietDat) -->
                        <div id="sectionChiTietDat" class="mb-4">
                            <h5 class="fw-bold text-success mb-3">
                                <i class="bi bi-bounding-box-circles me-1"></i> 3. Chi tiết đặc tính Đất nền / Đất thổ cư (ChiTietDat)
                            </h5>
                            <div class="row g-3 p-3 bg-light rounded-3 border">
                                <div class="col-md-4">
                                    <label asp-for="LoaiDat" class="form-label fw-semibold">Loại đất</label>
                                    <input asp-for="LoaiDat" class="form-control" placeholder="Ví dụ: Đất thổ cư, Đất nông nghiệp, Đất vườn..." />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="MatTienM" class="form-label fw-semibold">Mặt tiền (m)</label>
                                    <input asp-for="MatTienM" step="0.1" type="number" class="form-control" placeholder="Ví dụ: 6.5" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ChieuSauM" class="form-label fw-semibold">Chiều sâu (m)</label>
                                    <input asp-for="ChieuSauM" step="0.1" type="number" class="form-control" placeholder="Ví dụ: 18.0" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="LoaiDuong" class="form-label fw-semibold">Loại đường vào</label>
                                    <input asp-for="LoaiDuong" class="form-control" placeholder="Ví dụ: Đường nhựa, Đường bê tông, Đường rải đá..." />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="DoRongDuongM" class="form-label fw-semibold">Độ rộng đường vào (m)</label>
                                    <input asp-for="DoRongDuongM" step="0.1" type="number" class="form-control" placeholder="Ví dụ: 7.0" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="HinhDang" class="form-label fw-semibold">Hình dáng thửa đất</label>
                                    <input asp-for="HinhDang" class="form-control" placeholder="Ví dụ: Vuông vắn, Nở hậu, Thóp hậu..." />
                                </div>
                            </div>
                        </div>

                        <!-- 4. CHI TIẾT RIÊNG CHO NHÀ Ở (ChiTietNha) -->
                        <div id="sectionChiTietNha" class="mb-4">
                            <h5 class="fw-bold text-primary mb-3">
                                <i class="bi bi-house-door me-1"></i> 4. Chi tiết đặc tính Nhà ở / Căn hộ (ChiTietNha)
                            </h5>
                            <div class="row g-3 p-3 bg-light rounded-3 border">
                                <div class="col-md-4">
                                    <label asp-for="SoTang" class="form-label fw-semibold">Số tầng</label>
                                    <input asp-for="SoTang" type="number" class="form-control" min="1" placeholder="Ví dụ: 3" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="SoPhongNgu" class="form-label fw-semibold">Số phòng ngủ</label>
                                    <input asp-for="SoPhongNgu" type="number" class="form-control" min="0" placeholder="Ví dụ: 4" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="SoWc" class="form-label fw-semibold">Số WC/Phòng tắm</label>
                                    <input asp-for="SoWc" type="number" class="form-control" min="0" placeholder="Ví dụ: 3" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NamXayDung" class="form-label fw-semibold">Năm xây dựng</label>
                                    <input asp-for="NamXayDung" type="number" class="form-control" min="1950" max="2030" placeholder="Ví dụ: 2022" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="TinhTrangNha" class="form-label fw-semibold">Tình trạng nhà</label>
                                    <input asp-for="TinhTrangNha" class="form-control" placeholder="Nhà mới xây, Đã qua sử dụng, Đang sửa chữa..." />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NoiThat" class="form-label fw-semibold">Tình trạng nội thất</label>
                                    <input asp-for="NoiThat" class="form-control" placeholder="Đầy đủ nội thất cao cấp, Cơ bản, Bàn giao thô..." />
                                </div>
                            </div>
                        </div>

                        <!-- 5. HÌNH ẢNH BẤT ĐỘNG SẢN & SỔ ĐỎ / SỔ HỒNG -->
                        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-images me-1"></i> 5. Hình ảnh bất động sản & Pháp lý</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ảnh chụp bất động sản / thực tế</label>
                                <input asp-for="HinhAnhFiles" type="file" multiple class="form-control" accept="image/*" onchange="previewImages(event, 'previewContainer')" />
                                <div id="previewContainer" class="d-flex gap-2 mt-3 flex-wrap"></div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Ảnh Sổ đỏ / Sổ hồng (Pháp lý)</label>
                                <input asp-for="AnhSoDoFiles" type="file" multiple class="form-control" accept="image/*" onchange="previewImages(event, 'previewContainerSoDo')" />
                                <div id="previewContainerSoDo" class="d-flex gap-2 mt-3 flex-wrap"></div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/" class="btn btn-secondary px-4 rounded-pill">Hủy bỏ</a>
                            <button type="submit" class="btn btn-success px-5 fw-bold rounded-pill shadow-sm">
                                <i class="bi bi-cloud-upload me-1"></i> Đăng tin ngay
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // 1. Tự động ẩn/hiện nhóm ChiTietDat hoặc ChiTietNha theo Loại BĐS
        const ddlLoaiBds = document.getElementById('ddlLoaiBds');
        const secChiTietDat = document.getElementById('sectionChiTietDat');
        const secChiTietNha = document.getElementById('sectionChiTietNha');

        function updateFormSections() {
            const selectedText = ddlLoaiBds.options[ddlLoaiBds.selectedIndex]?.text?.toLowerCase() || '';
            const isDat = selectedText.includes('đất') || selectedText.includes('dat');

            if (isDat) {
                // Nếu là Đất: Hiện mục ChiTietDat, Ẩn hoàn toàn mục ChiTietNha
                secChiTietDat.classList.remove('d-none');
                secChiTietNha.classList.add('d-none');
            } else {
                // Nếu là Nhà ở / Căn hộ / v.v.: Hiện mục ChiTietNha, và vẫn giữ mục ChiTietDat (vì nhà phố vẫn có đất, mặt tiền, đường vào)
                secChiTietDat.classList.remove('d-none');
                secChiTietNha.classList.remove('d-none');
            }
        }

        if (ddlLoaiBds) {
            ddlLoaiBds.addEventListener('change', updateFormSections);
            updateFormSections();
        }

        // 2. Cascade Tỉnh/Thành -> Quận/Huyện -> Phường/Xã
        const ddlTinh = document.getElementById('ddlTinhThanh');
        const ddlQuan = document.getElementById('ddlQuanHuyen');
        const ddlPhuong = document.getElementById('ddlPhuongXa');

        async function loadQuanHuyen(maTinh, selectedQuanId) {
            ddlQuan.innerHTML = '<option value="">-- Đang tải... --</option>';
            ddlPhuong.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            if (!maTinh) {
                ddlQuan.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                return;
            }
            try {
                const res = await fetch(`/Home/GetQuanHuyen?maTinh=${maTinh}`);
                const data = await res.json();
                ddlQuan.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                data.forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = q.maQuanHuyen;
                    opt.textContent = q.tenQuanHuyen;
                    if (selectedQuanId && selectedQuanId == q.maQuanHuyen) opt.selected = true;
                    ddlQuan.appendChild(opt);
                });
                if (data.length > 0 && !selectedQuanId) {
                    ddlQuan.selectedIndex = 1;
                    loadPhuongXa(ddlQuan.value);
                } else if (selectedQuanId) {
                    loadPhuongXa(selectedQuanId, '@Model.MaPhuongXa');
                }
            } catch (e) {
                ddlQuan.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            }
        }

        async function loadPhuongXa(maQuanHuyen, selectedPhuongId) {
            ddlPhuong.innerHTML = '<option value="">-- Đang tải... --</option>';
            if (!maQuanHuyen) {
                ddlPhuong.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                return;
            }
            try {
                const res = await fetch(`/Home/GetPhuongXa?maQuanHuyen=${maQuanHuyen}`);
                const data = await res.json();
                ddlPhuong.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.maPhuongXa;
                    opt.textContent = p.tenPhuongXa;
                    if (selectedPhuongId && selectedPhuongId == p.maPhuongXa) opt.selected = true;
                    ddlPhuong.appendChild(opt);
                });
            } catch (e) {
                ddlPhuong.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            }
        }

        if (ddlTinh) {
            ddlTinh.addEventListener('change', function () {
                loadQuanHuyen(this.value);
            });
            if (ddlTinh.value) {
                loadQuanHuyen(ddlTinh.value, '@Model.MaQuanHuyen');
            }
        }

        if (ddlQuan) {
            ddlQuan.addEventListener('change', function () {
                loadPhuongXa(this.value);
            });
        }

        // 3. Preview ảnh upload
        function previewImages(event, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = '';
            const files = event.target.files;

            if (files) {
                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'img-thumbnail rounded shadow-sm';
                        img.style.width = '120px';
                        img.style.height = '90px';
                        img.style.objectFit = 'cover';
                        container.appendChild(img);
                    }
                    reader.readAsDataURL(file);
                });
            }
        }

        // 4. Bản đồ GIS & Tự định vị
        const defaultLat = parseFloat('@(Model.ViDo.HasValue ? Model.ViDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "18.6738")') || 18.6738;
        const defaultLng = parseFloat('@(Model.KinhDo.HasValue ? Model.KinhDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "105.6925")') || 105.6925;

        const map = L.map('mapPicker').setView([defaultLat, defaultLng], 13);
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 19,
            attribution: 'Tiles © Esri'
        }).addTo(map);

        const marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

        function updateCoordinates(lat, lng) {
            document.getElementById('inpViDo').value = Number(lat).toFixed(7);
            document.getElementById('inpKinhDo').value = Number(lng).toFixed(7);
        }

        if (!document.getElementById('inpViDo').value) {
            updateCoordinates(defaultLat, defaultLng);
        }

        marker.on('dragend', function (e) {
            const position = marker.getLatLng();
            updateCoordinates(position.lat, position.lng);
        });

        map.on('click', function (e) {
            marker.setLatLng(e.latlng);
            updateCoordinates(e.latlng.lat, e.latlng.lng);
        });

        ['inpViDo', 'inpKinhDo'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', function () {
                const latStr = document.getElementById('inpViDo').value.trim().replace(',', '.');
                const lngStr = document.getElementById('inpKinhDo').value.trim().replace(',', '.');
                const lat = parseFloat(latStr);
                const lng = parseFloat(lngStr);
                if (!isNaN(lat) && !isNaN(lng)) {
                    marker.setLatLng([lat, lng]);
                    map.panTo([lat, lng]);
                }
            });
        });

        const btnLocate = document.getElementById('btnAutoLocate');
        const locateAlert = document.getElementById('locateAlert');

        function showLocateMessage(msg, isError = false) {
            if (!locateAlert) return;
            locateAlert.className = isError ? 'alert alert-danger py-1 px-3 small mb-2' : 'alert alert-success py-1 px-3 small mb-2';
            locateAlert.innerHTML = msg;
            locateAlert.classList.remove('d-none');
        }

        if (btnLocate) {
            btnLocate.addEventListener('click', function () {
                if (!navigator.geolocation) {
                    showLocateMessage('<i class="bi bi-exclamation-triangle me-1"></i> Trình duyệt không hỗ trợ Geolocation.', true);
                    return;
                }

                btnLocate.disabled = true;
                btnLocate.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang dò tìm vị trí...';
                if (locateAlert) locateAlert.classList.add('d-none');

                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        applyPosition(position);
                    },
                    function (err) {
                        navigator.geolocation.getCurrentPosition(
                            function (fallbackPosition) {
                                applyPosition(fallbackPosition);
                            },
                            function (fallbackErr) {
                                showLocateMessage('<i class="bi bi-exclamation-triangle me-1"></i> Không thể lấy vị trí hiện tại. Vui lòng click chọn trực tiếp trên bản đồ.', true);
                                btnLocate.disabled = false;
                                btnLocate.innerHTML = '<i class="bi bi-crosshair me-1"></i> Tự định vị vị trí hiện tại';
                            },
                            { enableHighAccuracy: false, timeout: 15000, maximumAge: 60000 }
                        );
                    },
                    { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
                );

                function applyPosition(position) {
                    const curLat = position.coords.latitude;
                    const curLng = position.coords.longitude;

                    marker.setLatLng([curLat, curLng]);
                    map.setView([curLat, curLng], 16);
                    updateCoordinates(curLat, curLng);

                    btnLocate.disabled = false;
                    btnLocate.innerHTML = '<i class="bi bi-check2 me-1"></i> Định vị thành công!';
                    showLocateMessage('<i class="bi bi-check-circle me-1"></i> Đã định vị thành công vị trí của bạn!', false);
                    setTimeout(() => {
                        btnLocate.innerHTML = '<i class="bi bi-crosshair me-1"></i> Tự định vị vị trí hiện tại';
                    }, 3000);
                }
            });
        }
    </script>
}
