@model NhaTot.Web.Models.ChiTietTinDangViewModel

@{
    ViewData["Title"] = Model.TinDang?.TieuDe ?? "Chi tiết tin đăng";
    
    // Xử lý danh sách ảnh BĐS
    var dsAnh = !string.IsNullOrEmpty(Model.TinDang?.DanhSachAnhDatDai)
        ? Model.TinDang.DanhSachAnhDatDai.Split(new[] { ',', ';', '|', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
        : new List<string>();

    // Xử lý danh sách ảnh Sổ đỏ / Sổ hồng
    var dsAnhSoDo = !string.IsNullOrEmpty(Model.TinDang?.DanhSachAnhSoDoSoHong)
        ? Model.TinDang.DanhSachAnhSoDoSoHong.Split(new[] { ',', ';', '|', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
        : new List<string>();

    var tenNguoiDang = Model.NguoiDang?.HoTen;
    var chuCai = !string.IsNullOrEmpty(tenNguoiDang) ? tenNguoiDang[0].ToString().ToUpper() : "U";

    var bds = Model.BatDongSan;
    string tenLoaiBds = bds?.MaLoaiBdsNavigation?.TenLoaiBds ?? "";
    bool isDat = tenLoaiBds.Contains("Đất", StringComparison.OrdinalIgnoreCase) || Model.ChiTietDat != null;

    string diaChiDayDu = bds != null
        ? string.Join(", ", new[] { bds.DiaChiMoTa, bds.MaPhuongXaNavigation?.TenPhuongXa, bds.MaPhuongXaNavigation?.MaQuanHuyenNavigation?.TenQuanHuyen, bds.MaPhuongXaNavigation?.MaQuanHuyenNavigation?.MaTinhNavigation?.TenTinh }.Where(s => !string.IsNullOrWhiteSpace(s)))
        : "Chưa cập nhật địa chỉ";
}

<div class="container my-4">
    <div class="row">
        <!-- Cột trái -->
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (!string.IsNullOrEmpty(tenLoaiBds))
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">@tenLoaiBds</span>
                }
                <span class="badge @(Model.TinDang?.LoaiGiaoDich == "BAN" ? "bg-danger" : "bg-success") px-3 py-2">
                    @(Model.TinDang?.LoaiGiaoDich == "BAN" ? "Rao Bán" : "Cho Thuê")
                </span>
                @if (!string.IsNullOrEmpty(bds?.TenDuAn))
                {
                    <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
                        <i class="bi bi-buildings me-1"></i>Dự án: @bds.TenDuAn
                    </span>
                }
            </div>
            <h2 class="fw-bold mb-2">@Model.TinDang?.TieuDe</h2>
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                <p class="text-muted mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@diaChiDayDu</p>
                @if (bds?.ViDo.HasValue == true && bds?.KinhDo.HasValue == true)
                {
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm rounded-pill px-3" onclick="chiDuongNhaTot(@bds.ViDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @bds.KinhDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <i class="bi bi-cursor-fill me-1"></i>Chỉ đường qua Google Maps
                        </button>
                    </div>
                }
            </div>

            <!-- Hình ảnh -->
            <div class="mb-4">
                @if (dsAnh.Any())
                {
                    <img id="anhChinh" src="@dsAnh[0]" class="img-fluid rounded w-100" style="max-height: 450px; object-fit: cover;" alt="Hình ảnh" />
                    @if (dsAnh.Count > 1)
                    {
                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            @foreach (var a in dsAnh)
                            {
                                <img src="@a" class="rounded" style="width:80px;height:60px;object-fit:cover;cursor:pointer;"
                                     onclick="document.getElementById('anhChinh').src=this.src" alt="Ảnh nhỏ" />
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="bg-secondary text-white text-center py-5 rounded">Không có hình ảnh</div>
                }
            </div>

            <!-- Giá & định giá AI -->
            <div class="card mb-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted d-block">Giá rao bán:</span>
                            <h3 class="text-danger fw-bold m-0">
                                @(Model.TinDang?.GiaRaoVnd.HasValue == true ? Model.TinDang.GiaRaoVnd.Value.ToString("N0") + " VNĐ" : "Thỏa thuận")
                            </h3>
                        </div>

                        @if (Model.GiaDinhGiaAi.HasValue)
                        {
                            <div class="text-end">
                                <span class="badge bg-info text-dark mb-1">Định giá AI đề xuất</span>
                                <h4 class="text-primary fw-bold m-0">@Model.GiaDinhGiaAi.Value.ToString("N0") VNĐ</h4>
                            </div>
                        }
                    </div>

                    @if (Model.MucChechLechGia.HasValue && Model.PhamViChechLechPhanTram.HasValue)
                    {
                        <hr />
                        <div class="alert @(Model.MucChechLechGia > 0 ? "alert-warning" : "alert-success") mb-0">
                            @if (Model.MucChechLechGia > 0)
                            {
                                <span>Giá rao cao hơn định giá AI khoảng <strong>@Model.MucChechLechGia.Value.ToString("N0") VNĐ</strong> (@Model.PhamViChechLechPhanTram.Value.ToString("N1")%).</span>
                            }
                            else
                            {
                                <span>Giá rao thấp hơn định giá AI khoảng <strong>@Math.Abs(Model.MucChechLechGia.Value).ToString("N0") VNĐ</strong> (@Model.PhamViChechLechPhanTram.Value.ToString("N1")%).</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Mô tả -->
            <div class="card mb-4">
                <div class="card-header bg-white fw-bold">Mô tả chi tiết</div>
                <div class="card-body">
                    <p style="white-space: pre-line;">@Model.TinDang?.MoTa</p>
                </div>
            </div>

            <!-- Đặc điểm Bất động sản chung -->
            <div class="card mb-4 border-primary-subtle shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Đặc điểm bất động sản</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted d-block small">Diện tích đất:</span>
                            <strong>@(bds?.DienTichDat.HasValue == true ? bds.DienTichDat.Value.ToString("N1") + " m²" : "—")</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block small">Diện tích sử dụng:</span>
                            <strong>@(bds?.DienTichSuDung.HasValue == true ? bds.DienTichSuDung.Value.ToString("N1") + " m²" : "—")</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block small">Hướng nhà / đất:</span>
                            <strong>@(string.IsNullOrEmpty(bds?.Huong) ? "—" : bds.Huong)</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted d-block small">Tình trạng pháp lý:</span>
                            <strong>@(string.IsNullOrEmpty(bds?.PhapLy) ? "—" : bds.PhapLy)</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(bds?.TenDuAn))
                        {
                            <div class="col-md-6">
                                <span class="text-muted d-block small">Tên dự án:</span>
                                <strong class="text-primary">@bds.TenDuAn</strong>
                            </div>
                        }
                        <div class="col-md-6">
                            <span class="text-muted d-block small">Địa chỉ mô tả:</span>
                            <strong>@(string.IsNullOrEmpty(bds?.DiaChiMoTa) ? "—" : bds.DiaChiMoTa)</strong>
                        </div>

                        <!-- Các thông tin thêm từ TinDang: Tiền cọc, Kỳ hạn thanh toán, Thời hạn hợp đồng -->
                        @if (Model.TinDang?.TienCocVnd.HasValue == true && Model.TinDang.TienCocVnd.Value > 0)
                        {
                            <div class="col-md-6">
                                <span class="text-muted d-block small">Tiền đặt cọc:</span>
                                <strong class="text-danger">@Model.TinDang.TienCocVnd.Value.ToString("N0") VNĐ</strong>
                            </div>
                        }
                        @if (Model.TinDang?.KyHanThanhToanThang.HasValue == true)
                        {
                            <div class="col-md-6">
                                <span class="text-muted d-block small">Kỳ hạn thanh toán:</span>
                                <strong>@Model.TinDang.KyHanThanhToanThang tháng / lần</strong>
                            </div>
                        }
                        @if (Model.TinDang?.ThoiHanHopDongMinThang.HasValue == true)
                        {
                            <div class="col-md-6">
                                <span class="text-muted d-block small">Thời hạn HĐ tối thiểu:</span>
                                <strong>@Model.TinDang.ThoiHanHopDongMinThang tháng</strong>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(bds?.MoTaDacDiem))
                        {
                            <div class="col-12 mt-2 pt-2 border-top">
                                <span class="text-muted d-block small">Mô tả đặc điểm BĐS:</span>
                                <p class="mb-0 text-dark" style="white-space: pre-line;">@bds.MoTaDacDiem</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Phân hệ thông tin nhà ở -->
            @if (Model.ChiTietNha != null)
            {
                <div class="card mb-4 border-info-subtle">
                    <div class="card-header bg-info-subtle text-info-emphasis fw-bold">
                        <i class="bi bi-house-door me-2"></i>Thông tin chi tiết nhà ở
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 col-md-4 mb-2">Số tầng: <strong>@(Model.ChiTietNha.SoTang?.ToString() ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Phòng ngủ: <strong>@(Model.ChiTietNha.SoPhongNgu?.ToString() ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Phòng vệ sinh: <strong>@(Model.ChiTietNha.SoWc?.ToString() ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Năm xây dựng: <strong>@(Model.ChiTietNha.NamXayDung?.ToString() ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Tình trạng: <strong>@(Model.ChiTietNha.TinhTrangNha ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Nội thất: <strong>@(Model.ChiTietNha.NoiThat ?? "—")</strong></div>
                        </div>
                    </div>
                </div>
            }

            <!-- Phân hệ thông tin đất -->
            @if (Model.ChiTietDat != null || isDat)
            {
                <div class="card mb-4 border-success-subtle">
                    <div class="card-header bg-success-subtle text-success-emphasis fw-bold">
                        <i class="bi bi-bounding-box me-2"></i>Thông tin chi tiết thửa đất
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 col-md-4 mb-2">Loại đất: <strong>@(Model.ChiTietDat?.LoaiDat ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Mặt tiền: <strong>@(Model.ChiTietDat?.MatTienM?.ToString("N1") ?? "—") m</strong></div>
                            <div class="col-6 col-md-4 mb-2">Chiều sâu: <strong>@(Model.ChiTietDat?.ChieuSauM?.ToString("N1") ?? "—") m</strong></div>
                            <div class="col-6 col-md-4 mb-2">Loại đường: <strong>@(Model.ChiTietDat?.LoaiDuong ?? "—")</strong></div>
                            <div class="col-6 col-md-4 mb-2">Độ rộng đường: <strong>@(Model.ChiTietDat?.DoRongDuongM?.ToString("N1") ?? "—") m</strong></div>
                            <div class="col-6 col-md-4 mb-2">Hình dạng: <strong>@(Model.ChiTietDat?.HinhDang ?? "—")</strong></div>
                        </div>
                    </div>
                </div>
            }

            <!-- Danh sách ảnh Sổ Đỏ / Sổ Hồng -->
            @if (dsAnhSoDo.Any())
            {
                <div class="card mb-4 border-danger-subtle">
                    <div class="card-header bg-danger-subtle text-danger-emphasis fw-bold">
                        <i class="bi bi-file-earmark-check me-2"></i>Giấy tờ pháp lý (Sổ đỏ / Sổ hồng)
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var sodo in dsAnhSoDo)
                            {
                                <a href="@sodo" target="_blank" class="border rounded p-1 text-center bg-white text-decoration-none shadow-sm" style="width: 140px;">
                                    <img src="@sodo" class="img-fluid rounded" style="height: 100px; width: 100%; object-fit: cover;" alt="Sổ đỏ/hồng" />
                                    <small class="d-block text-muted mt-1 text-truncate"><i class="bi bi-zoom-in me-1"></i>Xem phóng to</small>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Bản đồ vị trí & Nút chỉ đường -->
            @if (bds?.ViDo.HasValue == true && bds?.KinhDo.HasValue == true)
            {
                <div class="card mb-4 border-primary-subtle">
                    <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-geo-alt text-primary me-2"></i>Vị trí bản đồ & Chỉ đường</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="chiDuongNhaTot(@bds.ViDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture), @bds.KinhDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <i class="bi bi-cursor-fill me-1"></i>Dẫn đường qua Google Maps
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <iframe width="100%" height="320" style="border:0;" loading="lazy" allowfullscreen
                                src="https://maps.google.com/maps?q=@bds.ViDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),@bds.KinhDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)&hl=vi&z=15&output=embed">
                        </iframe>
                    </div>
                    <div class="card-footer bg-light small text-muted d-flex justify-content-between">
                        <span>Tọa độ: @bds.ViDo.Value.ToString("0.######"), @bds.KinhDo.Value.ToString("0.######")</span>
                        <a href="https://www.google.com/maps/dir/?api=1&destination=@bds.ViDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),@bds.KinhDo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" target="_blank" class="fw-semibold text-primary text-decoration-none">
                            Mở Google Maps toàn màn hình <i class="bi bi-box-arrow-up-right ms-1"></i>
                        </a>
                    </div>
                </div>
            }

            <!-- Tin liên quan -->
            @if (Model.DanhSachBdsLienQuan != null && Model.DanhSachBdsLienQuan.Any())
            {
                <h5 class="fw-bold mb-3">Tin đăng liên quan</h5>
                <div class="row">
                    @foreach (var item in Model.DanhSachBdsLienQuan)
                    {
                        var anhLq = (item.AnhDaiDien ?? "")
                            .Split(new[] { ',', ';', '|', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                            .FirstOrDefault();
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("ChiTiet", "TinDang", new { id = item.MaTin })" class="text-decoration-none text-dark">
                                <div class="card h-100">
                                    @if (!string.IsNullOrEmpty(anhLq))
                                    {
                                        <img src="@anhLq" class="card-img-top" style="height:140px;object-fit:cover;" alt="@item.TieuDe" />
                                    }
                                    else
                                    {
                                        <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 140px;">
                                            <i class="bi bi-image fs-3 text-secondary"></i>
                                        </div>
                                    }
                                    <div class="card-body">
                                        <h6 class="card-title">@item.TieuDe</h6>
                                        <div class="text-danger fw-bold">
                                            @(item.GiaRaoVnd.HasValue ? item.GiaRaoVnd.Value.ToString("N0") + " VNĐ" : "Thỏa thuận")
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Cột phải -->
        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm border-0 rounded-4" style="position: sticky; top: 90px; z-index: 10;">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold">Thông tin người đăng</h5>
                    <div class="d-flex align-items-center my-3">
                        <div class="bg-primary text-white rounded-circle text-center me-3" style="width:50px; height:50px; line-height:50px; font-size:20px;">
                            @chuCai
                        </div>
                        <div>
                            <h6 class="m-0 fw-bold">@(string.IsNullOrWhiteSpace(tenNguoiDang) ? "Người dùng" : tenNguoiDang)</h6>
                            <small class="text-muted">@(Model.NguoiDang?.SoDienThoai ?? "Chưa cập nhật SĐT")</small>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-primary w-100 mb-2 py-2 fw-semibold" onclick="moModalDatLich()">
                        <i class="bi bi-calendar-check me-1"></i> Hẹn xem nhà
                    </button>
                    <button class="btn btn-outline-secondary w-100 mb-2" onclick="luuTinYeuThich(@Model.TinDang?.MaTin)">
                        <i class="bi bi-heart me-1"></i> Lưu tin yêu thích
                    </button>
                    <button class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#modalBaoCao">
                        <i class="bi bi-flag me-1"></i> Báo cáo vi phạm
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đặt lịch hẹn xem nhà -->
<div class="modal fade" id="modalDatLich" tabindex="-1" aria-labelledby="modalDatLichLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white py-3 px-4">
                <h5 class="modal-title fw-bold" id="modalDatLichLabel">
                    <i class="bi bi-calendar-check me-2"></i>Hẹn xem bất động sản
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                    <i class="bi bi-info-circle me-1"></i>Yêu cầu sẽ được chuyển đến chuyên viên tư vấn để xác nhận lịch và hỗ trợ quý khách dẫn xem thực tế.
                </div>
                <form id="formDatLich">
                    <input type="hidden" id="datLichMaTin" value="@Model.TinDang?.MaTin" />
                    
                    <div class="mb-3 bg-white p-3 rounded-3 border">
                        <label class="form-label fw-semibold text-secondary small mb-1">Bất động sản hẹn xem</label>
                        <div class="fw-bold text-dark text-truncate">#@Model.TinDang?.MaTin - @Model.TinDang?.TieuDe</div>
                        <div class="text-danger fw-bold small">@(Model.TinDang?.GiaRaoVnd.HasValue == true ? Model.TinDang.GiaRaoVnd.Value.ToString("N0") + " VNĐ" : "Thỏa thuận")</div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label fw-semibold small">Ngày hẹn xem <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="datLichNgay" required />
                        </div>
                        <div class="col-5">
                            <label class="form-label fw-semibold small">Giờ gặp <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" id="datLichGio" value="09:00" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Địa điểm hẹn gặp <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="datLichDiaDiem" value="@diaChiDayDu" placeholder="Nhập địa điểm gặp mặt..." required />
                        <div class="form-text small text-muted">Mặc định là địa chỉ BĐS, bạn có thể chỉnh sửa địa điểm phù hợp hơn.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Ghi chú thêm cho Tư vấn viên</label>
                        <textarea class="form-control" id="datLichGhiChu" rows="2" placeholder="Ví dụ: Cần xem trước sổ đỏ, hẹn gặp vào cuối tuần..."></textarea>
                    </div>

                    <button type="button" id="btnXacNhanDatLich" onclick="submitDatLich()" class="btn btn-primary w-100 fw-bold py-2 rounded-pill shadow-sm">
                        <i class="bi bi-send-check me-1"></i>Xác nhận đặt lịch hẹn
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Báo cáo vi phạm -->
<div class="modal fade" id="modalBaoCao" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Báo cáo vi phạm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formBaoCao">
                    <input type="hidden" id="baoCaoMaTin" value="@Model.TinDang?.MaTin" />
                    <div class="mb-3">
                        <label class="form-label">Lý do vi phạm</label>
                        <select class="form-select" id="baoCaoLyDo" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Thông tin sai sự thật">Thông tin sai sự thật</option>
                            <option value="Giá rao không đúng">Giá rao không đúng</option>
                            <option value="SĐT không liên lạc được">SĐT không liên lạc được</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mô tả chi tiết</label>
                        <textarea class="form-control" id="baoCaoMoTa" rows="3"></textarea>
                    </div>
                    <button type="button" onclick="submitBaoCao()" class="btn btn-danger w-100">Gửi báo cáo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function postJson(url, payload) {
            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return await res.json();
            } catch (e) {
                return { success: false, message: 'Có lỗi xảy ra, vui lòng thử lại.' };
            }
        }

        const isUserLoggedIn = @((User.Identity != null && User.Identity.IsAuthenticated) ? "true" : "false");

        function moModalDatLich() {
            if (!isUserLoggedIn) {
                alert('Vui lòng đăng nhập tài khoản để đặt lịch hẹn xem nhà!');
                window.location.href = '/TaiKhoan/DangNhap?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }
            const modalEl = document.getElementById('modalDatLich');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        const ngayInput = document.getElementById('datLichNgay');
        if (ngayInput) {
            // Mặc định ngày mai
            const tmr = new Date();
            tmr.setDate(tmr.getDate() + 1);
            ngayInput.min = new Date().toISOString().split('T')[0];
            ngayInput.value = tmr.toISOString().split('T')[0];
        }

        async function submitDatLich() {
            if (!isUserLoggedIn) {
                alert('Vui lòng đăng nhập tài khoản!');
                window.location.href = '/TaiKhoan/DangNhap?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }

            const ngay = document.getElementById('datLichNgay').value;
            const gio = document.getElementById('datLichGio').value;
            const diaDiem = document.getElementById('datLichDiaDiem').value;
            const ghiChu = document.getElementById('datLichGhiChu').value;

            if (!ngay) {
                alert('Vui lòng chọn ngày hẹn xem.');
                return;
            }
            if (!diaDiem || diaDiem.trim() === '') {
                alert('Vui lòng nhập địa điểm hẹn gặp.');
                return;
            }

            const btn = document.getElementById('btnXacNhanDatLich');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi yêu cầu...';
            }

            const data = await postJson('/TinDang/DatLichHen', {
                maTin: parseInt(document.getElementById('datLichMaTin').value),
                ngayHen: ngay,
                gioHen: gio,
                diaDiem: diaDiem,
                ghiChu: ghiChu
            });

            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-check me-1"></i>Xác nhận đặt lịch hẹn';
            }

            if (data.requireLogin) {
                alert(data.message);
                window.location.href = '/TaiKhoan/DangNhap?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }

            if (data.success) {
                // Ẩn modal
                const modalEl = document.getElementById('modalDatLich');
                if (modalEl) {
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                }

                if (confirm(data.message + '\n\nBạn có muốn chuyển đến trang "Lịch hẹn của tôi" để theo dõi không?')) {
                    window.location.href = '/NguoiDung/LichHen';
                } else {
                    location.reload();
                }
            } else {
                alert(data.message);
            }
        }

        async function submitBaoCao() {
            const lyDo = document.getElementById('baoCaoLyDo').value;
            if (!lyDo) { alert('Vui lòng chọn lý do vi phạm.'); return; }

            const data = await postJson('/TinDang/BaoCaoViPham', {
                maTin: parseInt(document.getElementById('baoCaoMaTin').value),
                lyDo: lyDo,
                moTa: document.getElementById('baoCaoMoTa').value
            });
            alert(data.message);
            if (data.success) location.reload();
        }

        async function luuTinYeuThich(maTin) {
            try {
                const res = await fetch('/Home/ToggleYeuThich', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `maTin=${maTin}`
                });
                const data = await res.json();
                alert(data.message);
            } catch (e) {
                alert('Có lỗi xảy ra khi lưu tin!');
            }
        }

        // Chức năng lấy vị trí hiện tại của người dùng và chuyển sang Google Maps chỉ đường
        function chiDuongNhaTot(viDoBds, kinhDoBds) {
            if (!viDoBds || !kinhDoBds) {
                alert('Bất động sản này chưa được cập nhật tọa độ trên bản đồ!');
                return;
            }

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const userLat = position.coords.latitude;
                        const userLng = position.coords.longitude;
                        const mapsUrl = `https://www.google.com/maps/dir/?api=1&origin=${userLat},${userLng}&destination=${viDoBds},${kinhDoBds}&travelmode=driving`;
                        window.open(mapsUrl, '_blank');
                    },
                    function(error) {
                        // Nếu người dùng từ chối hoặc không lấy được vị trí GPS hiện tại, vẫn mở Google Maps với điểm đến
                        const fallbackUrl = `https://www.google.com/maps/dir/?api=1&destination=${viDoBds},${kinhDoBds}&travelmode=driving`;
                        window.open(fallbackUrl, '_blank');
                    },
                    { enableHighAccuracy: true, timeout: 5000 }
                );
            } else {
                const fallbackUrl = `https://www.google.com/maps/dir/?api=1&destination=${viDoBds},${kinhDoBds}&travelmode=driving`;
                window.open(fallbackUrl, '_blank');
            }
        }
    </script>
}