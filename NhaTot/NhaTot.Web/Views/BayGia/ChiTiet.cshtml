@model NhaTot.Web.Models.BayGiaChiTietViewModel
@using NhaTot.Web.Services
@{
    var mt = Model.MucTieu;
    ViewData["Title"] = $"Mục tiêu #{mt.MaMucTieu} - {mt.TenLoaiBds ?? "Bẫy Giá"}";
    var areaParts = new[] { mt.TenPhuongXa, mt.TenQuanHuyen, mt.TenTinh }.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
    var fullAreaText = areaParts.Length > 0 ? string.Join(", ", areaParts) : "Toàn tỉnh";
    var minTxt = mt.NganSachMinVnd is > 0 ? RealEstateTextExtractor.FormatVndReadable(mt.NganSachMinVnd.Value) : "0 đ";
    var maxTxt = mt.NganSachMaxVnd is > 0 ? RealEstateTextExtractor.FormatVndReadable(mt.NganSachMaxVnd.Value) : "Không giới hạn";
    var active = mt.TrangThai is "DANG_THEO_DOI" or "ACTIVE";
    var statusText = mt.TrangThai switch
    {
        "DANG_THEO_DOI" or "ACTIVE" => "Đang theo dõi",
        "DA_KHOP_LENH" => "Đã khớp lệnh",
        "DA_HOAN_TIEN" => "Đã hoàn cọc",
        _ => "Đã dừng"
    };
}

<style>
    .detail-hero-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.45;
        min-height: 2.9em;
    }
    .rec-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .rec-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
    }
    .nav-tabs-clean .nav-link {
        border: none;
        border-bottom: 2px solid transparent;
        color: #64748b;
        font-weight: 600;
        padding: 0.85rem 1.25rem;
    }
    .nav-tabs-clean .nav-link.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
        background: transparent;
    }
</style>

<div class="container py-4">
    <!-- Top bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <a href="/BayGia" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách mục tiêu
        </a>
        <div class="d-flex align-items-center gap-2">
            @if (active)
            {
                <form asp-controller="BayGia" asp-action="HuyMucTieu" asp-route-id="@mt.MaMucTieu" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn dừng theo dõi mục tiêu #@mt.MaMucTieu?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="bi bi-stop-circle me-1"></i>Dừng theo dõi
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Full Target Details Card -->
    <div class="detail-hero-card p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 border-bottom">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h3 class="fw-bold text-dark mb-0">
                        Mục tiêu #@mt.MaMucTieu · @(mt.TenLoaiBds ?? "Bất động sản")
                    </h3>
                    <span class="badge rounded-pill @(mt.LoaiGiaoDich == "CHO_THUE" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                        @(mt.LoaiGiaoDich == "CHO_THUE" ? "Cho thuê" : "Mua bán")
                    </span>
                    <span class="badge rounded-pill @(active ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary")">
                        @statusText
                    </span>
                </div>
                <small class="text-muted">Thông tin nhu cầu bạn đã đặt làm chuẩn đối soát &amp; chấm điểm gợi ý</small>
            </div>

            <div class="text-md-end">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                    <i class="bi bi-stars me-1"></i>Ngưỡng gợi ý: &ge; @Model.NguongTuongDongPhanTram.ToString("0")% tương đồng
                </span>
            </div>
        </div>

        <div class="row g-3 py-3">
            <div class="col-md-4">
                <div class="p-3 rounded-3 bg-light h-100">
                    <small class="text-muted d-block mb-1"><i class="bi bi-geo-alt-fill text-primary me-1"></i>Khu vực đã đặt</small>
                    <strong class="text-dark">@fullAreaText</strong>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded-3 bg-light h-100">
                    <small class="text-muted d-block mb-1"><i class="bi bi-cash-coin text-danger me-1"></i>Ngân sách &amp; Cọc</small>
                    <div class="fw-bold text-danger">@minTxt – @maxTxt</div>
                    <small class="text-muted d-block">(@((mt.NganSachMinVnd ?? 0).ToString("N0")) đ – @(mt.NganSachMaxVnd.HasValue ? $"{mt.NganSachMaxVnd.Value:N0} đ" : "Không giới hạn"))</small>
                    <small class="text-muted">Cọc tạm giữ: @((mt.PhiDaTruDiem ?? 100000m).ToString("N0")) đ</small>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded-3 bg-light h-100">
                    <small class="text-muted d-block mb-1"><i class="bi bi-clock-history text-secondary me-1"></i>Thời gian theo dõi</small>
                    <div class="small text-dark">Tạo lúc: <strong>@(mt.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "--")</strong></div>
                    <div class="small text-dark">Hết hạn: <strong>@(mt.NgayHetHan?.ToString("dd/MM/yyyy HH:mm") ?? "--")</strong></div>
                </div>
            </div>
        </div>

        <div class="pt-2 border-top d-flex flex-wrap align-items-center gap-2">
            <span class="small fw-semibold text-secondary"><i class="bi bi-sliders me-1"></i>Tiêu chí chi tiết đã đặt:</span>
            @if (mt.DanhSachMoTaTieuChi != null && mt.DanhSachMoTaTieuChi.Any())
            {
                foreach (var tc in mt.DanhSachMoTaTieuChi)
                {
                    <span class="badge bg-light text-dark border fw-normal px-2 py-1">@tc</span>
                }
            }
            else
            {
                <span class="small text-muted">Không đặt thêm tiêu chí phụ (chấm điểm theo loại BĐS, khu vực &amp; ngân sách).</span>
            }
        </div>

        <div class="mt-3 pt-2 border-top small text-muted d-flex flex-wrap align-items-center gap-2">
            <strong class="text-dark">Trọng số chấm điểm tương đồng:</strong>
            <span class="badge bg-white text-secondary border fw-normal">Ngân sách 30%</span>
            <span class="badge bg-white text-secondary border fw-normal">Loại BĐS 25%</span>
            <span class="badge bg-white text-secondary border fw-normal">Khu vực 25%</span>
            <span class="badge bg-white text-secondary border fw-normal">Diện tích 15%</span>
            <span class="badge bg-white text-secondary border fw-normal">Tiêu chí phụ (hướng, pháp lý, PN, mặt tiền) 5%/mục</span>
        </div>
    </div>

    <!-- 2 Separate Lists: System TinDang & Facebook Crawled Posts >= 80% -->
    <div class="card border shadow-sm rounded-4 overflow-hidden bg-white">
        <ul class="nav nav-tabs nav-tabs-clean px-4 border-bottom bg-white" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabTinDang" type="button" role="tab">
                    <i class="bi bi-houses text-primary me-1"></i>Tin đăng hệ thống (&ge; 80%)
                    <span class="badge bg-primary-subtle text-primary rounded-pill ms-1">@Model.TinDangTuongDong.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabFacebook" type="button" role="tab">
                    <i class="bi bi-facebook text-info me-1"></i>Tin cào từ Facebook (&ge; 80%)
                    <span class="badge bg-info-subtle text-info-emphasis rounded-pill ms-1">@Model.TinFacebookTuongDong.Count</span>
                </button>
            </li>
        </ul>

        <div class="tab-content p-4">
            <!-- List 1: TinDang >= 80% -->
            <div class="tab-pane fade show active" id="tabTinDang" role="tabpanel">
                @if (!Model.TinDangTuongDong.Any())
                {
                    <div class="p-4 rounded-3 bg-light text-center text-muted small">
                        <i class="bi bi-info-circle me-1 text-primary"></i>
                        Chưa có tin đăng trên hệ thống đạt ngưỡng tương đồng &ge; 80% với mục tiêu này.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var item in Model.TinDangTuongDong)
                        {
                            var score = item.DoTuongDongPhanTram ?? 80;
                            var barClass = score >= 90 ? "bg-success" : "bg-primary";
                            var badgeClass = score >= 90 ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary";

                            <div class="col-md-6 col-lg-4">
                                <article class="rec-card h-100 p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <span class="badge rounded-pill bg-light text-secondary border">Hệ thống Nhà Tốt</span>
                                        <span class="badge rounded-pill fw-semibold @badgeClass">@score.ToString("0.#")% tương đồng</span>
                                    </div>
                                    <div class="progress mb-2" style="height: 4px;">
                                        <div class="progress-bar @barClass" style="width: @(Math.Clamp(score, 0, 100))%"></div>
                                    </div>
                                    <h6 class="fw-bold text-dark text-truncate-2 mb-2" title="@item.TieuDe">@item.TieuDe</h6>
                                    <div class="d-flex align-items-baseline justify-content-between mb-2">
                                        <strong class="text-danger fs-6">@item.GiaHienThi</strong>
                                        <span class="small text-muted fw-semibold">@(item.DienTich.HasValue ? $"{item.DienTich.Value:0.##} m²" : "--")</span>
                                    </div>
                                    <div class="small text-muted text-truncate mb-2" title="@item.TenKhuVuc">
                                        <i class="bi bi-geo-alt me-1 text-primary"></i>@(item.TenKhuVuc ?? "Nghệ An / Hà Tĩnh")
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                    {
                                        <div class="small mb-2">
                                            <i class="bi bi-telephone me-1 text-success"></i>
                                            <a href="tel:@item.SoDienThoai" class="text-success fw-semibold text-decoration-none">@item.SoDienThoai</a>
                                        </div>
                                    }
                                    @if (item.LyDoTuongDong != null && item.LyDoTuongDong.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            @foreach (var reason in item.LyDoTuongDong.Take(4))
                                            {
                                                <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.72rem;">&#10003; @reason</span>
                                            }
                                        </div>
                                    }
                                    <a href="@item.UrlTinGoc" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill mt-auto w-100 fw-semibold">
                                        Xem chi tiết tin đăng
                                    </a>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- List 2: Facebook Crawled >= 80% -->
            <div class="tab-pane fade" id="tabFacebook" role="tabpanel">
                @if (!Model.TinFacebookTuongDong.Any())
                {
                    <div class="p-4 rounded-3 bg-light text-center text-muted small">
                        <i class="bi bi-facebook me-1 text-primary"></i>
                        Chưa có bài viết cào từ Facebook đã duyệt đạt ngưỡng tương đồng &ge; 80% với mục tiêu này.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var item in Model.TinFacebookTuongDong)
                        {
                            var score = item.DoTuongDongPhanTram ?? 80;
                            var barClass = score >= 90 ? "bg-success" : "bg-primary";
                            var badgeClass = score >= 90 ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary";

                            <div class="col-md-6 col-lg-4">
                                <article class="rec-card h-100 p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                        <span class="badge rounded-pill bg-primary-subtle text-primary"><i class="bi bi-facebook me-1"></i>Facebook MXH</span>
                                        <span class="badge rounded-pill fw-semibold @badgeClass">@score.ToString("0.#")% tương đồng</span>
                                    </div>
                                    <div class="progress mb-2" style="height: 4px;">
                                        <div class="progress-bar @barClass" style="width: @(Math.Clamp(score, 0, 100))%"></div>
                                    </div>
                                    <h6 class="fw-bold text-dark text-truncate-2 mb-2" title="@item.TieuDe">@item.TieuDe</h6>
                                    <div class="d-flex align-items-baseline justify-content-between mb-2">
                                        <strong class="text-danger fs-6">@item.GiaHienThi</strong>
                                        <span class="small text-muted fw-semibold">@(item.DienTich.HasValue ? $"{item.DienTich.Value:0.##} m²" : "--")</span>
                                    </div>
                                    <div class="small text-muted text-truncate mb-2" title="@item.TenKhuVuc">
                                        <i class="bi bi-geo-alt me-1 text-primary"></i>@(item.TenKhuVuc ?? "Nghệ An / Hà Tĩnh")
                                    </div>
                                    @if (item.LyDoTuongDong != null && item.LyDoTuongDong.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            @foreach (var reason in item.LyDoTuongDong.Take(4))
                                            {
                                                <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.72rem;">&#10003; @reason</span>
                                            }
                                        </div>
                                    }
                                    <a href="@item.UrlTinGoc" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm rounded-pill mt-auto w-100 fw-semibold">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>Mở bài viết Facebook
                                    </a>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
