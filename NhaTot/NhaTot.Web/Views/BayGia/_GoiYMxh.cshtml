@model List<NhaTot.Web.Models.KetQuaKhopItemDto>
<section class="card-body p-4 border-bottom bg-light">
    <h6 class="fw-bold"><i class="bi bi-house-heart me-1"></i>Gợi ý tương đồng với mục tiêu <span class="badge bg-primary">@Model.Count tin</span></h6>
    <p class="small text-muted">Tin đăng Nhà Tốt và bài MXH đã duyệt, cùng loại BĐS, giao dịch và khu vực; giá không dưới mức tối thiểu và tối đa cao hơn ngân sách 10%, diện tích đạt yêu cầu. Các tiêu chí khác như pháp lý, hướng và số phòng cần kiểm tra trong tin. Gợi ý này chưa được tính là khớp lệnh để đối soát cọc.</p>
    @if (Model.Count == 0)
    {
        <p class="text-muted small mb-0">Chưa có thêm tin tương đồng với mục tiêu này. Tin đã khớp được hiển thị ở phần kết quả bên dưới.</p>
    }
    else
    {
        <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card card-body h-100">
                    <span class="small text-success mb-2">@(item.CoLinkMxh ? "Facebook · Đã kiểm duyệt" : "Nhà Tốt · Tin đã duyệt")</span>
                    <h6>@item.TieuDe</h6>
                    <strong class="text-danger">@item.GiaHienThi</strong>
                    <p class="small text-muted mt-2">@item.TenLoaiBds · @item.DienTich?.ToString("N2") m²<br />@item.TenKhuVuc</p>
                    <a href="@item.UrlTinGoc" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm mt-auto">@(item.CoLinkMxh ? "Xem bài Facebook gốc" : "Xem chi tiết tin đăng")</a>
                </article>
            </div>
        }
        </div>
    }
</section>
