@model NhaTot.Web.Models.BayGiaIndexViewModel
@using NhaTot.Web.Services

<section class="card border shadow-sm rounded-4 mb-4 overflow-hidden bg-white" aria-label="Bảng yêu cầu Bẫy giá">
    <div class="card-body border-bottom py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input id="targetSearch" type="search" class="form-control border-start-0" placeholder="Tìm theo mã, loại BĐS, khu vực, tiêu chí..." />
                </div>
            </div>
            <div class="col-md-3">
                <select id="targetAvailability" class="form-select form-select-sm" aria-label="Lọc trạng thái tin">
                    <option value="all">Tất cả mục tiêu</option>
                    <option value="available">Đã có tin phù hợp</option>
                    <option value="empty">Chưa có tin</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="targetSort" class="form-select form-select-sm" aria-label="Sắp xếp">
                    <option value="newest">Mới nhất</option>
                    <option value="count">Nhiều tin nhất</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="targetPageSize" class="form-select form-select-sm" aria-label="Số dòng">
                    <option>5</option>
                    <option selected>10</option>
                    <option>25</option>
                    <option value="all">Tất cả</option>
                </select>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="ps-4">Mục tiêu &amp; Tiêu chí đặt</th>
                    <th scope="col">Khu vực</th>
                    <th scope="col">Ngân sách &amp; Cọc</th>
                    <th scope="col">Thời gian &amp; Trạng thái</th>
                    <th scope="col" class="text-end pe-4">Kết quả</th>
                </tr>
            </thead>
            <tbody id="targetRows">
                @foreach (var target in Model.DanhSachMucTieu)
                {
                    var matched = target.DanhSachKhop.DistinctBy(x => (x.NguonTin, x.Id)).Count();
                    var suggestions = target.GoiYTuongDong.DistinctBy(x => (x.NguonTin, x.Id)).Count();
                    var total = target.DanhSachKhop.Concat(target.GoiYTuongDong).DistinctBy(x => (x.NguonTin, x.Id)).Count();
                    var active = target.TrangThai is "DANG_THEO_DOI" or "ACTIVE";
                    var status = target.TrangThai switch
                    {
                        "DANG_THEO_DOI" or "ACTIVE" => "Đang theo dõi",
                        "DA_KHOP_LENH" => "Đã khớp lệnh",
                        "DA_HOAN_TIEN" => "Đã hoàn cọc",
                        _ => "Đã dừng"
                    };
                    var minTxt = target.NganSachMinVnd is > 0 ? RealEstateTextExtractor.FormatVndReadable(target.NganSachMinVnd.Value) : "0 đ";
                    var maxTxt = target.NganSachMaxVnd is > 0 ? RealEstateTextExtractor.FormatVndReadable(target.NganSachMaxVnd.Value) : "Không giới hạn";
                    var locationParts = new[] { target.TenPhuongXa, target.TenQuanHuyen, target.TenTinh }.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
                    var locationText = locationParts.Length > 0 ? string.Join(", ", locationParts) : "Toàn tỉnh";
                    var criteriaList = target.DanhSachMoTaTieuChi ?? new List<string>();

                    <tr data-target-row data-count="@total" data-order="@target.MaMucTieu">
                        <td class="ps-4">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <a href="/BayGia/ChiTiet/@target.MaMucTieu" class="fw-semibold text-primary text-decoration-none">
                                    #@target.MaMucTieu · @(target.TenLoaiBds ?? "Bất động sản")
                                </a>
                                <span class="badge rounded-pill @(target.LoaiGiaoDich == "CHO_THUE" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 0.72rem;">
                                    @(target.LoaiGiaoDich == "CHO_THUE" ? "Cho thuê" : "Mua bán")
                                </span>
                            </div>
                            @if (criteriaList.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1" title="@string.Join(" | ", criteriaList)">
                                    @foreach (var tc in criteriaList.Take(4))
                                    {
                                        <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.72rem;">@tc</span>
                                    }
                                    @if (criteriaList.Count > 4)
                                    {
                                        <span class="badge bg-light text-primary border fw-semibold" style="font-size: 0.72rem;">+@(criteriaList.Count - 4)</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <small class="text-muted">Theo loại BĐS, khu vực &amp; giá</small>
                            }
                        </td>
                        <td>
                            <div class="small text-dark fw-medium">@locationText</div>
                        </td>
                        <td class="text-nowrap">
                            <div class="fw-semibold text-danger">@minTxt – @maxTxt</div>
                            <small class="text-muted">Cọc: @((target.PhiDaTruDiem ?? 100000m).ToString("N0")) đ</small>
                        </td>
                        <td class="text-nowrap">
                            <span class="badge rounded-pill @(active ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary")">@status</span>
                            <div class="small text-muted mt-1">Tạo: @target.NgayTao?.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="small text-muted">Hạn: @target.NgayHetHan?.ToString("dd/MM/yyyy")</div>
                        </td>
                        <td class="text-end pe-4">
                            <a href="/BayGia/ChiTiet/@target.MaMucTieu"
                               class="btn btn-sm rounded-pill px-3 @(total > 0 ? "btn-primary" : "btn-outline-secondary")">
                                @(total > 0 ? $"Xem {total} tin" : "Chi tiết")
                            </a>
                            <div class="small text-muted mt-1">@matched khớp &middot; @suggestions gợi ý &ge;80%</div>
                        </td>
                    </tr>
                }
                <tr id="targetNoResults" hidden>
                    <td colspan="5" class="text-center text-muted py-4">Không tìm thấy mục tiêu phù hợp bộ lọc.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 px-4">
        <span id="targetPageInfo" class="small text-muted" role="status" aria-live="polite"></span>
        <div class="d-flex gap-2">
            <button type="button" id="targetPrev" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Trước</button>
            <button type="button" id="targetNext" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Sau</button>
        </div>
    </div>
</section>
