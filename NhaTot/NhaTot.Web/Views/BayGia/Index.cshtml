@model NhaTot.Web.Models.BayGiaIndexViewModel
@using NhaTot.Web.Services
@{
    ViewData["Title"] = "Bẫy Giá Bất Động Sản - Săn tin hời & Gợi ý tương đồng";
    bool showCreateForm = !Model.DanhSachMucTieu.Any() || TempData["ErrorMessage"] != null;
}

<style>
    .baygia-header-bar {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    }
    .baygia-form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }
    .baygia-input {
        border-radius: 10px;
        border-color: #cbd5e1;
    }
    .baygia-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.45;
        min-height: 2.9em;
    }
    .baygia-result-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .baygia-result-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.07);
    }
    .nav-tabs-clean .nav-link {
        border: none;
        border-bottom: 2px solid transparent;
        color: #64748b;
        font-weight: 600;
        padding: 0.75rem 1.1rem;
    }
    .nav-tabs-clean .nav-link.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
        background: transparent;
    }
</style>

<div class="container py-4">
    <!-- Calm Top Bar -->
    <div class="baygia-header-bar d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-crosshair text-primary me-2"></i>Bẫy Giá Bất Động Sản
            </h3>
            <p class="text-muted small mb-0">
                Đặt nhu cầu giá &amp; khu vực mong muốn — tự động ghép tin khớp và gợi ý BĐS tương đồng &ge; 80%.
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="d-inline-flex align-items-center px-3 py-2 bg-light border rounded-pill">
                <i class="bi bi-wallet2 text-warning me-2"></i>
                <span class="small text-muted me-1">Ví:</span>
                <strong class="text-dark small">@Model.SoDuViHienTai.ToString("N0") đ</strong>
                <a href="/NguoiDung/QuanLyVi" class="ms-2 small fw-semibold text-primary text-decoration-none">+ Nạp</a>
            </div>

            <button type="button"
                    class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseTaoMucTieu"
                    aria-expanded="@(showCreateForm ? "true" : "false")"
                    aria-controls="collapseTaoMucTieu">
                <i class="bi bi-plus-lg me-1"></i>Tạo mục tiêu mới
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. Collapsible Progressive Create Target Form -->
    <div id="collapseTaoMucTieu" class="collapse @(showCreateForm ? "show" : "") mb-4">
        <div class="baygia-form-card p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-sliders text-primary me-2"></i>Thiết lập nhu cầu Bẫy Giá
                </h5>
                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 fw-normal">
                    <i class="bi bi-shield-check text-success me-1"></i>Cọc 100.000 đ · Hoàn 100% sau 1 tháng nếu không có tin
                </span>
            </div>

            <form asp-controller="BayGia" asp-action="TaoMucTieu" method="post" id="formTaoBayGia">
                @Html.AntiForgeryToken()

                <!-- Layer 1: Essential Fields -->
                <div class="row g-3">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label small fw-semibold text-secondary">Loại BĐS <span class="text-danger">*</span></label>
                        <select asp-for="FormTao.MaLoaiBds" id="ddlLoaiBdsBayGia" class="form-select baygia-input" required>
                            <option value="">-- Chọn loại BĐS --</option>
                            @if (ViewBag.DanhSachLoaiBds != null)
                            {
                                foreach (var l in ViewBag.DanhSachLoaiBds)
                                {
                                    <option value="@l.MaLoaiBds" data-name="@l.TenLoaiBds">@l.TenLoaiBds</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4 col-lg-3">
                        <label class="form-label small fw-semibold text-secondary">Giao dịch</label>
                        <select asp-for="FormTao.LoaiGiaoDich" class="form-select baygia-input">
                            <option value="BAN">Mua / Bán</option>
                            <option value="CHO_THUE">Thuê / Cho thuê</option>
                        </select>
                    </div>

                    <div class="col-md-4 col-lg-2">
                        <label class="form-label small fw-semibold text-secondary">Tỉnh / Thành <span class="text-danger">*</span></label>
                        <select asp-for="FormTao.MaTinh" id="ddlTinhThanhBayGia" class="form-select baygia-input" required>
                            <option value="">-- Chọn --</option>
                            @if (ViewBag.DanhSachTinhThanh != null)
                            {
                                foreach (var t in ViewBag.DanhSachTinhThanh)
                                {
                                    <option value="@t.MaTinh" selected="@(t.MaTinh == 1)">@t.TenTinh</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-2">
                        <label class="form-label small fw-semibold text-secondary">Quận / Huyện</label>
                        <select asp-for="FormTao.MaQuanHuyen" id="ddlQuanHuyenBayGia" class="form-select baygia-input">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-2">
                        <label class="form-label small fw-semibold text-secondary">Phường / Xã</label>
                        <select asp-for="FormTao.MaPhuongXa" id="ddlPhuongXaBayGia" class="form-select baygia-input">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Ngân sách tối thiểu (VNĐ)</label>
                        <input asp-for="FormTao.NganSachMinVnd" type="number" step="1000000" class="form-control baygia-input" placeholder="VD: 1000000000 (không bắt buộc)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Giá trần tối đa mong muốn (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="FormTao.NganSachMaxVnd" type="number" step="1000000" class="form-control baygia-input fw-semibold text-danger" placeholder="VD: 2500000000" required />
                    </div>
                </div>

                <!-- Layer 2: Progressive Advanced Criteria Toggle -->
                <div class="mt-3">
                    <button type="button"
                            class="btn btn-sm btn-link text-decoration-none px-0 fw-semibold text-primary"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseTieuChiNangCao"
                            aria-expanded="false"
                            aria-controls="collapseTieuChiNangCao">
                        <i class="bi bi-plus-circle me-1"></i>Tùy chọn nâng cao: diện tích, hướng, pháp lý, đất/nhà &amp; ghi chú
                    </button>

                    <div id="collapseTieuChiNangCao" class="collapse mt-2">
                        <div class="p-3 rounded-3 bg-light border">
                            <div id="khuVucThuocTinhChiTiet" style="display: none;">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold text-secondary">Diện tích tối thiểu (m²)</label>
                                        <input asp-for="FormTao.DienTichMin" type="number" step="1" min="0" class="form-control baygia-input" placeholder="VD: 80" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold text-secondary">Hướng BĐS</label>
                                        <select asp-for="FormTao.Huong" class="form-select baygia-input">
                                            <option value="">-- Tất cả hướng --</option>
                                            <option value="Đông">Đông</option>
                                            <option value="Tây">Tây</option>
                                            <option value="Nam">Nam</option>
                                            <option value="Bắc">Bắc</option>
                                            <option value="Đông Nam">Đông Nam</option>
                                            <option value="Đông Bắc">Đông Bắc</option>
                                            <option value="Tây Nam">Tây Nam</option>
                                            <option value="Tây Bắc">Tây Bắc</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold text-secondary">Pháp lý</label>
                                        <select asp-for="FormTao.PhapLy" class="form-select baygia-input">
                                            <option value="">-- Không yêu cầu --</option>
                                            <option value="Sổ đỏ/Sổ hồng">Sổ đỏ / Sổ hồng</option>
                                            <option value="Hợp đồng mua bán">Hợp đồng mua bán</option>
                                            <option value="Đang chờ sổ">Đang chờ sổ</option>
                                        </select>
                                    </div>
                                </div>

                                <div id="nhomTieuChiDat" style="display: none;">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-secondary">Loại đất</label>
                                            <select asp-for="FormTao.LoaiDat" class="form-select baygia-input input-dat">
                                                <option value="">-- Tất cả --</option>
                                                <option value="Đất thổ cư">Đất thổ cư</option>
                                                <option value="Đất nền dự án">Đất nền dự án</option>
                                                <option value="Đất thương mại dịch vụ">Đất TMDV</option>
                                                <option value="Đất trồng cây/vườn">Đất vườn</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-secondary">Mặt tiền tối thiểu (m)</label>
                                            <input asp-for="FormTao.MatTienMinM" type="number" step="0.5" min="0" class="form-control baygia-input input-dat" placeholder="VD: 5.0" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-secondary">Chiều sâu tối thiểu (m)</label>
                                            <input asp-for="FormTao.ChieuSauMinM" type="number" step="0.5" min="0" class="form-control baygia-input input-dat" placeholder="VD: 15.0" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-secondary">Loại đường</label>
                                            <select asp-for="FormTao.LoaiDuong" class="form-select baygia-input input-dat">
                                                <option value="">-- Tất cả --</option>
                                                <option value="Đường nhựa">Đường nhựa</option>
                                                <option value="Đường bê tông">Đường bê tông</option>
                                                <option value="Đường rải đá / đất">Đường đất / Đá</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-secondary">Độ rộng đường (m)</label>
                                            <input asp-for="FormTao.DoRongDuongMinM" type="number" step="0.5" min="0" class="form-control baygia-input input-dat" placeholder="VD: 6.0" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-semibold text-secondary">Hình dáng đất</label>
                                            <select asp-for="FormTao.HinhDangDat" class="form-select baygia-input input-dat">
                                                <option value="">-- Tất cả --</option>
                                                <option value="Vuông vắn">Vuông vắn</option>
                                                <option value="Nở hậu">Nở hậu</option>
                                                <option value="Lô góc 2 mặt tiền">Lô góc 2 mặt tiền</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div id="nhomTieuChiNha" style="display: none;">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-secondary">Phòng ngủ tối thiểu</label>
                                            <input asp-for="FormTao.SoPhongNgu" type="number" min="0" max="20" class="form-control baygia-input input-nha" placeholder="VD: 3" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-secondary">Số tầng tối thiểu</label>
                                            <input asp-for="FormTao.SoTangMin" type="number" min="0" max="50" class="form-control baygia-input input-nha" placeholder="VD: 2" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-secondary">Số WC tối thiểu</label>
                                            <input asp-for="FormTao.SoWcMin" type="number" min="0" max="20" class="form-control baygia-input input-nha" placeholder="VD: 2" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold text-secondary">Năm XD từ</label>
                                            <input asp-for="FormTao.NamXayDungMin" type="number" min="1990" max="2030" class="form-control baygia-input input-nha" placeholder="VD: 2020" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold text-secondary">Tình trạng nhà</label>
                                            <select asp-for="FormTao.TinhTrangNha" class="form-select baygia-input input-nha">
                                                <option value="">-- Tất cả --</option>
                                                <option value="Nhà mới xây">Nhà mới xây</option>
                                                <option value="Đã qua sử dụng - Đẹp">Đã qua sử dụng còn đẹp</option>
                                                <option value="Tiện xây mới / sửa chữa">Tiện xây mới / sửa chữa</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold text-secondary">Nội thất</label>
                                            <select asp-for="FormTao.NoiThat" class="form-select baygia-input input-nha">
                                                <option value="">-- Không yêu cầu --</option>
                                                <option value="Đầy đủ nội thất">Đầy đủ nội thất</option>
                                                <option value="Nội thất cơ bản">Nội thất cơ bản</option>
                                                <option value="Nhà trống">Nhà trống</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="form-label small fw-semibold text-secondary">Ghi chú bổ sung (tùy chọn)</label>
                                <input asp-for="FormTao.GhiChuTieuChi" class="form-control baygia-input" placeholder="VD: Gần trường học, đường ô tô tránh nhau..." />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pt-3 border-top">
                    <small class="text-muted">
                        Chọn loại BĐS và giá trần mong muốn để kích hoạt quét tự động.
                    </small>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Kích hoạt Bẫy Giá (Cọc 100.000 đ)
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. Danh sách Mục Tiêu & Kết quả theo Tab gọn gàng -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-card-checklist text-primary me-2"></i>Mục tiêu của bạn
            <span class="badge bg-light text-secondary border rounded-pill ms-1 fw-normal">@Model.DanhSachMucTieu.Count</span>
        </h5>
    </div>

    @if (!Model.DanhSachMucTieu.Any())
    {
        <div class="card border shadow-sm rounded-4 text-center p-5 bg-white">
            <i class="bi bi-radar fs-1 text-primary opacity-50 mb-3"></i>
            <h5 class="fw-bold text-dark">Bạn chưa có mục tiêu bẫy giá nào</h5>
            <p class="text-muted small mb-0">Điền form ở trên để hệ thống tự động quét và gợi ý bất động sản phù hợp ≥ 80%.</p>
        </div>
    }
    else
    {
        <partial name="_BangMucTieu" model="Model" />
    }
</div>

@section Scripts {
    <script src="~/js/baygia-targets.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        const ddlTinh = document.getElementById('ddlTinhThanhBayGia');
        const ddlQuan = document.getElementById('ddlQuanHuyenBayGia');
        const ddlPhuong = document.getElementById('ddlPhuongXaBayGia');
        const ddlLoaiBds = document.getElementById('ddlLoaiBdsBayGia');

        const khuVucChiTiet = document.getElementById('khuVucThuocTinhChiTiet');
        const nhomDat = document.getElementById('nhomTieuChiDat');
        const nhomNha = document.getElementById('nhomTieuChiNha');

        function clearInputs(container) {
            if (!container) return;
            container.querySelectorAll('input, select').forEach(el => {
                if (el.tagName === 'SELECT') el.selectedIndex = 0;
                else if (el.type === 'checkbox' || el.type === 'radio') el.checked = false;
                else el.value = '';
            });
        }

        function handleLoaiBdsChange() {
            const selectedOpt = ddlLoaiBds.options[ddlLoaiBds.selectedIndex];
            const tenLoai = (selectedOpt && selectedOpt.getAttribute('data-name')) ? selectedOpt.getAttribute('data-name').trim() : (selectedOpt ? selectedOpt.textContent.trim() : '');

            if (!ddlLoaiBds.value) {
                khuVucChiTiet.style.display = 'none';
                nhomDat.style.display = 'none';
                nhomNha.style.display = 'none';
                clearInputs(nhomDat);
                clearInputs(nhomNha);
                return;
            }

            khuVucChiTiet.style.display = 'block';
            const isDat = tenLoai.toLowerCase().includes('đất');

            if (isDat) {
                nhomDat.style.display = 'block';
                nhomNha.style.display = 'none';
                clearInputs(nhomNha);
            } else {
                nhomDat.style.display = 'none';
                nhomNha.style.display = 'block';
                clearInputs(nhomDat);
            }
        }

        if (ddlLoaiBds) {
            ddlLoaiBds.addEventListener('change', handleLoaiBdsChange);
            if (ddlLoaiBds.value) handleLoaiBdsChange();
        }

        async function loadQuanHuyen(maTinh) {
            ddlQuan.innerHTML = '<option value="">-- Đang tải... --</option>';
            ddlPhuong.innerHTML = '<option value="">-- Tất cả --</option>';
            if (!maTinh) {
                ddlQuan.innerHTML = '<option value="">-- Tất cả --</option>';
                return;
            }
            try {
                const res = await fetch(`/Home/GetQuanHuyen?maTinh=${maTinh}`);
                const data = await res.json();
                ddlQuan.innerHTML = '<option value="">-- Tất cả --</option>';
                data.forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = q.maQuanHuyen;
                    opt.textContent = q.tenQuanHuyen;
                    ddlQuan.appendChild(opt);
                });
            } catch (e) {
                ddlQuan.innerHTML = '<option value="">-- Lỗi tải --</option>';
            }
        }

        async function loadPhuongXaTheoQuan(maQuanHuyen) {
            ddlPhuong.innerHTML = '<option value="">-- Đang tải... --</option>';
            if (!maQuanHuyen) {
                ddlPhuong.innerHTML = '<option value="">-- Tất cả --</option>';
                return;
            }
            try {
                const res = await fetch(`/Home/GetPhuongXa?maQuanHuyen=${maQuanHuyen}`);
                const data = await res.json();
                ddlPhuong.innerHTML = '<option value="">-- Tất cả --</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.maPhuongXa;
                    opt.textContent = p.tenPhuongXa;
                    ddlPhuong.appendChild(opt);
                });
            } catch (e) {
                ddlPhuong.innerHTML = '<option value="">-- Lỗi tải --</option>';
            }
        }

        if (ddlTinh) {
            ddlTinh.addEventListener('change', function () { loadQuanHuyen(this.value); });
            if (ddlTinh.value) loadQuanHuyen(ddlTinh.value);
        }

        if (ddlQuan) {
            ddlQuan.addEventListener('change', function () { loadPhuongXaTheoQuan(this.value); });
        }
    </script>
}
